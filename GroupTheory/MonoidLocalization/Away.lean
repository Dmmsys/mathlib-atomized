/--
Definition of `awayToAwayRight` / `awayToAwayRight` 的定义

English:
definition awayToAwayRight
  signature: (y : M) (G : AwayMap (x * y) P)
  body: F.lift x
    show IsUnit (G x) from
.of_mul_eq_one (G.mk' y ⟨x * y, mem_powers _⟩) by
        rw [mul_mk'_eq_mk'_of_mul]; rw [mk'_self]

中文:
定义 awayToAwayRight
  签名: (y : M) (G : AwayMap (x * y) P)
  定义体: F.lift x
    show IsUnit (G x) from
.of_mul_eq_one (G.mk' y ⟨x * y, mem_powers _⟩) by
        rw [mul_mk'_eq_mk'_of_mul]; rw [mk'_self]

Depends on / 依赖: F.lift, G.mk, IsUnit, P.flip.coroot, _apply_apply_mem_of_mem_span, _eq_mk, _of_mul, _self, coroot, mem_powers, mul_mk, of_mul_eq_one
-/
noncomputable def awayToAwayRight (y : M) (G : AwayMap (x * y) P) : N ->* P :=
F.lift x
    show IsUnit (G x) from
.of_mul_eq_one (G.mk' y ⟨x * y, mem_powers _⟩) by
        rw [mul_mk'_eq_mk'_of_mul]; rw [mk'_self]

end AwayMap

