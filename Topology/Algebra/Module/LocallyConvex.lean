class LocallyConvexSpace (𝕜 E : Type*) [Semiring 𝕜] [PartialOrder 𝕜]
    [AddCommMonoid E] [Module 𝕜 E] [TopologicalSpace E] : Prop where
  convex_basis : forall x : E, (𝓝 x).HasBasis (fun s : Set E => s in 𝓝 x ∧ Convex 𝕜 s) id

