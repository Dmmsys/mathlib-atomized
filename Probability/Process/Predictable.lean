def predictable [Preorder ι] [OrderBot ι] (𝓕 : Filtration ι m) : MeasurableSpace (ι × Ω) :=
MeasurableSpace.generateFrom
    {s | exists A, MeasurableSet[𝓕 ⊥] A ∧ s = {⊥} ×ˢ A} union
    {s | exists i A, MeasurableSet[𝓕 i] A ∧ s = Set.Ioi i ×ˢ A}

end Filtration

