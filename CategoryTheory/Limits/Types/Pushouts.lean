English:
definition isColimitCocone
  signature: : IsColimit (cocone f g)
  body: PushoutCocone.IsColimit.mk _ (fun s => ↾(Quot.lift (fun x => match x with
      | Sum.inl x₁ => s.inl x₁
      | Sum.inr x₂ => s.inr x₂) (by
    rintro _ _ ⟨t⟩
    exact ConcreteCategory.congr_hom s.condition t))) (fun _ => rfl) (fun _ => rfl)
      (fun s m h₁ h₂ => by
      ext ⟨x₁ | x₂⟩
      · e

中文:
定义 isColimitCocone
  签名: : 是余极限 (cocone f g)
  定义体: PushoutCocone.IsColimit.mk _ (fun s => ↾(Quot.lift (fun x => match x with
      | Sum.inl x₁ => s.inl x₁
      | Sum.inr x₂ => s.inr x₂) (by
    rintro _ _ ⟨t⟩
    exact ConcreteCategory.congr_hom s.condition t))) (fun _ => rfl) (fun _ => rfl)
      (fun s m h₁ h₂ => by
      ext ⟨x₁ | x₂⟩
      · e

Depends on / 依赖: ConcreteCategory, ConcreteCategory.congr_hom, IsColimit, PushoutCocone, PushoutCocone.IsColimit.mk, Quot.lift, Sum.inl, Sum.inr, condition, congr_hom, s.condition, s.inl, s.inr
-/
def isColimitCocone : IsColimit (cocone f g) :=
  PushoutCocone.IsColimit.mk _ (fun s => ↾(Quot.lift (fun x => match x with
      | Sum.inl x₁ => s.inl x₁
      | Sum.inr x₂ => s.inr x₂) (by
    rintro _ _ ⟨t⟩
