Depends on / 依赖: Algebra, Algebra.linearMap, LinearMap, LinearMap.map_smul_of_tower, LinearMap.range, LocalizationMap, RootPairing, RootPairing.exists_value, Submodule, Submodule.smul_mem, Submodule.span_induction, Submonoid, Submonoid.LocalizationMap.lift_comp, add_mem, algebraMap, exists_value, lift_comp, linearMap, map_add, map_smul_of_tower
-/
theorem AwayMap.lift_comp (hg : IsUnit (g x)) : (F.lift x hg).comp F = g :=
