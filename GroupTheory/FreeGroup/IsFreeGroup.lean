/-- Any free group is isomorphic to "the" free group. -/
@[to_additive /-- Any additive free group is isomorphic to "the" additive free group. -/]
irreducible_def mulEquiv : FreeGroup (Generators G) ≃* G :=
  (IsFreeGroup.nonempty_basis (G := G)).choose_spec.some.repr.symm

/-- A free group basis of a free group `G`, over the set `Generators G`. -/
@[to_additive
/-- An additive free group basis of an additive free group `G`, over the set `Generators G`. -/]
/--
Definition of `basis` / `basis` 的定义

English:
definition basis
  signature: : FreeGroupBasis (Generators G) G
  body: FreeGroupBasis.ofRepr (mulEquiv G).symm

中文:
定义 basis
  签名: : FreeGroupBasis (生成元 G) G
  定义体: FreeGroupBasis.ofRepr (mulEquiv G).symm

Depends on / 依赖: FreeGroupBasis, FreeGroupBasis.ofRepr, mulEquiv, ofRepr
-/
def basis : FreeGroupBasis (Generators G) G := FreeGroupBasis.ofRepr (mulEquiv G).symm

/-- Any free group is isomorphic to "the" free group. -/
@[to_additive (attr := simps!)
/-- Any additive free group is isomorphic to "the" additive free group. -/]
/--
Definition of `toFreeGroup` / `toFreeGroup` 的定义

English:
definition toFreeGroup
  signature: : G ≃* FreeGroup (Generators G)
  body: (mulEquiv G).symm

中文:
定义 toFreeGroup
  签名: : G ≃* 自由群 (生成元 G)
  定义体: (mulEquiv G).symm

Depends on / 依赖: mulEquiv
-/
def toFreeGroup : G ≃* FreeGroup (Generators G) :=
  (mulEquiv G).symm

variable {G}

/-- The canonical injection of G's generators into G -/
@[to_additive /-- The canonical injection of G's generators into G -/]
