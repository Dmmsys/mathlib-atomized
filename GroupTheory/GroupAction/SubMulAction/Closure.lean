module

public import Mathlib.Data.Set.Finite.Basic
public import Mathlib.Data.Set.Lattice
public import Mathlib.GroupTheory.GroupAction.SubMulAction

/-!
# Closure and finiteness of `SubMulAction` and `SubAddAction`
-/

@[expose] public section

namespace SubMulAction

/-- The `SubMulAction` generated by a set `s`. -/
@[to_additive /-- The `SubAddAction` generated by a set `s`. -/]
/--
Definition of `closure` / `closure` 的定义

English:
definition closure
  signature: (R : Type*) {M : Type*} [SMul R M] (s : Set M)
  body: sInf { p | s subseteq (p : Set M) }

中文:
定义 closure
  签名: (R : 类型) {M : 类型} [SMul R M] (s : Set M)
  定义体: sInf { p | s subseteq (p : Set M) }

Depends on / 依赖: subseteq
-/
def closure (R : Type*) {M : Type*} [SMul R M] (s : Set M) : SubMulAction R M :=
  sInf { p | s subseteq (p : Set M) }

variable {R M : Type*} [SMul R M] {s t : Set M} {x : M}

@[to_additive]
/--
theorem `mem_closure` / 定理 `mem_closure`

English:
theorem mem_closure
  statement: x in closure R s ↔ forall p : SubMulAction R M, s subseteq p -> x in p
  proof: Set.mem_iInter₂

@[to_additive]

中文:
定理 mem_closure
  结论: x in closure R s ↔ 对任意 p : SubMulAction R M, s subseteq p -> x in p
  证明: Set.mem_iInter₂

@[to_additive]

Depends on / 依赖: Set.mem_iInter
-/
theorem mem_closure : x in closure R s ↔ forall p : SubMulAction R M, s subseteq p -> x in p :=
  Set.mem_iInter₂

@[to_additive]
/--
theorem `subset_closure` / 定理 `subset_closure`

English:
theorem subset_closure
  statement: s subseteq closure R s
  proof: fun _ h => mem_closure.2 fun _ hp => hp h

@[to_additive]

中文:
定理 subset_closure
  结论: s subseteq closure R s
  证明: fun _ h => mem_closure.2 fun _ hp => hp h

@[to_additive]

Depends on / 依赖: mem_closure
-/
theorem subset_closure : s subseteq closure R s := fun _ h => mem_closure.2 fun _ hp => hp h

@[to_additive]
/--
theorem `mem_closure_of_mem` / 定理 `mem_closure_of_mem`

English:
theorem mem_closure_of_mem
  given: (hx : x in s)
  statement: x in closure R s
  proof: subset_closure hx

@[to_additive]

中文:
定理 mem_closure_of_mem
  条件: (hx : x in s)
  结论: x in closure R s
  证明: subset_closure hx

@[to_additive]

Depends on / 依赖: subset_closure
-/
theorem mem_closure_of_mem (hx : x in s) : x in closure R s := subset_closure hx

@[to_additive]
/--
theorem `closure_le` / 定理 `closure_le`

English:
theorem closure_le
  given: {p}
  statement: closure R s <= p ↔ s subseteq p
  proof: ⟨subset_closure.trans, fun ss _ h => mem_closure.1 h _ ss⟩

@[to_additive (attr := gcongr)]

中文:
定理 closure_le
  条件: {p}
  结论: closure R s <= p ↔ s subseteq p
  证明: ⟨subset_closure.trans, fun ss _ h => mem_closure.1 h _ ss⟩

@[to_additive (attr := gcongr)]

Depends on / 依赖: mem_closure, subset_closure, subset_closure.trans
-/
theorem closure_le {p} : closure R s <= p ↔ s subseteq p :=
  ⟨subset_closure.trans, fun ss _ h => mem_closure.1 h _ ss⟩

@[to_additive (attr := gcongr)]
/--
theorem `closure_mono` / 定理 `closure_mono`

English:
theorem closure_mono
  given: (h : s subseteq t)
  statement: closure R s <= closure R t
  proof: closure_le.2 h.trans subset_closure

中文:
定理 closure_mono
  条件: (h : s subseteq t)
  结论: closure R s <= closure R t
  证明: closure_le.2 h.trans subset_closure

Depends on / 依赖: closure_le, h.trans, subset_closure
-/
theorem closure_mono (h : s subseteq t) : closure R s <= closure R t :=
closure_le.2 h.trans subset_closure

/-- A `SubMulAction` is finitely generated if it is the closure of a finite set. -/
@[to_additive /-- A `SubAddAction` is finitely generated if it is the closure of a finite set. -/]
/--
Definition of `FG` / `FG` 的定义

English:
definition FG
  signature: (p : SubMulAction R M)
  body: exists (s : Set M), s.Finite ∧ p = closure R s

@[to_additive]

中文:
定义 FG
  签名: (p : SubMulAction R M)
  定义体: exists (s : Set M), s.Finite ∧ p = closure R s

@[to_additive]

Depends on / 依赖: Finite, closure, s.Finite
-/
def FG (p : SubMulAction R M) :=
  exists (s : Set M), s.Finite ∧ p = closure R s

@[to_additive]
/--
theorem `fg_iff` / 定理 `fg_iff`

English:
theorem fg_iff
  given: {p : SubMulAction R M}
  statement: p.FG ↔ exists (s : Finset M), p = closure R s
  proof: Set.exists_finite_iff_finset

中文:
定理 fg_iff
  条件: {p : SubMulAction R M}
  结论: p.FG ↔ 存在 (s : Finset M), p = closure R s
  证明: Set.exists_finite_iff_finset

Depends on / 依赖: Set.exists_finite_iff_finset, exists_finite_iff_finset
-/
theorem fg_iff {p : SubMulAction R M} : p.FG ↔ exists (s : Finset M), p = closure R s :=
  Set.exists_finite_iff_finset

end SubMulAction
