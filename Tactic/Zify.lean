/-!
# `zify` tactic

The `zify` tactic is used to shift propositions from `Nat` to `Int`.
This is often useful since `Int` has well-behaved subtraction.
```
example (a b c x y z : Nat) (h : ¬ x*y*z < 0) : c < a + 3*b := by
  zify
  zify at h
  /-
  h : ¬↑x * ↑y * ↑z < 0
  ⊢ ↑c < ↑a + 3 * ↑b
  -/

```
-/

public meta section

namespace Mathlib.Tactic.Zify

open Lean
open Lean.Meta
open Lean.Parser.Tactic
open Lean.Elab.Tactic

/--
`zify` rewrites the main goal by shifting propositions from `ℕ` to `ℤ`.
This is often useful since `ℤ` has well-behaved subtraction.

`zify` makes use of the `@[zify_simps]` attribute to insert casts into propositions, and the
`push_cast` tactic to simplify the `ℤ`-valued expressions.

`zify` is in some sense dual to the `lift` tactic. `lift (z : Int) to Nat` will change the type of
an integer `z` (in the supertype) to `Nat` (the subtype), given a proof that `z ≥ 0`; propositions
concerning `z` will still be over `Int`. `zify` changes propositions about `Nat` (the subtype) to
propositions about `Int` (the supertype), without changing the type of any variable.

* `zify at l1 l2 ...` rewrites at the given locations.
* `zify [h₁, ..., hₙ]` uses the expressions `h₁`, ..., `hₙ` as extra lemmas for simplification.
  This is especially useful in the presence of nat subtraction or of division: passing arguments of
  type `· ≤ ·` will allow `push_cast` to do more work.

Examples:
```
example (a b c x y z : Nat) (h : ¬ x*y*z < 0) : c < a + 3*b := by
  zify
  zify at h
  /-
  h : ¬↑x * ↑y * ↑z < 0
  ⊢ ↑c < ↑a + 3 * ↑b
  -/
  sorry

example (a b c : Nat) (h : a - b < c) (hab : b ≤ a) : False := by
  -- Nonnegativity hypothesis allows pushing `· - ·`.
  zify [hab] at h
  /- h : ↑a - ↑b < ↑c -/
  sorry
```
-/
syntax (name := zify) "zify" (simpArgs)? (location)? : tactic

macro_rules
| `(tactic| zify $[[$simpArgs,*]]? $[at $location]?) =>
  let args := simpArgs.map (·.getElems) |>.getD #[]
  `(tactic|
    simp -decide only [zify_simps, push_cast, $args,*] $[at $location]?)

/-- The `Simp.Context` generated by `zify`. -/
/-
**Mathlib.Tactic.Zify.mkZifyContext** 是 Mathlib 中的一个定义，位于命名空间 `Mathlib.Tactic.Zi
fy`。
形式化陈述：mkZifyContext (simpArgs : Option (Syntax.TSepArray `Lean.Parser.Tactic.sim
pStar ",")) : TacticM MkSimpContextResult
参数：simpArgs : Option (Syntax.TSepArray `Lean.Parser.Tactic.simpStar ",")。
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
The `Simp.Context` generated by `zify`.
-/
def mkZifyContext (simpArgs : Option (Syntax.TSepArray `Lean.Parser.Tactic.simpStar ",")) :
    TacticM MkSimpContextResult := do
  let args := simpArgs.map (·.getElems) |>.getD #[]
  mkSimpContext
    (← `(tactic| simp -decide only [zify_simps, push_cast, $args,*])) false

/-- A variant of `applySimpResultToProp` that cannot close the goal, but does not need a meta
variable and returns a tuple of a proof and the corresponding simplified proposition. -/
/-
**Mathlib.Tactic.Zify.applySimpResultToProp'** 是 Mathlib 中的一个定义，位于命名空间 `Mathlib.
Tactic.Zify`。
形式化陈述：applySimpResultToProp' (proof : Expr) (prop : Expr) (r : Simp.Result) : Me
taM (Expr × Expr)
参数：proof : Expr；prop : Expr；r : Simp.Result。
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
A variant of `applySimpResultToProp` that cannot close the goal, but does not ne
ed a meta
variable and returns a tuple of a proof and the corresponding simplified proposi
tion.
-/
def applySimpResultToProp' (proof : Expr) (prop : Expr) (r : Simp.Result) : MetaM (Expr × Expr) :=
  do
  match r.proof? with
  | some eqProof => return (← mkExpectedTypeHint (← mkEqMP eqProof proof) r.expr, r.expr)
  | none =>
    if r.expr != prop then
      return (← mkExpectedTypeHint proof r.expr, r.expr)
    else
      return (proof, r.expr)

/-- Translate a proof and the proposition into a zified form. -/
/-
**Mathlib.Tactic.Zify.zifyProof** 是 Mathlib 中的一个定义，位于命名空间 `Mathlib.Tactic.Zify`。
形式化陈述：zifyProof (simpArgs : Option (Syntax.TSepArray `Lean.Parser.Tactic.simpSta
r ",")) (proof : Expr) (prop : Expr) : TacticM (Expr × Expr)
参数：simpArgs : Option (Syntax.TSepArray `Lean.Parser.Tactic.simpStar ",")；proof :
 Expr；prop : Expr。
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
Translate a proof and the proposition into a zified form.
-/
def zifyProof (simpArgs : Option (Syntax.TSepArray `Lean.Parser.Tactic.simpStar ","))
    (proof : Expr) (prop : Expr) : TacticM (Expr × Expr) := do
  let ctx_result ← mkZifyContext simpArgs
  let (r, _) ← simp prop ctx_result.ctx
  applySimpResultToProp' proof prop r

attribute [zify_simps ←] Int.ofNat_inj Int.ofNat_le Int.ofNat_lt Int.ofNat_dvd
/-
**Mathlib.Tactic.Zify.natCast_ne** 是 Mathlib 中的一个定理，位于命名空间 `Mathlib.Tactic.Zify`
。
形式化陈述：∀ (a b : ℕ), a ≠ b ↔ ↑a ≠ ↑b
参数：a b : ℕ。
黑盒证明引用了以下数学事实（定理与引理）：
· 使用定理 `not_congr`：∀ {a b : Prop}, (a ↔ b) → (¬a ↔ ¬b)
· 使用定理 `Iff.symm`：∀ {a b : Prop}, (a ↔ b) → (b ↔ a)
· 使用定理 `Int.ofNat_inj`：∀ {m n : ℕ}, ↑m = ↑n ↔ m = n
-/
@[zify_simps] lemma natCast_ne (a b : Nat) : a ≠ b ↔ (a : Int) ≠ (b : Int) :=
  not_congr Int.ofNat_inj.symm
-- TODO: is it worth adding lemmas for Prime and Coprime as well?
-- Doing so in this file would require adding imports.


-- `Nat.cast_sub` is already tagged as `norm_cast` but it does allow to use assumptions like
-- `m < n` or more generally `m + k ≤ n`. We add two lemmas to increase the probability that
-- `zify` will push through `ℕ` subtraction.

variable {R : Type*} [AddGroupWithOne R]

@[deprecated "use Nat.cast_sub" (since := "2026-02-21"), norm_cast]
/-
**Mathlib.Tactic.Zify.Nat.cast_sub_of_add_le** 是 Mathlib 中的一个定理，位于命名空间 `Mathlib.
Tactic.Zify.Nat`。
形式化陈述：∀ {R : Type u_1} [inst : AddGroupWithOne R] {m n k : ℕ}, m + k ≤ n → ↑(n -
 m) = ↑n - ↑m
参数：n - m。
黑盒证明引用了以下数学事实（定理与引理）：
· 使用定理 `Nat.cast_sub`：cast_sub {m n} (h : m <= n) : ((n - m : Nat) : R) = n - m
· 使用定理 `LE.le.trans`：∀ {α : Type u_1} [inst : Preorder α] {a b c : α}, a ≤ b → b
 ≤ c → a ≤ c
· 使用定理 `Nat.le_add_right`：∀ (n k : ℕ), n ≤ n + k
-/
theorem Nat.cast_sub_of_add_le {m n k} (h : m + k ≤ n) :
    ((n - m : ℕ) : R) = n - m := Nat.cast_sub (m.le_add_right k |>.trans h)
/-
**Mathlib.Tactic.Zify.Nat.cast_sub_of_lt** 是 Mathlib 中的一个定理，位于命名空间 `Mathlib.Tact
ic.Zify.Nat`。
形式化陈述：∀ {R : Type u_1} [inst : AddGroupWithOne R] {m n : ℕ}, m < n → ↑(n - m) = 
↑n - ↑m
参数：n - m。
黑盒证明引用了以下数学事实（定理与引理）：
· 使用定理 `Nat.cast_sub`：cast_sub {m n} (h : m <= n) : ((n - m : Nat) : R) = n - m
· 使用定理 `LT.lt.le`：∀ {α : Type u_1} [inst : Preorder α] {a b : α}, a < b → a ≤ b
-/
@[norm_cast] theorem Nat.cast_sub_of_lt {m n} (h : m < n) :
    ((n - m : ℕ) : R) = n - m := Nat.cast_sub h.le

end Zify

end Mathlib.Tactic

