/-!
# Sheaf cohomology

Let `C` be a category equipped with a Grothendieck topology `J`.
We define the cohomology types `Sheaf.H F n` of an abelian
sheaf `F` on the site `(C, J)` for all `n : ℕ`. These abelian
groups are defined as the `Ext`-groups from the constant abelian
sheaf with values `ℤ` (actually `ULift ℤ`) to `F`.

We also define `Sheaf.cohomologyPresheaf F n : Cᵒᵖ ⥤ AddCommGrpCat`
which is the presheaf which sends `U` to the `n`th `Ext`-group
from the free abelian sheaf generated by the presheaf
of sets `yoneda.obj U` to `F`.

## TODO
* if `U` is a terminal object of `C`, define an isomorphism
  `(F.cohomologyPresheaf n).obj (Opposite.op U) ≃+ Sheaf.H F n`.
* if `U : C`, define an isomorphism
  `(F.cohomologyPresheaf n).obj (Opposite.op U) ≃+ Sheaf.H (F.over U) n`.

-/

@[expose] public noncomputable section

assert_not_exists TwoSidedIdeal

universe w' w v u

namespace CategoryTheory

open Abelian

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

namespace Sheaf

section

variable (F : Sheaf J AddCommGrpCat.{w})
  [HasSheafify J AddCommGrpCat.{w}] [HasExt.{w'} (Sheaf J AddCommGrpCat.{w})]

/--
Definition of `H` / `H` 的定义

English:
abbreviation H
  signature: (n : Nat)
  body: Ext ((constantSheaf J AddCommGrpCat.{w}).obj (AddCommGrpCat.of (ULift Int))) F n

中文:
缩写 H
  签名: (n : 自然数)
  定义体: Ext ((constantSheaf J AddCommGrpCat.{w}).obj (AddCommGrpCat.of (ULift Int))) F n

Depends on / 依赖: AddCommGrpCat, AddCommGrpCat.of, constantSheaf
-/
abbrev H (n : Nat) : Type w' :=
  Ext ((constantSheaf J AddCommGrpCat.{w}).obj (AddCommGrpCat.of (ULift Int))) F n

end

section

variable [HasSheafify J AddCommGrpCat.{v}] [HasExt.{w'} (Sheaf J AddCommGrpCat.{v})]

variable (J) in
/--
Definition of `cohomologyPresheafFunctor` / `cohomologyPresheafFunctor` 的定义

English:
definition cohomologyPresheafFunctor
  signature: (n : Nat)
  body: Functor.flip
    (Functor.op (yoneda ⋙ (Functor.whiskeringRight _ _ _).obj
      AddCommGrpCat.free ⋙ presheafToSheaf _ _) ⋙ extFunctor n)

中文:
定义 cohomologyPresheafFunctor
  签名: (n : 自然数)
  定义体: Functor.flip
    (Functor.op (yoneda ⋙ (Functor.whiskeringRight _ _ _).obj
      AddCommGrpCat.free ⋙ presheafToSheaf _ _) ⋙ extFunctor n)

Depends on / 依赖: AddCommGrpCat, AddCommGrpCat.free, Functor, Functor.flip, Functor.op, Functor.whiskeringRight, extFunctor, presheafToSheaf, whiskeringRight, yoneda
-/
def cohomologyPresheafFunctor (n : Nat) :
    Sheaf J AddCommGrpCat.{v} ⥤ Cᵒᵖ ⥤ AddCommGrpCat.{w'} :=
  Functor.flip
    (Functor.op (yoneda ⋙ (Functor.whiskeringRight _ _ _).obj
      AddCommGrpCat.free ⋙ presheafToSheaf _ _) ⋙ extFunctor n)

/--
Definition of `cohomologyPresheaf` / `cohomologyPresheaf` 的定义

English:
abbreviation cohomologyPresheaf
  signature: (F : Sheaf J AddCommGrpCat.{v}) (n : Nat)
  body: (cohomologyPresheafFunctor J n).obj F

中文:
缩写 cohomologyPresheaf
  签名: (F : Sheaf J AddCommGrpCat.{v}) (n : 自然数)
  定义体: (cohomologyPresheafFunctor J n).obj F

Depends on / 依赖: cohomologyPresheafFunctor
-/
abbrev cohomologyPresheaf (F : Sheaf J AddCommGrpCat.{v}) (n : Nat) :
    Cᵒᵖ ⥤ AddCommGrpCat.{w'} :=
  (cohomologyPresheafFunctor J n).obj F

/--
Definition of `H'` / `H'` 的定义

English:
abbreviation H'
  signature: (F : Sheaf J AddCommGrpCat.{v}) (n : Nat) (X : C)
  body: (F.cohomologyPresheaf n).obj (Opposite.op X)

中文:
缩写 H'
  签名: (F : Sheaf J AddCommGrpCat.{v}) (n : 自然数) (X : C)
  定义体: (F.cohomologyPresheaf n).obj (Opposite.op X)

Depends on / 依赖: F.cohomologyPresheaf, Opposite, Opposite.op, cohomologyPresheaf
-/
abbrev H' (F : Sheaf J AddCommGrpCat.{v}) (n : Nat) (X : C) :
    AddCommGrpCat.{w'} :=
  (F.cohomologyPresheaf n).obj (Opposite.op X)

end

section

variable [HasSheafify J AddCommGrpCat.{w}] [HasExt.{w'} (Sheaf J AddCommGrpCat.{w})]

instance (F : Sheaf J AddCommGrpCat.{w}) {n : Nat} [Injective F] : Subsingleton (H F (n + 1)) :=
  subsingleton_of_forall_eq 0 fun x => (Ext.eq_zero_of_injective x)

variable (F : Sheaf J AddCommGrpCat.{w}) {T : C} (hT : Limits.IsTerminal T)

open AddCommGrpCat Opposite

/--
Definition of `H.equiv₀` / `H.equiv₀` 的定义

English:
definition H.equiv₀
  signature: : H F 0 ≃+ F.obj.obj (op T)
  body: AddEquiv.trans Ext.addEquiv₀
    AddEquiv.trans ((constantSheafAdj J AddCommGrpCat hT).homAddEquiv _ F)
      (uliftZMultiplesAddEquiv _)

中文:
定义 H.equiv₀
  签名: : H F 0 ≃+ F.obj.obj (op T)
  定义体: AddEquiv.trans Ext.addEquiv₀
    AddEquiv.trans ((constantSheafAdj J AddCommGrpCat hT).homAddEquiv _ F)
      (uliftZMultiplesAddEquiv _)

Depends on / 依赖: AddCommGrpCat, AddEquiv, AddEquiv.trans, Ext.addEquiv, constantSheafAdj, homAddEquiv, uliftZMultiplesAddEquiv
-/
noncomputable def H.equiv₀ : H F 0 ≃+ F.obj.obj (op T) :=
AddEquiv.trans Ext.addEquiv₀
    AddEquiv.trans ((constantSheafAdj J AddCommGrpCat hT).homAddEquiv _ F)
      (uliftZMultiplesAddEquiv _)

variable {F G : Sheaf J AddCommGrpCat.{w}} (f : F ⟶ G)

/--
Definition of `H.map` / `H.map` 的定义

English:
definition H.map
  signature: (n : Nat)
  body: (Ext.mk₀ f).postcomp ((constantSheaf J AddCommGrpCat).obj (of (ULift Int))) (add_zero n)

@[reassoc]

中文:
定义 H.map
  签名: (n : 自然数)
  定义体: (Ext.mk₀ f).postcomp ((constantSheaf J AddCommGrpCat).obj (of (ULift Int))) (add_zero n)

@[reassoc]

Depends on / 依赖: AddCommGrpCat, Ext.mk, add_zero, constantSheaf, postcomp
-/
noncomputable def H.map (n : Nat) : H F n ->+ H G n :=
  (Ext.mk₀ f).postcomp ((constantSheaf J AddCommGrpCat).obj (of (ULift Int))) (add_zero n)

@[reassoc]
/--
lemma `H.addEquiv₀_map` / 引理 `H.addEquiv₀_map`

English:
lemma H.addEquiv₀_map
  given: (x : H F 0)
  statement: Ext.addEquiv₀ (H.map f 0 x) = Ext.addEquiv₀ x ≫ f
  proof: by
  delta Ext.addEquiv₀
  apply (Ext.mk₀_bijective _ G).injective
  simp only [AddEquiv.coe_mk, Ext.mk₀_homEquiv₀_apply, Ext.mk₀_homEquiv₀_apply, ← Ext.mk₀_comp_mk₀]
  rfl

中文:
引理 H.addEquiv₀_map
  条件: (x : H F 0)
  结论: Ext.addEquiv₀ (H.map f 0 x) = Ext.addEquiv₀ x ≫ f
  证明: by
  delta Ext.addEquiv₀
  apply (Ext.mk₀_bijective _ G).injective
  simp only [AddEquiv.coe_mk, Ext.mk₀_homEquiv₀_apply, Ext.mk₀_homEquiv₀_apply, ← Ext.mk₀_comp_mk₀]
  rfl

Depends on / 依赖: AddEquiv, AddEquiv.coe_mk, Ext.addEquiv, Ext.mk, coe_mk, injective
-/
lemma H.addEquiv₀_map (x : H F 0) : Ext.addEquiv₀ (H.map f 0 x) = Ext.addEquiv₀ x ≫ f := by
  delta Ext.addEquiv₀
  apply (Ext.mk₀_bijective _ G).injective
  simp only [AddEquiv.coe_mk, Ext.mk₀_homEquiv₀_apply, Ext.mk₀_homEquiv₀_apply, ← Ext.mk₀_comp_mk₀]
  rfl

/--
theorem `H.equiv₀_naturality` / 定理 `H.equiv₀_naturality`

English:
theorem H.equiv₀_naturality
  given: (x : H F 0)
  proof: by
  simp only [equiv₀, AddEquiv.trans_apply, addEquiv₀_map f x]
  rfl

中文:
定理 H.equiv₀_naturality
  条件: (x : H F 0)
  证明: by
  simp only [equiv₀, AddEquiv.trans_apply, addEquiv₀_map f x]
  rfl

Depends on / 依赖: AddEquiv, AddEquiv.trans_apply, trans_apply
-/
theorem H.equiv₀_naturality (x : H F 0) :
    f.hom.app (op T) (H.equiv₀ F hT x) = H.equiv₀ G hT (H.map f 0 x) := by
  simp only [equiv₀, AddEquiv.trans_apply, addEquiv₀_map f x]
  rfl

/--
theorem `H.equiv₀_symm_naturality` / 定理 `H.equiv₀_symm_naturality`

English:
theorem H.equiv₀_symm_naturality
  given: (x : F.obj.obj (op T))
  proof: by
  apply (H.equiv₀ G hT).injective
  simp [← H.equiv₀_naturality]

中文:
定理 H.equiv₀_symm_naturality
  条件: (x : F.obj.obj (op T))
  证明: by
  apply (H.equiv₀ G hT).injective
  simp [← H.equiv₀_naturality]

Depends on / 依赖: H.equiv, injective
-/
theorem H.equiv₀_symm_naturality (x : F.obj.obj (op T)) :
    H.map f 0 ((H.equiv₀ F hT).symm x) = (H.equiv₀ G hT).symm (f.hom.app (op T) x) := by
  apply (H.equiv₀ G hT).injective
  simp [← H.equiv₀_naturality]

/--
lemma `H.map_apply` / 引理 `H.map_apply`

English:
lemma H.map_apply
  given: {n : Nat} (x : H F n)
  proof: rfl

@[simp]

中文:
引理 H.map_apply
  条件: {n : 自然数} (x : H F n)
  证明: rfl

@[simp]
-/
lemma H.map_apply {n : Nat} (x : H F n) :
    H.map f n x = x.comp (Ext.mk₀ f) (add_zero n) := rfl

@[simp]
/--
lemma `H.map_id_apply` / 引理 `H.map_id_apply`

English:
lemma H.map_id_apply
  given: {n : Nat} (x : H F n)
  statement: H.map (𝟙 F) n x = x
  proof: by
  simp [H.map_apply]

中文:
引理 H.map_id_apply
  条件: {n : 自然数} (x : H F n)
  结论: H.map (𝟙 F) n x = x
  证明: by
  simp [H.map_apply]

Depends on / 依赖: H.map_apply, map_apply
-/
lemma H.map_id_apply {n : Nat} (x : H F n) : H.map (𝟙 F) n x = x := by
  simp [H.map_apply]

/--
lemma `H.map_comp_apply` / 引理 `H.map_comp_apply`

English:
lemma H.map_comp_apply
  given: {n : Nat} {G' : Sheaf J AddCommGrpCat.{w}} (g : G ⟶ G') (x : H F n)
  proof: by
  simp [H.map_apply]

@[simp]

中文:
引理 H.map_comp_apply
  条件: {n : 自然数} {G' : Sheaf J AddCommGrpCat.{w}} (g : G ⟶ G') (x : H F n)
  证明: by
  simp [H.map_apply]

@[simp]

Depends on / 依赖: H.map_apply, map_apply
-/
lemma H.map_comp_apply {n : Nat} {G' : Sheaf J AddCommGrpCat.{w}} (g : G ⟶ G') (x : H F n) :
    H.map (f ≫ g) n x = H.map g n (H.map f n x) := by
  simp [H.map_apply]

@[simp]
/--
lemma `H.map_add_apply` / 引理 `H.map_add_apply`

English:
lemma H.map_add_apply
  given: {n : Nat} (f g : F ⟶ G) (x : H F n)
  proof: by
  simp [map, Ext.mk₀_add]

中文:
引理 H.map_add_apply
  条件: {n : 自然数} (f g : F ⟶ G) (x : H F n)
  证明: by
  simp [map, Ext.mk₀_add]

Depends on / 依赖: Ext.mk
-/
lemma H.map_add_apply {n : Nat} (f g : F ⟶ G) (x : H F n) :
    H.map (f + g) n x = H.map f n x + H.map g n x := by
  simp [map, Ext.mk₀_add]

attribute [local simp] H.map_comp_apply in
variable (J) in
/-- `H` as a functor. -/
@[simps]
/--
Definition of `functorH` / `functorH` 的定义

English:
definition functorH
  signature: (n : Nat)
  body: .of (H F n)
  map f := AddCommGrpCat.ofHom (H.map f n)

中文:
定义 functorH
  签名: (n : 自然数)
  定义体: .of (H F n)
  map f := AddCommGrpCat.ofHom (H.map f n)
-/
noncomputable def functorH (n : Nat) : Sheaf J AddCommGrpCat.{w} ⥤ AddCommGrpCat.{w'} where
  obj F := .of (H F n)
  map f := AddCommGrpCat.ofHom (H.map f n)

instance (n : Nat) : (functorH J n).Additive where

/--
lemma `subsingleton_H_of_isZero` / 引理 `subsingleton_H_of_isZero`

English:
lemma subsingleton_H_of_isZero
  given: {F : Sheaf J AddCommGrpCat.{w}} (h : Limits.IsZero F) (n : Nat)
  proof: by
  rw [← functorH_obj_coe]
  apply AddCommGrpCat.subsingleton_of_isZero
  exact Functor.map_isZero (functorH J n) h

@[deprecated (since := "2026-05-05")] noncomputable alias cohomologyFunctor := functorH

中文:
引理 subsingleton_H_of_isZero
  条件: {F : Sheaf J AddCommGrpCat.{w}} (h : Limits.IsZero F) (n : 自然数)
  证明: by
  rw [← functorH_obj_coe]
  apply AddCommGrpCat.subsingleton_of_isZero
  exact Functor.map_isZero (functorH J n) h

@[deprecated (since := "2026-05-05")] noncomputable alias cohomologyFunctor := functorH

Depends on / 依赖: AddCommGrpCat, AddCommGrpCat.subsingleton_of_isZero, Functor, Functor.map_isZero, functorH, functorH_obj_coe, map_isZero, subsingleton_of_isZero
-/
lemma subsingleton_H_of_isZero {F : Sheaf J AddCommGrpCat.{w}} (h : Limits.IsZero F) (n : Nat) :
    Subsingleton (F.H n) := by
  rw [← functorH_obj_coe]
  apply AddCommGrpCat.subsingleton_of_isZero
