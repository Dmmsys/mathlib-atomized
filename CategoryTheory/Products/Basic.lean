/-! Two rfl lemmas that cannot be generated by `@[simps]`. -/

@[simp]
/--
theorem `prod_id` / 定理 `prod_id`

English:
theorem prod_id
  given: (X : C) (Y : D)
  statement: 𝟙 (X, Y) = 𝟙 X ×ₘ 𝟙 Y
  proof: rfl

中文:
定理 prod_id
  条件: (X : C) (Y : D)
  结论: 𝟙 (X, Y) = 𝟙 X ×ₘ 𝟙 Y
  证明: rfl
-/
theorem prod_id (X : C) (Y : D) : 𝟙 (X, Y) = 𝟙 X ×ₘ 𝟙 Y :=
  rfl

/--
theorem `prod_id'` / 定理 `prod_id'`

English:
theorem prod_id'
  given: (X : C) (Y : D)
  statement: 𝟙 (X, Y) = (𝟙 X, 𝟙 Y)
  proof: rfl

@[simp]

中文:
定理 prod_id'
  条件: (X : C) (Y : D)
  结论: 𝟙 (X, Y) = (𝟙 X, 𝟙 Y)
  证明: rfl

@[simp]
-/
theorem prod_id' (X : C) (Y : D) : 𝟙 (X, Y) = (𝟙 X, 𝟙 Y) :=
  rfl

@[simp]
/--
theorem `prod_comp` / 定理 `prod_comp`

English:
theorem prod_comp
  given: {P Q R : C} {S T U : D} (f : (P, S) ⟶ (Q, T)) (g : (Q, T) ⟶ (R, U))
  proof: rfl

中文:
定理 prod_comp
  条件: {P Q R : C} {S T U : D} (f : (P, S) ⟶ (Q, T)) (g : (Q, T) ⟶ (R, U))
  证明: rfl
-/
theorem prod_comp {P Q R : C} {S T U : D} (f : (P, S) ⟶ (Q, T)) (g : (Q, T) ⟶ (R, U)) :
    f ≫ g = f.1 ≫ g.1 ×ₘ f.2 ≫ g.2 :=
  rfl

/-! Two `eqToHom` lemmas about projections. -/

@[simp]
/--
theorem `eqToHom_fst` / 定理 `eqToHom_fst`

English:
theorem eqToHom_fst
  given: {X Y : C × D} (h : X = Y)
  proof: by subst h; rfl

@[simp]

中文:
定理 eqToHom_fst
  条件: {X Y : C × D} (h : X = Y)
  证明: by subst h; rfl

@[simp]
-/
theorem eqToHom_fst {X Y : C × D} (h : X = Y) :
    (eqToHom h).1 = eqToHom (h ▸ rfl) := by subst h; rfl

@[simp]
/--
theorem `eqToHom_snd` / 定理 `eqToHom_snd`

English:
theorem eqToHom_snd
  given: {X Y : C × D} (h : X = Y)
  proof: by subst h; rfl

中文:
定理 eqToHom_snd
  条件: {X Y : C × D} (h : X = Y)
  证明: by subst h; rfl
