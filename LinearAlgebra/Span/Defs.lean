定理 Commute.span_left
  条件: {s : 集合 A} {x : A} (h : 对任意 y in s, Commute y x)
  证明: by
  intro y hy
  induction hy using span_induction with
  | mem _ _ => aesop
  | zero => exact .zero_left _
  | add _ _ _ _ h₁ h₂ => exact h₁.add_left h₂
  | smul _ _ _ h => exact h.smul_left _

Depends on / 依赖: add_left, h.smul_left, smul_left, span_induction, zero_left
-/
theorem Commute.span_left {s : Set A} {x : A} (h : forall y in s, Commute y x) :
    forall y in span R s, Commute y x := by
  intro y hy
  induction hy using span_induction with
  | mem _ _ => aesop
  | zero => exact .zero_left _
  | add _ _ _ _ h₁ h₂ => exact h₁.add_left h₂
  | smul _ _ _ h => exact h.smul_left _

/--
theorem `Commute.span_right` / 定理 `Commute.span_right`

English:
theorem Commute.span_right
  given: {s : Set A} {x : A} (h : forall y in s, Commute x y)
  proof: by
  simp only [Commute.symm_iff (a := x)] at *
  exact .span_left h

中文:
定理 Commute.span_right
  条件: {s : 集合 A} {x : A} (h : 对任意 y in s, Commute x y)
  证明: by
  simp only [Commute.symm_iff (a := x)] at *
  exact .span_left h

Depends on / 依赖: Commute, Commute.symm_iff, span_left, symm_iff
-/
theorem Commute.span_right {s : Set A} {x : A} (h : forall y in s, Commute x y) :
    forall y in span R s, Commute x y := by
  simp only [Commute.symm_iff (a := x)] at *
  exact .span_left h

