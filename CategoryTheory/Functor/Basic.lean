module

public import Mathlib.CategoryTheory.Category.Basic
public import Mathlib.Combinatorics.Quiver.Prefunctor
public import Mathlib.Tactic.CategoryTheory.CategoryStar
public meta import Mathlib.Tactic.ToDual

/-!
# Functors

Defines a functor between categories, extending a `Prefunctor` between quivers.

Introduces, in the `CategoryTheory` scope, notations `C ⥤ D` for the type of all functors
from `C` to `D`, `𝟭` for the identity functor and `⋙` for functor composition.

TODO: Switch to using the `⇒` arrow.
-/

@[expose] public section

set_option mathlib.tactic.category.grind true

namespace CategoryTheory

-- declare the `v`'s first; see note [category theory universes].
universe v v₁ v₂ v₃ u u₁ u₂ u₃

/-- `Functor C D` represents a functor between categories `C` and `D`.

To apply a functor `F` to an object use `F.obj X`, and to a morphism use `F.map f`.

The axiom `map_id` expresses preservation of identities, and
`map_comp` expresses functoriality. -/
@[stacks 001B, wikidata Q864475]
/--
Definition of `Functor` / `Functor` 的定义

English:
structure Functor
  parameters: (C : Type u₁) [Category.{v₁} C] (D : Type u₂) [Category.{v₂} D]
  axioms and operations (4):
    - obj : C -> D
    - map : forall {X Y : C}, (X ⟶ Y) -> ((obj X) ⟶ (obj Y))
    - map_id : forall X : C, map (𝟙 X) = 𝟙 (obj X)  [default: by cat_disch]
    - map_comp : forall {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z), map (f ≫ g) = map f ≫ map g  [default: by cat_disch]

中文:
结构 Functor
  参数: (C : 类型u₁) [Category.{v₁} C] (D : 类型u₂) [Category.{v₂} D]
  公理与运算 (4 个):
    - obj : C -> D
    - map : 对任意 {X Y : C}, (X ⟶ Y) -> ((obj X) ⟶ (obj Y))
    - map_id : 对任意 X : C, map (𝟙 X) = 𝟙 (obj X)  [默认: by cat_disch]
    - map_comp : 对任意 {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z), map (f ≫ g) = map f ≫ map g  [默认: by cat_disch]

Depends on / 依赖: cat_disch
-/
structure Functor (C : Type u₁) [Category.{v₁} C] (D : Type u₂) [Category.{v₂} D] :
    Type max v₁ v₂ u₁ u₂ where
  /-- The action of a functor on objects. -/
  obj : C -> D
  /-- The action of a functor on morphisms. -/
  map : forall {X Y : C}, (X ⟶ Y) -> ((obj X) ⟶ (obj Y))
  /-- A functor preserves identity morphisms. -/
  map_id : forall X : C, map (𝟙 X) = 𝟙 (obj X) := by cat_disch
  /-- A functor preserves composition. -/
  map_comp : forall {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z), map (f ≫ g) = map f ≫ map g := by cat_disch

/-- Notation for a functor between categories. -/
-- A functor is basically a function, so give ⥤ a similar precedence to → (25).
-- For example, `C × D ⥤ E` should parse as `(C × D) ⥤ E` not `C × (D ⥤ E)`.
scoped[CategoryTheory] infixr:26 " ⥤ " => Functor -- type as \func

attribute [simp] Functor.map_id Functor.map_comp
attribute [grind =] Functor.map_id
attribute [grind _=_] Functor.map_comp
attribute [to_dual self] Functor.map Functor.map_comp
attribute [to_dual self (reorder := map (X Y), map_comp (X Z, f g))] Functor.mk
attribute [to_dual self (reorder := mk (map (X Y), map_comp (X Z, f g)))] Functor.casesOn

-- Note: We manually add this lemma which could be generated by `reassoc`,
-- since we will import this file into `Mathlib/Tactic/CategoryTheory/Reassoc.lean`.
@[to_dual none]
/--
lemma `Functor.map_comp_assoc` / 引理 `Functor.map_comp_assoc`

English:
lemma Functor.map_comp_assoc
  statement: {C : Type u₁} [Category* C] {D : Type u₂} [Category* D] (F : C ⥤ D)
  proof: by
  grind

中文:
引理 Functor.map_comp_assoc
  结论: {C : 类型u₁} [Category* C] {D : 类型u₂} [Category* D] (F : C ⥤ D)
  证明: by
  grind
-/
lemma Functor.map_comp_assoc {C : Type u₁} [Category* C] {D : Type u₂} [Category* D] (F : C ⥤ D)
    {X Y Z : C} (f : X ⟶ Y) (g : Y ⟶ Z) {W : D} (h : F.obj Z ⟶ W) :
    (F.map (f ≫ g)) ≫ h = F.map f ≫ F.map g ≫ h := by
  grind

namespace Functor

section

variable (C : Type u₁) [Category.{v₁} C]

initialize_simps_projections Functor

-- We don't use `@[simps]` here because we want `C` implicit for the simp lemmas.
/-- `𝟭 C` is the identity functor on a category `C`. -/
@[implicit_reducible]
/--
Definition of `id` / `id` 的定义

English:
definition id
  signature: : C ⥤ C where
  body: X
  map f := f

中文:
定义 id
  签名: : C ⥤ C where
  定义体: X
  map f := f
-/
protected def id : C ⥤ C where
  obj X := X
  map f := f

/-- Notation for the identity functor on a category. -/
scoped[CategoryTheory] notation "𝟭" => Functor.id -- Type this as `\sb1`

/--
Instance `_anonymous_` / 实例 `_anonymous_`

English:
instance :
  signature: Inhabited (C ⥤ C)
  body: ⟨Functor.id C⟩

中文:
实例 :
  签名: Inhabited (C ⥤ C)
  定义体: ⟨Functor.id C⟩

Depends on / 依赖: Functor, Functor.id
-/
instance : Inhabited (C ⥤ C) :=
  ⟨Functor.id C⟩

variable {C}

@[simp, grind =]
/--
theorem `id_obj` / 定理 `id_obj`

English:
theorem id_obj
  given: (X : C)
  statement: (𝟭 C).obj X = X
  proof: rfl

@[simp, grind =, to_dual self]

中文:
定理 id_obj
  条件: (X : C)
  结论: (𝟭 C).obj X = X
  证明: rfl

@[simp, grind =, to_dual self]
-/
theorem id_obj (X : C) : (𝟭 C).obj X = X := rfl

@[simp, grind =, to_dual self]
/--
theorem `id_map` / 定理 `id_map`

English:
theorem id_map
  given: {X Y : C} (f : X ⟶ Y)
  statement: (𝟭 C).map f = f
  proof: rfl

中文:
定理 id_map
  条件: {X Y : C} (f : X ⟶ Y)
  结论: (𝟭 C).map f = f
  证明: rfl
-/
theorem id_map {X Y : C} (f : X ⟶ Y) : (𝟭 C).map f = f := rfl

end

section

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  {E : Type u₃} [Category.{v₃} E]

/-- The prefunctor between the underlying quivers. -/
@[simps]
/--
Definition of `toPrefunctor` / `toPrefunctor` 的定义

English:
definition toPrefunctor
  signature: (F : C ⥤ D)
  body: { F with }

@[to_dual self]

中文:
定义 toPrefunctor
  签名: (F : C ⥤ D)
  定义体: { F with }

@[to_dual self]
-/
def toPrefunctor (F : C ⥤ D) : Prefunctor C D := { F with }

@[to_dual self]
/--
theorem `congr_map` / 定理 `congr_map`

English:
theorem congr_map
  statement: (F : C ⥤ D) {X Y : C} {f g : X ⟶ Y}
  proof: by
  rw [h]

中文:
定理 congr_map
  结论: (F : C ⥤ D) {X Y : C} {f g : X ⟶ Y}
  证明: by
  rw [h]
-/
theorem congr_map (F : C ⥤ D) {X Y : C} {f g : X ⟶ Y}
    (h : f = g) : F.map f = F.map g := by
  rw [h]

/-- `F ⋙ G` is the composition of a functor `F` and a functor `G` (`F` first, then `G`).
-/
@[simps (attr := grind =) obj, implicit_reducible]
/--
Definition of `comp` / `comp` 的定义

English:
definition comp
  signature: (F : C ⥤ D) (G : D ⥤ E)
  body: G.obj (F.obj X)
  map f := G.map (F.map f)

中文:
定义 comp
  签名: (F : C ⥤ D) (G : D ⥤ E)
  定义体: G.obj (F.obj X)
  map f := G.map (F.map f)

Depends on / 依赖: F.obj, G.obj
-/
def comp (F : C ⥤ D) (G : D ⥤ E) : C ⥤ E where
  obj X := G.obj (F.obj X)
  map f := G.map (F.map f)

/-- Notation for composition of functors. -/
scoped[CategoryTheory] infixr:80 " ⋙ " => Functor.comp

@[simp, grind =, to_dual self]
/--
theorem `comp_map` / 定理 `comp_map`

English:
theorem comp_map
  given: (F : C ⥤ D) (G : D ⥤ E) {X Y : C} (f : X ⟶ Y)
  proof: rfl

中文:
定理 comp_map
  条件: (F : C ⥤ D) (G : D ⥤ E) {X Y : C} (f : X ⟶ Y)
  证明: rfl
-/
theorem comp_map (F : C ⥤ D) (G : D ⥤ E) {X Y : C} (f : X ⟶ Y) :
    (F ⋙ G).map f = G.map (F.map f) := rfl

-- These are not simp lemmas because rewriting along equalities between functors
-- is not necessarily a good idea.
-- Natural isomorphisms are also provided in `Whiskering.lean`.
/--
theorem `comp_id` / 定理 `comp_id`

English:
theorem comp_id
  given: (F : C ⥤ D)
  statement: F ⋙ 𝟭 D = F
  proof: rfl

中文:
定理 comp_id
  条件: (F : C ⥤ D)
  结论: F ⋙ 𝟭 D = F
  证明: rfl
-/
protected theorem comp_id (F : C ⥤ D) : F ⋙ 𝟭 D = F := rfl

/--
theorem `id_comp` / 定理 `id_comp`

English:
theorem id_comp
  given: (F : C ⥤ D)
  statement: 𝟭 C ⋙ F = F
  proof: rfl

@[simp, to_dual self]

中文:
定理 id_comp
  条件: (F : C ⥤ D)
  结论: 𝟭 C ⋙ F = F
  证明: rfl

@[simp, to_dual self]
-/
protected theorem id_comp (F : C ⥤ D) : 𝟭 C ⋙ F = F := rfl

@[simp, to_dual self]
/--
theorem `map_dite` / 定理 `map_dite`

English:
theorem map_dite
  statement: (F : C ⥤ D) {X Y : C} {P : Prop} [Decidable P]
  proof: by
  cat_disch

@[simp]

中文:
定理 map_dite
  结论: (F : C ⥤ D) {X Y : C} {P : 命题} [Decidable P]
  证明: by
  cat_disch

@[simp]

Depends on / 依赖: cat_disch
-/
theorem map_dite (F : C ⥤ D) {X Y : C} {P : Prop} [Decidable P]
    (f : P -> (X ⟶ Y)) (g : ¬P -> (X ⟶ Y)) :
    F.map (if h : P then f h else g h) = if h : P then F.map (f h) else F.map (g h) := by
  cat_disch

@[simp]
/--
theorem `toPrefunctor_comp` / 定理 `toPrefunctor_comp`

English:
theorem toPrefunctor_comp
  given: (F : C ⥤ D) (G : D ⥤ E)
  proof: rfl

中文:
定理 toPrefunctor_comp
  条件: (F : C ⥤ D) (G : D ⥤ E)
  证明: rfl
-/
theorem toPrefunctor_comp (F : C ⥤ D) (G : D ⥤ E) :
    F.toPrefunctor.comp G.toPrefunctor = (F ⋙ G).toPrefunctor := rfl

/--
lemma `toPrefunctor_injective` / 引理 `toPrefunctor_injective`

English:
lemma toPrefunctor_injective
  given: {F G : C ⥤ D} (h : F.toPrefunctor = G.toPrefunctor)
  proof: by
  obtain ⟨obj, map, _, _⟩ := F
  obtain ⟨obj', map', _, _⟩ := G
  obtain rfl : obj = obj' := congr_arg Prefunctor.obj h
  obtain rfl : @map = @map' := by simpa [Functor.toPrefunctor] using h
  rfl

中文:
引理 toPrefunctor_injective
  条件: {F G : C ⥤ D} (h : F.toPrefunctor = G.toPrefunctor)
  证明: by
  obtain ⟨obj, map, _, _⟩ := F
  obtain ⟨obj', map', _, _⟩ := G
  obtain rfl : obj = obj' := congr_arg Prefunctor.obj h
  obtain rfl : @map = @map' := by simpa [Functor.toPrefunctor] using h
  rfl

Depends on / 依赖: Functor, Functor.toPrefunctor, Prefunctor, Prefunctor.obj, congr_arg, toPrefunctor
-/
lemma toPrefunctor_injective {F G : C ⥤ D} (h : F.toPrefunctor = G.toPrefunctor) :
    F = G := by
  obtain ⟨obj, map, _, _⟩ := F
  obtain ⟨obj', map', _, _⟩ := G
  obtain rfl : obj = obj' := congr_arg Prefunctor.obj h
  obtain rfl : @map = @map' := by simpa [Functor.toPrefunctor] using h
  rfl

end

end Functor

end CategoryTheory
