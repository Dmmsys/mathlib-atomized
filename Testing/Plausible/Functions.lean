-/
inductive InjectiveFunction (α : Type u) : Type u
  | mapToSelf (xs : List (Σ _ : α, α)) :
      xs.map Sigma.fst ~ xs.map Sigma.snd -> List.Nodup (xs.map Sigma.snd) -> InjectiveFunction α

