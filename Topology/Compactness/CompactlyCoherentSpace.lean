lemma of_isOpen_forall_compactSpace (h : forall (s : Set X), (forall (K : Type u) [TopologicalSpace K],
      [CompactSpace K] -> forall (f : K -> X), Continuous f -> IsOpen (f ⁻¹' s)) -> IsOpen s) :
    CompactlyCoherentSpace X := by
  refine of_isOpen fun A hA => h A fun K _ _ f hf => ?_
  specialize hA (range f) (isCompact_range hf)
