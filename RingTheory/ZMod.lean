/-!
# Ring-theoretic facts about `ZMod n`

We collect a few facts about `ZMod n` that need some ring theory to be proved/stated.

## Main statements

* `ZMod.ker_intCastRingHom`: the ring homomorphism `ℤ → ZMod n` has kernel generated by `n`.
* `ZMod.ringHom_eq_of_ker_eq`: two ring homomorphisms into `ZMod n` with equal kernels are equal.
* `isReduced_zmod`: `ZMod n` is reduced for all squarefree `n`.
-/

public section

/--
theorem `ZMod.ker_intCastRingHom` / 定理 `ZMod.ker_intCastRingHom`

English:
theorem ZMod.ker_intCastRingHom
  given: (n : Nat)
  proof: by
  ext
  rw [Ideal.mem_span_singleton]; rw [RingHom.mem_ker]; rw [Int.coe_castRingHom]; rw [ZMod.intCast_zmod_eq_zero_iff_dvd]

中文:
定理 ZMod.ker_intCastRingHom
  条件: (n : 自然数)
  证明: by
  ext
  rw [Ideal.mem_span_singleton]; rw [RingHom.mem_ker]; rw [Int.coe_castRingHom]; rw [ZMod.intCast_zmod_eq_zero_iff_dvd]

Depends on / 依赖: Ideal.mem_span_singleton, Int.coe_castRingHom, RingHom, RingHom.mem_ker, ZMod.intCast_zmod_eq_zero_iff_dvd, coe_castRingHom, intCast_zmod_eq_zero_iff_dvd, mem_ker, mem_span_singleton
-/
theorem ZMod.ker_intCastRingHom (n : Nat) :
    RingHom.ker (Int.castRingHom (ZMod n)) = Ideal.span ({(n : Int)} : Set Int) := by
  ext
  rw [Ideal.mem_span_singleton]; rw [RingHom.mem_ker]; rw [Int.coe_castRingHom]; rw [ZMod.intCast_zmod_eq_zero_iff_dvd]

/--
theorem `ZMod.ringHom_eq_of_ker_eq` / 定理 `ZMod.ringHom_eq_of_ker_eq`

English:
theorem ZMod.ringHom_eq_of_ker_eq
  statement: {n : Nat} {R : Type*} [Ring R] (f g : R ->+* ZMod n)
  proof: by
  have := f.liftOfRightInverse_comp _ (ZMod.ringHom_rightInverse f) ⟨g, le_of_eq h⟩
  rw [Subtype.coe_mk] at this
  rw [← this]; rw [RingHom.ext_zmod (f.liftOfRightInverse _ _ ⟨g]; rw [_⟩) _]; rw [RingHom.id_comp]

中文:
定理 ZMod.ringHom_eq_of_ker_eq
  结论: {n : 自然数} {R : 类型} [Ring R] (f g : R ->+* ZMod n)
  证明: by
  have := f.liftOfRightInverse_comp _ (ZMod.ringHom_rightInverse f) ⟨g, le_of_eq h⟩
  rw [Subtype.coe_mk] at this
  rw [← this]; rw [RingHom.ext_zmod (f.liftOfRightInverse _ _ ⟨g]; rw [_⟩) _]; rw [RingHom.id_comp]

Depends on / 依赖: RingHom, RingHom.ext_zmod, RingHom.id_comp, Subtype, Subtype.coe_mk, ZMod.ringHom_rightInverse, coe_mk, ext_zmod, f.liftOfRightInverse, f.liftOfRightInverse_comp, id_comp, le_of_eq, liftOfRightInverse, liftOfRightInverse_comp, ringHom_rightInverse
-/
theorem ZMod.ringHom_eq_of_ker_eq {n : Nat} {R : Type*} [Ring R] (f g : R ->+* ZMod n)
    (h : RingHom.ker f = RingHom.ker g) : f = g := by
  have := f.liftOfRightInverse_comp _ (ZMod.ringHom_rightInverse f) ⟨g, le_of_eq h⟩
  rw [Subtype.coe_mk] at this
  rw [← this]; rw [RingHom.ext_zmod (f.liftOfRightInverse _ _ ⟨g]; rw [_⟩) _]; rw [RingHom.id_comp]

/-- `ZMod n` is reduced iff `n` is square-free (or `n=0`). -/
@[simp]
/--
theorem `isReduced_zmod` / 定理 `isReduced_zmod`

English:
theorem isReduced_zmod
  given: {n : Nat}
  statement: IsReduced (ZMod n) ↔ Squarefree n ∨ n = 0
  proof: by
  rw [← RingHom.ker_isRadical_iff_reduced_of_surjective
      (ZMod.ringHom_surjective <| Int.castRingHom <| ZMod n)]; rw [ZMod.ker_intCastRingHom]; rw [← isRadical_iff_span_singleton]; rw [isRadical_iff_squarefree_or_zero]; rw [Int.squarefree_natCast]; rw [Nat.cast_eq_zero]

中文:
定理 isReduced_zmod
  条件: {n : 自然数}
  结论: IsReduced (ZMod n) ↔ Squarefree n ∨ n = 0
  证明: by
  rw [← RingHom.ker_isRadical_iff_reduced_of_surjective
      (ZMod.ringHom_surjective <| Int.castRingHom <| ZMod n)]; rw [ZMod.ker_intCastRingHom]; rw [← isRadical_iff_span_singleton]; rw [isRadical_iff_squarefree_or_zero]; rw [Int.squarefree_natCast]; rw [Nat.cast_eq_zero]

Depends on / 依赖: Int.castRingHom, Int.squarefree_natCast, Nat.cast_eq_zero, RingHom, RingHom.ker_isRadical_iff_reduced_of_surjective, ZMod.ker_intCastRingHom, ZMod.ringHom_surjective, castRingHom, cast_eq_zero, isRadical_iff_span_singleton, isRadical_iff_squarefree_or_zero, ker_intCastRingHom, ker_isRadical_iff_reduced_of_surjective, ringHom_surjective, squarefree_natCast
-/
theorem isReduced_zmod {n : Nat} : IsReduced (ZMod n) ↔ Squarefree n ∨ n = 0 := by
  rw [← RingHom.ker_isRadical_iff_reduced_of_surjective
      (ZMod.ringHom_surjective <| Int.castRingHom <| ZMod n)]; rw [ZMod.ker_intCastRingHom]; rw [← isRadical_iff_span_singleton]; rw [isRadical_iff_squarefree_or_zero]; rw [Int.squarefree_natCast]; rw [Nat.cast_eq_zero]

instance {n : Nat} [Fact <| Squarefree n] : IsReduced (ZMod n) :=
isReduced_zmod.2 Or.inl Fact.out
