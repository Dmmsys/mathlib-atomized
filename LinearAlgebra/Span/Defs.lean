odule R M) [self : S.…

--- 原说明 ---
`generator I`, if `I` is a principal submodule, is an `x ∈ M` such that `span R 
{x} = I`
-/
noncomputable def generator (S : Submodule R M) [S.IsPrincipal] : M :=
  Classical.choose (principal S)
/-
