instance TopCat.hasForgetToMeasCat
  signature: : HasForget₂ TopCat.{u} MeasCat.{u} where
  body: @MeasCat.of _ (borel X)
  forget₂.map f := ⟨f.1, f.hom.2.borel_measurable⟩

