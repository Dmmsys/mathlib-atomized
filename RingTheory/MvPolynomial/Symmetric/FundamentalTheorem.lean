  given: (hn : Fintype.card σ = n) (i : Fin n)
  proof: by
  apply_fun esymmAlgHom σ R n using esymmAlgHom_injective R hn.ge
  simp_rw [esymmAlgEquiv, AlgEquiv.ofBijective_apply_symm_apply, esymmAlgHom, aeval_X]

