      rw [← QuotientAddGroup.coe_mk']; rw [← AddMonoidHom.map_zmultiples]; rw [← ha]; rw [AddSubgroup.map_comap_eq_self_of_surjective]
      exact Quot.mk_surjective
    exact ⟨a, denseRange_zsmul_iff.not.mp h, rfl⟩

