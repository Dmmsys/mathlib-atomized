lemma esymmAlgEquiv_symm_apply (hn : Fintype.card σ = n) (i : Fin n) :
    (esymmAlgEquiv σ R hn).symm ⟨esymm σ R (i + 1), esymm_isSymmetric σ R _⟩ = X i := by
