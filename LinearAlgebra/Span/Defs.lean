variable (R) in
/--
Definition of `span` / `span` 的定义

English:
definition span
  signature: (s : Set M)
  body: sInf { p | s subseteq p }

中文:
定义 span
  签名: (s : 集合 M)
  定义体: sInf { p | s subseteq p }

Depends on / 依赖: subseteq
-/
def span (s : Set M) : Submodule R M :=
  sInf { p | s subseteq p }

/-- An `R`-submodule of `M` is principal if it is generated by one element. -/
@[mk_iff, wikidata Q44382]
/--
Definition of `IsPrincipal` / `IsPrincipal` 的定义

English:
class IsPrincipal
  parameters: (S : Submodule R M)
  axioms and operations (1):
    - principal((S)) : exists a, S = span R {a}

中文:
类 是Principal
  参数: (S : 子模 R M)
  公理与运算 (1 个):
    - principal((S)) : 存在 a, S = span R {a}
-/
class IsPrincipal (S : Submodule R M) : Prop where
  principal (S) : exists a, S = span R {a}

instance (x : R) : (span R {x}).IsPrincipal := ⟨x, rfl⟩

namespace IsPrincipal

/--
Definition of `generator` / `generator` 的定义

English:
definition generator
  signature: (S : Submodule R M) [S.IsPrincipal]
  body: Classical.choose (principal S)

中文:
定义 generator
  签名: (S : 子模 R M) [S.是Principal]
  定义体: Classical.choose (principal S)

Depends on / 依赖: Classical, Classical.choose, principal
-/
noncomputable def generator (S : Submodule R M) [S.IsPrincipal] : M :=
  Classical.choose (principal S)

