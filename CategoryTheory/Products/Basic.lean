-- Next we define the natural functors into and out of product categories. For now this doesn't
-- address the universal properties.
namespace Prod

/-- `sectL C Z` is the functor `C ⥤ C × D` given by `X ↦ (X, Z)`. -/
@[simps]
/--
Definition of `sectL` / `sectL` 的定义

English:
definition sectL
  signature: (C : Type u₁) [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] (Z : D)
  body: (X, Z)
  map f := f ×ₘ 𝟙 Z

中文:
定义 sectL
  签名: (C : 类型u₁) [范畴.{v₁} C] {D : 类型u₂} [范畴.{v₂} D] (Z : D)
  定义体: (X, Z)
  map f := f ×ₘ 𝟙 Z
-/
def sectL (C : Type u₁) [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] (Z : D) : C ⥤ C × D where
  obj X := (X, Z)
  map f := f ×ₘ 𝟙 Z

/-- `sectR Z D` is the functor `D ⥤ C × D` given by `Y ↦ (Z, Y)` . -/
@[simps]
/--
Definition of `sectR` / `sectR` 的定义

English:
definition sectR
  signature: {C : Type u₁} [Category.{v₁} C] (Z : C) (D : Type u₂) [Category.{v₂} D]
  body: (Z, X)
  map f := 𝟙 Z ×ₘ f

中文:
定义 sectR
  签名: {C : 类型u₁} [范畴.{v₁} C] (Z : C) (D : 类型u₂) [范畴.{v₂} D]
  定义体: (Z, X)
  map f := 𝟙 Z ×ₘ f
-/
def sectR {C : Type u₁} [Category.{v₁} C] (Z : C) (D : Type u₂) [Category.{v₂} D] : D ⥤ C × D where
  obj X := (Z, X)
  map f := 𝟙 Z ×ₘ f

variable (C : Type u₁) [Category.{v₁} C] (D : Type u₂) [Category.{v₂} D]

/-- `fst` is the functor `(X, Y) ↦ X`. -/
@[implicit_reducible, simps]
/--
Definition of `fst` / `fst` 的定义

English:
definition fst
  signature: : C × D ⥤ C where
  body: X.1
  map f := f.1

中文:
定义 fst
  签名: : C × D ⥤ C where
  定义体: X.1
  map f := f.1
-/
def fst : C × D ⥤ C where
  obj X := X.1
  map f := f.1

/-- `snd` is the functor `(X, Y) ↦ Y`. -/
@[implicit_reducible, simps]
/--
Definition of `snd` / `snd` 的定义

English:
definition snd
  signature: : C × D ⥤ D where
  body: X.2
  map f := f.2

中文:
定义 snd
  签名: : C × D ⥤ D where
  定义体: X.2
  map f := f.2
-/
def snd : C × D ⥤ D where
  obj X := X.2
  map f := f.2

/-- The functor swapping the factors of a Cartesian product of categories, `C × D ⥤ D × C`. -/
@[implicit_reducible, simps]
/--
Definition of `swap` / `swap` 的定义

English:
definition swap
  signature: : C × D ⥤ D × C where
  body: (X.2, X.1)
  map f := f.2 ×ₘ f.1

中文:
定义 swap
  签名: : C × D ⥤ D × C where
  定义体: (X.2, X.1)
  map f := f.2 ×ₘ f.1
-/
def swap : C × D ⥤ D × C where
  obj X := (X.2, X.1)
  map f := f.2 ×ₘ f.1

/-- Swapping the factors of a Cartesian product of categories twice is naturally isomorphic
to the identity functor.
-/
@[implicit_reducible, simps]
/--
Definition of `symmetry` / `symmetry` 的定义

English:
definition symmetry
  signature: : swap C D ⋙ swap D C ≅ 𝟭 (C × D) where
  body: { app := fun X => 𝟙 X }
  inv := { app := fun X => 𝟙 X }

中文:
定义 symmetry
  签名: : swap C D ⋙ swap D C ≅ 𝟭 (C × D) where
  定义体: { app := fun X => 𝟙 X }
  inv := { app := fun X => 𝟙 X }
-/
def symmetry : swap C D ⋙ swap D C ≅ 𝟭 (C × D) where
  hom := { app := fun X => 𝟙 X }
  inv := { app := fun X => 𝟙 X }

/-- The equivalence, given by swapping factors, between `C × D` and `D × C`.
-/
@[implicit_reducible, simps]
/--
Definition of `braiding` / `braiding` 的定义

English:
definition braiding
  signature: : C × D ≌ D × C where
  body: swap C D
  inverse := swap D C
  unitIso := Iso.refl _
  counitIso := Iso.refl _

中文:
定义 braiding
  签名: : C × D ≌ D × C where
  定义体: swap C D
  inverse := swap D C
  unitIso := Iso.refl _
  counitIso := Iso.refl _
-/
def braiding : C × D ≌ D × C where
  functor := swap C D
  inverse := swap D C
  unitIso := Iso.refl _
  counitIso := Iso.refl _

/--
Instance `swapIsEquivalence` / 实例 `swapIsEquivalence`

English:
instance swapIsEquivalence
  signature: : (swap C D).IsEquivalence
  body: (by infer_instance : (braiding C D).functor.IsEquivalence)

中文:
实例 swapIsEquivalence
  签名: : (swap C D).是等价
  定义体: (by infer_instance : (braiding C D).functor.IsEquivalence)

Depends on / 依赖: IsEquivalence, braiding, functor, functor.IsEquivalence, infer_instance
-/
instance swapIsEquivalence : (swap C D).IsEquivalence :=
  (by infer_instance : (braiding C D).functor.IsEquivalence)

