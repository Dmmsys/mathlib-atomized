variable {H : Type*} [Group H]

/-- The equivalence between functions on the generators and group homomorphisms from a free group
given by those generators. -/
@[to_additive
/-- The equivalence between functions on the generators and additive group homomorphisms from an
additive free group given by those generators. -/]
/--
Definition of `lift` / `lift` 的定义

English:
definition lift
  signature: : (Generators G -> H) ≃ (G ->* H)
  body: (basis G).lift

@[to_additive (attr := simp)]

中文:
定义 lift
  签名: : (生成元 G -> H) ≃ (G ->* H)
  定义体: (basis G).lift

@[to_additive (attr := simp)]
-/
def lift : (Generators G -> H) ≃ (G ->* H) :=
  (basis G).lift

@[to_additive (attr := simp)]
/--
theorem `lift_of` / 定理 `lift_of`

English:
theorem lift_of
  given: (f : Generators G -> H) (a : Generators G)
  statement: lift f (of a) = f a
  proof: congr_fun (lift.symm_apply_apply f) a

@[to_additive (attr := simp)]

中文:
定理 lift_of
  条件: (f : 生成元 G -> H) (a : 生成元 G)
  结论: lift f (of a) = f a
  证明: congr_fun (lift.symm_apply_apply f) a

@[to_additive (attr := simp)]

Depends on / 依赖: congr_fun, lift.symm_apply_apply, symm_apply_apply
-/
theorem lift_of (f : Generators G -> H) (a : Generators G) : lift f (of a) = f a :=
  congr_fun (lift.symm_apply_apply f) a

@[to_additive (attr := simp)]
/--
theorem `lift_symm_apply` / 定理 `lift_symm_apply`

English:
theorem lift_symm_apply
  given: (f : G ->* H) (a : Generators G)
  statement: (lift.symm f) a = f (of a)
  proof: rfl

中文:
定理 lift_symm_apply
  条件: (f : G ->* H) (a : 生成元 G)
  结论: (lift.symm f) a = f (of a)
  证明: rfl
-/
theorem lift_symm_apply (f : G ->* H) (a : Generators G) : (lift.symm f) a = f (of a) :=
  rfl

/- Do not register this as an ext lemma, as `Generators G` is not canonical. -/
@[to_additive /- Do not register this as an ext lemma, as `Generators G` is not canonical. -/]
/--
theorem `ext_hom` / 定理 `ext_hom`

English:
theorem ext_hom
  given: ⦃f g
  statement: G ->* H⦄ (h : forall a : Generators G, f (of a) = g (of a)) : f = g
  proof: lift.symm.injective (funext h)

中文:
定理 ext_hom
  条件: ⦃f g
  结论: G ->* H⦄ (h : 对任意 a : 生成元 G, f (of a) = g (of a)) : f = g
  证明: lift.symm.injective (funext h)

Depends on / 依赖: injective, lift.symm.injective
-/
theorem ext_hom ⦃f g : G ->* H⦄ (h : forall a : Generators G, f (of a) = g (of a)) : f = g :=
  lift.symm.injective (funext h)

/-- The universal property of a free group: A function from the generators of `G` to another
group extends in a unique way to a homomorphism from `G`.

Note that since `IsFreeGroup.lift` is expressed as a bijection, it already
expresses the universal property. -/
@[to_additive
/-- The universal property of an additive free group: A function from the generators of `G` to
another additive group extends in a unique way to a homomorphism from `G`.

Note that since `IsFreeAddGroup.lift` is expressed as a bijection, it already
expresses the universal property. -/]
/--
theorem `unique_lift` / 定理 `unique_lift`

English:
theorem unique_lift
  given: (f : Generators G -> H)
  statement: exists! F : G ->* H, forall a, F (of a) = f a
  proof: by
  simpa only [funext_iff] using! lift.symm.bijective.existsUnique f

中文:
定理 unique_lift
  条件: (f : 生成元 G -> H)
  结论: 存在! F : G ->* H, 对任意 a, F (of a) = f a
  证明: by
  simpa only [funext_iff] using! lift.symm.bijective.existsUnique f

Depends on / 依赖: bijective, existsUnique, funext_iff, lift.symm.bijective.existsUnique
-/
theorem unique_lift (f : Generators G -> H) : exists! F : G ->* H, forall a, F (of a) = f a := by
  simpa only [funext_iff] using! lift.symm.bijective.existsUnique f

/-- If a group satisfies the universal property of a free group with respect to a given type, then
it is free. Here, the universal property is expressed as in `IsFreeGroup.lift` and its
properties. -/
@[to_additive
/-- If an additive group satisfies the universal property of an additive free group with respect to
a given type, then it is free. Here, the universal property is expressed as in `IsFreeAddGroup.lift`
and its properties. -/]
/--
lemma `ofLift` / 引理 `ofLift`

English:
lemma ofLift
  statement: {G : Type u} [Group G] (X : Type u) (of : X -> G)
  proof: (FreeGroupBasis.ofLift X of lift lift_of).isFreeGroup

中文:
引理 ofLift
  结论: {G : 类型u} [群 G] (X : 类型u) (of : X -> G)
  证明: (FreeGroupBasis.ofLift X of lift lift_of).isFreeGroup

Depends on / 依赖: FreeGroupBasis, FreeGroupBasis.ofLift, isFreeGroup, lift_of, ofLift
-/
lemma ofLift {G : Type u} [Group G] (X : Type u) (of : X -> G)
    (lift : forall {H : Type u} [Group H], (X -> H) ≃ (G ->* H))
    (lift_of : forall {H : Type u} [Group H], forall (f : X -> H) (a), lift f (of a) = f a) :
    IsFreeGroup G :=
  (FreeGroupBasis.ofLift X of lift lift_of).isFreeGroup

/-- If a group satisfies the universal property of a free group with respect to a given type, then
it is free. Here the universal property is expressed as in `IsFreeGroup.unique_lift`. -/
@[to_additive
/-- If an additive group satisfies the universal property of an additive free group with respect to
a given type, then it is free. Here the universal property is expressed as in
`IsFreeAddGroup.unique_lift`. -/]
/--
lemma `ofUniqueLift` / 引理 `ofUniqueLift`

English:
lemma ofUniqueLift
  statement: {G : Type u} [Group G] (X : Type u) (of : X -> G)
  proof: (FreeGroupBasis.ofUniqueLift X of h).isFreeGroup

@[to_additive]

中文:
引理 ofUniqueLift
  结论: {G : 类型u} [群 G] (X : 类型u) (of : X -> G)
  证明: (FreeGroupBasis.ofUniqueLift X of h).isFreeGroup

@[to_additive]

Depends on / 依赖: FreeGroupBasis, FreeGroupBasis.ofUniqueLift, isFreeGroup, ofUniqueLift
-/
lemma ofUniqueLift {G : Type u} [Group G] (X : Type u) (of : X -> G)
    (h : forall {H : Type u} [Group H] (f : X -> H), exists! F : G ->* H, forall a, F (of a) = f a) :
    IsFreeGroup G :=
  (FreeGroupBasis.ofUniqueLift X of h).isFreeGroup

