中文:
定义 Preorder.ofStd
  签名: (α : 类型) (args : OfStdArgs α := by exact {})
  定义体: args.le
  toLT := args.lt
  le_refl := args.isPreorder.le_refl
  le_trans := args.isPreorder.le_trans
