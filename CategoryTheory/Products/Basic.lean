  签名: : (C × D)ᵒᵖ ≌ Cᵒᵖ × Dᵒᵖ where
  定义体: { obj := fun X => ⟨op X.unop.1, op X.unop.2⟩,
      map := fun f => f.unop.1.op ×ₘ f.unop.2.op }
  inverse :=
    { obj := fun ⟨X,Y⟩ => op ⟨X.unop, Y.unop⟩,
      map := fun ⟨f,g⟩ => op (f.unop ×ₘ g.unop) }
  unitIso := Iso.refl _
