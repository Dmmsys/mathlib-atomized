lemma `toGrothendieck_eq_sInf` / 引理 `toGrothendieck_eq_sInf`

English:
lemma toGrothendieck_eq_sInf
  given: (J : Precoverage C)
  proof: by
  refine le_antisymm ?_ ?_
  · rw [le_sInf_iff]
    intro K hK _ _ hS
    induction hS with
    | of _ _ hS => exact hK _ hS
    | top => exact K.top_mem _
    | pullback _ _ _ _ _ ih => exact K.pullback_stable _ ih
    | transitive _ _ _ _ _ ih1 ih2 => exact K.transitive ih1 _ ih2
  · exact sInf

