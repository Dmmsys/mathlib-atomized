/--
theorem `mem_span_singleton_sup` / 定理 `mem_span_singleton_sup`

English:
theorem mem_span_singleton_sup
  given: {x y : α} {I : Ideal α}
  proof: by
  rw [Submodule.mem_sup]
  constructor
  · rintro ⟨ya, hya, b, hb, rfl⟩
    obtain ⟨a, rfl⟩ := mem_span_singleton'.mp hya
    exact ⟨a, b, hb, rfl⟩
  · rintro ⟨a, b, hb, rfl⟩
    exact ⟨a * y, Ideal.mem_span_singleton'.mpr ⟨a, rfl⟩, b, hb, rfl⟩

中文:
定理 mem_span_singleton_sup
  条件: {x y : α} {I : Ideal α}
  证明: by
  rw [Submodule.mem_sup]
  constructor
  · rintro ⟨ya, hya, b, hb, rfl⟩
    obtain ⟨a, rfl⟩ := mem_span_singleton'.mp hya
    exact ⟨a, b, hb, rfl⟩
  · rintro ⟨a, b, hb, rfl⟩
    exact ⟨a * y, Ideal.mem_span_singleton'.mpr ⟨a, rfl⟩, b, hb, rfl⟩

Depends on / 依赖: Ideal.mem_span_singleton, Submodule, Submodule.mem_sup, mem_span_singleton, mem_sup
-/
theorem mem_span_singleton_sup {x y : α} {I : Ideal α} :
    x in Ideal.span {y} ⊔ I ↔ exists a : α, exists b in I, a * y + b = x := by
  rw [Submodule.mem_sup]
  constructor
  · rintro ⟨ya, hya, b, hb, rfl⟩
    obtain ⟨a, rfl⟩ := mem_span_singleton'.mp hya
    exact ⟨a, b, hb, rfl⟩
  · rintro ⟨a, b, hb, rfl⟩
    exact ⟨a * y, Ideal.mem_span_singleton'.mpr ⟨a, rfl⟩, b, hb, rfl⟩

