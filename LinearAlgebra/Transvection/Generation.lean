English:
definition auxTransvection
  signature: {f : Dual K V} {u : V}
  body: transvection (f := f) (v := u - e u) (by
    simp only [← LinearMap.mem_ker]
    apply hf
    apply Submodule.mem_sup_right
    rw [mem_span_singleton]
    exact ⟨-1, by simp⟩)

