  SubMulAction.closure_le

@[to_additive (attr := gcongr)]
/--
theorem `closure_mono` / 定理 `closure_mono`

English:
theorem closure_mono
  given: (h : s subseteq t)
  statement: closure s <= closure t
  proof: SubMulAction.closure_mono h

中文:
定理 closure_mono
  条件: (h : s subseteq t)
  结论: closure s <= closure t
  证明: SubMulAction.closure_mono h

Depends on / 依赖: SubMulAction, SubMulAction.closure_mono, closure_mono
-/
theorem closure_mono (h : s subseteq t) : closure s <= closure t :=
  SubMulAction.closure_mono h

end Mul

/-- The semigroup ideal generated by `s` is `s ∪ Set.univ * s`. -/
@[to_additive /-- The additive semigroup ideal generated by `s` is `s ∪ Set.univ + s`. -/]
/--
theorem `coe_closure` / 定理 `coe_closure`

English:
theorem coe_closure
  given: [Semigroup M] {s : Set M}
  proof: by
  let I : SemigroupIdeal M :=
    { carrier := s union univ * s
      smul_mem' x y := by
        rintro (hy | ⟨y, -, z, hz, rfl⟩)
· exact .inr mul_mem_mul (mem_univ _) hy
· simpa [← mul_assoc] using .inr mul_mem_mul (mem_univ _) hz }
  suffices closure s = I by rw [this]; rfl
  refine (closure_l

中文:
定理 coe_closure
  条件: [Semigroup M] {s : Set M}
  证明: by
  let I : SemigroupIdeal M :=
    { carrier := s union univ * s
      smul_mem' x y := by
        rintro (hy | ⟨y, -, z, hz, rfl⟩)
· exact .inr mul_mem_mul (mem_univ _) hy
· simpa [← mul_assoc] using .inr mul_mem_mul (mem_univ _) hz }
  suffices closure s = I by rw [this]; rfl
  refine (closure_l

Depends on / 依赖: Or.inl, SemigroupIdeal, SemigroupIdeal.mul_mem, antisymm, carrier, closure, closure_le, hx.elim, mem_closure_of_mem, mem_univ, mul_assoc, mul_mem, mul_mem_mul, smul_mem
-/
theorem coe_closure [Semigroup M] {s : Set M} :
    (closure s : Set M) = s union univ * s := by
  let I : SemigroupIdeal M :=
    { carrier := s union univ * s
      smul_mem' x y := by
        rintro (hy | ⟨y, -, z, hz, rfl⟩)
· exact .inr mul_mem_mul (mem_univ _) hy
· simpa [← mul_assoc] using .inr mul_mem_mul (mem_univ _) hz }
  suffices closure s = I by rw [this]; rfl
  refine (closure_le.2 fun x => Or.inl).antisymm fun x hx => hx.elim mem_closure_of_mem ?_
  rintro ⟨y, -, z, hz, rfl⟩
  exact SemigroupIdeal.mul_mem _ _ (mem_closure_of_mem hz)

@[to_additive, inherit_doc coe_closure]
/--
theorem `mem_closure'` / 定理 `mem_closure'`

English:
theorem mem_closure'
  given: [Semigroup M] {s : Set M} {x : M}
  proof: by
  rw [← SetLike.mem_coe]; rw [coe_closure]
  simp [mem_mul]

中文:
定理 mem_closure'
  条件: [Semigroup M] {s : Set M} {x : M}
  证明: by
  rw [← SetLike.mem_coe]; rw [coe_closure]
  simp [mem_mul]

Depends on / 依赖: SetLike, SetLike.mem_coe, coe_closure, mem_coe, mem_mul
-/
theorem mem_closure' [Semigroup M] {s : Set M} {x : M} :
    x in closure s ↔ x in s ∨ exists y, exists z in s, y * z = x := by
  rw [← SetLike.mem_coe]; rw [coe_closure]
  simp [mem_mul]

attribute [inherit_doc AddSemigroupIdeal.coe_closure] AddSemigroupIdeal.mem_closure'

/-- In a monoid, the semigroup ideal generated by `s` is `Set.univ * s`. -/
@[to_additive /-- In an additive monoid, the semigroup ideal generated by `s` is `Set.univ + s`. -/]
/--
theorem `coe_closure'` / 定理 `coe_closure'`

English:
theorem coe_closure'
  given: [Monoid M] {s : Set M}
  proof: by
  rw [coe_closure]; rw [union_eq_right]
  exact fun x hx => ⟨1, mem_univ 1, x, hx, by simp⟩

@[to_additive, inherit_doc coe_closure']

中文:
定理 coe_closure'
  条件: [Monoid M] {s : Set M}
  证明: by
  rw [coe_closure]; rw [union_eq_right]
  exact fun x hx => ⟨1, mem_univ 1, x, hx, by simp⟩

@[to_additive, inherit_doc coe_closure']

Depends on / 依赖: coe_closure, mem_univ, union_eq_right
-/
theorem coe_closure' [Monoid M] {s : Set M} :
    (closure s : Set M) = univ * s := by
  rw [coe_closure]; rw [union_eq_right]
  exact fun x hx => ⟨1, mem_univ 1, x, hx, by simp⟩

@[to_additive, inherit_doc coe_closure']
/--
theorem `mem_closure''` / 定理 `mem_closure''`

English:
theorem mem_closure''
  given: [Monoid M] {s : Set M} {x : M}
  proof: by
  rw [← SetLike.mem_coe]; rw [coe_closure']
  simp [mem_mul]

中文:
定理 mem_closure''
  条件: [Monoid M] {s : Set M} {x : M}
  证明: by
  rw [← SetLike.mem_coe]; rw [coe_closure']
  simp [mem_mul]

Depends on / 依赖: SetLike, SetLike.mem_coe, coe_closure, mem_coe, mem_mul
-/
theorem mem_closure'' [Monoid M] {s : Set M} {x : M} :
    x in closure s ↔ exists y, exists z in s, y * z = x := by
  rw [← SetLike.mem_coe]; rw [coe_closure']
  simp [mem_mul]

attribute [inherit_doc AddSemigroupIdeal.coe_closure'] AddSemigroupIdeal.mem_closure''

/-- A semigroup ideal is finitely generated if it is generated by a finite set.

This is defeq to `SubMulAction.FG`, but unfolds more nicely. -/
@[to_additive /-- An additive semigroup ideal is finitely generated if it is generated by a finite
set.

This is defeq to `SubAddAction.FG`, but unfolds more nicely. -/]
/--
Definition of `FG` / `FG` 的定义

English:
definition FG
  signature: [Mul M] (I : SemigroupIdeal M)
  body: exists (s : Set M), s.Finite ∧ I = closure s

@[to_additive]

中文:
定义 FG
  签名: [Mul M] (I : SemigroupIdeal M)
  定义体: exists (s : Set M), s.Finite ∧ I = closure s

@[to_additive]

Depends on / 依赖: Finite, closure, s.Finite
-/
def FG [Mul M] (I : SemigroupIdeal M) :=
  exists (s : Set M), s.Finite ∧ I = closure s

