/-!
# An affine monoid with no non-trivial unit is generated by its irreducible elements

This file proves that an additive cancellative monoid with no non-trivial unit unit is generated by
its irreducible elements.
-/

public section

variable {M : Type*}

section CommMonoid
variable [CommMonoid M] [Subsingleton Mˣ] {S : Set M}

/-- Any set `S` inside a monoid with a single unit contains the irreducible elements of the
submonoid it generates. -/
@[to_additive /-- Any set `S` inside an additive monoid with a single unit contains the irreducible
elements of the submonoid it generates. -/]
