类 IsGeneratedBy
  参数: : 命题 where
  公理与运算 (1 个):
    - continuous_equiv_symm : Continuous (WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm
-/
class IsGeneratedBy : Prop where
  continuous_equiv_symm : Continuous (WithGeneratedByTopology.equiv (X := X) (Y := Y)).symm

namespace IsGeneratedBy

attribute [continuity, fun_prop] continuous_equiv_symm

