    [OrderTopology β] {f : α -> β} (hf : forall {x y}, f x < f y ↔ x < y)
    (H₁ : forall {a b x}, b < f a -> ¬(b < f x) -> exists y, y < a ∧ b <= f y)
    (H₂ : forall {a b x}, f a < b -> ¬(f x < b) -> exists y, a < y ∧ f y <= b) :
    induced f ‹TopologicalSpace β› = Preorder.topology α := by
