@[to_dual]
/--
theorem `Ioi_mem_atTop` / 定理 `Ioi_mem_atTop`

English:
theorem Ioi_mem_atTop
  given: [Preorder α] [NoTopOrder α] (x : α)
  statement: Ioi x in (atTop : Filter α)
  proof: let ⟨z, hz⟩ := exists_not_le x
  mem_of_superset (inter_mem (mem_atTop x) (mem_atTop z))
    fun _ ⟨hxy, hzy⟩ => lt_of_le_not_ge hxy fun hyx => hz (hzy.trans hyx)

@[to_dual eventually_le_atBot]

中文:
定理 Ioi_mem_atTop
  条件: [预序 α] [无顶序 α] (x : α)
  结论: 左开右无界区间 x in (atTop : 滤子 α)
  证明: let ⟨z, hz⟩ := exists_not_le x
  mem_of_superset (inter_mem (mem_atTop x) (mem_atTop z))
    fun _ ⟨hxy, hzy⟩ => lt_of_le_not_ge hxy fun hyx => hz (hzy.trans hyx)

@[to_dual eventually_le_atBot]

Depends on / 依赖: exists_not_le, hzy.trans, inter_mem, lt_of_le_not_ge, mem_atTop, mem_of_superset
-/
theorem Ioi_mem_atTop [Preorder α] [NoTopOrder α] (x : α) : Ioi x in (atTop : Filter α) :=
  let ⟨z, hz⟩ := exists_not_le x
  mem_of_superset (inter_mem (mem_atTop x) (mem_atTop z))
    fun _ ⟨hxy, hzy⟩ => lt_of_le_not_ge hxy fun hyx => hz (hzy.trans hyx)

