lemma `mem_toGrothendieck_iff_of_isStableUnderComposition` / 引理 `mem_toGrothendieck_iff_of_isStableUnderComposition`

English:
lemma mem_toGrothendieck_iff_of_isStableUnderComposition
  statement: [IsStableUnderComposition J]
  proof: by
  refine ⟨fun hS => ?_, fun ⟨R, hR, hle⟩ => ?_⟩
  · induction hS with
    | of X R hR =>
      use R, hR
      exact Sieve.le_generate R
    | top X =>
      exact ⟨Presieve.singleton (𝟙 X), mem_coverings_of_isIso (𝟙 X), by simp⟩
    | pullback X S hS Y f h =>
      obtain ⟨R, hR, hle⟩ := h
     

