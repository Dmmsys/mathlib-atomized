module

public import Mathlib.Topology.Sheaves.SheafCondition.Sites

/-!
# Another version of the sheaf condition.

Given a family of open sets `U : ι → Opens X` we can form the subcategory
`{ V : Opens X // ∃ i, V ≤ U i }`, which has `iSup U` as a cocone.

The sheaf condition on a presheaf `F` is equivalent to
`F` sending the opposite of this cocone to a limit cone in `C`, for every `U`.

This condition is particularly nice when checking the sheaf condition
because we don't need to do any case bashing
(depending on whether we're looking at single or double intersections,
or equivalently whether we're looking at the first or second object in an equalizer diagram).

## Main statement

`TopCat.Presheaf.isSheaf_iff_isSheafOpensLeCover`: for a presheaf on a topological space,
the sheaf condition in terms of Grothendieck topology is equivalent to the `OpensLeCover`
sheaf condition. This result will be used to further connect to other sheaf conditions on spaces,
like `pairwise_intersections` and `equalizer_products`.

## References
* This is the definition Lurie uses in [Spectral Algebraic Geometry][LurieSAG].
-/

@[expose] public section


universe w

noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace TopologicalSpace.Opens Opposite

namespace TopCat

variable {C : Type*} [Category* C]
variable {X : TopCat.{w}} (F : Presheaf C X) {ι : Type*} (U : ι -> Opens X)

namespace Presheaf

namespace SheafCondition

/--
Definition of `OpensLeCover` / `OpensLeCover` 的定义

English:
definition OpensLeCover
  signature: : Type w
  body: ObjectProperty.FullSubcategory fun V : Opens X => exists i, V <= U i
deriving Category

中文:
定义 OpensLeCover
  签名: : 类型 w
  定义体: ObjectProperty.FullSubcategory fun V : Opens X => exists i, V <= U i
deriving Category

Depends on / 依赖: FullSubcategory, ObjectProperty, ObjectProperty.FullSubcategory
-/
def OpensLeCover : Type w :=
  ObjectProperty.FullSubcategory fun V : Opens X => exists i, V <= U i
deriving Category

/--
Instance `_anonymous_` / 实例 `_anonymous_`

English:
instance [h
  signature: : Nonempty ι] : Inhabited (OpensLeCover U)
  body: ⟨⟨⊥, let ⟨i⟩ := h; ⟨i, bot_le⟩⟩⟩

中文:
实例 [h
  签名: : 非空 ι] : 可居 (OpensLeCover U)
  定义体: ⟨⟨⊥, let ⟨i⟩ := h; ⟨i, bot_le⟩⟩⟩

Depends on / 依赖: bot_le
-/
instance [h : Nonempty ι] : Inhabited (OpensLeCover U) :=
  ⟨⟨⊥, let ⟨i⟩ := h; ⟨i, bot_le⟩⟩⟩

namespace OpensLeCover

variable {U}

/--
Definition of `index` / `index` 的定义

English:
definition index
  signature: (V : OpensLeCover U)
  body: V.property.choose

中文:
定义 index
  签名: (V : OpensLeCover U)
  定义体: V.property.choose

Depends on / 依赖: V.property.choose, property
-/
def index (V : OpensLeCover U) : ι :=
  V.property.choose

/--
Definition of `homToIndex` / `homToIndex` 的定义

English:
definition homToIndex
  signature: (V : OpensLeCover U)
  body: V.property.choose_spec.hom

中文:
定义 homToIndex
  签名: (V : OpensLeCover U)
  定义体: V.property.choose_spec.hom

Depends on / 依赖: V.property.choose_spec.hom, choose_spec, property
-/
def homToIndex (V : OpensLeCover U) : V.obj ⟶ U (index V) :=
  V.property.choose_spec.hom

end OpensLeCover

/--
Definition of `opensLeCoverCocone` / `opensLeCoverCocone` 的定义

English:
definition opensLeCoverCocone
  signature: : Cocone (ObjectProperty.ι _ : OpensLeCover U ⥤ Opens X) where
  body: iSup U
  ι := { app := fun V : OpensLeCover U => V.homToIndex ≫ Opens.leSupr U _ }

中文:
定义 opensLeCoverCocone
  签名: : 余锥 (ObjectProperty.ι _ : OpensLeCover U ⥤ Opens X) where
  定义体: iSup U
  ι := { app := fun V : OpensLeCover U => V.homToIndex ≫ Opens.leSupr U _ }
-/
def opensLeCoverCocone : Cocone (ObjectProperty.ι _ : OpensLeCover U ⥤ Opens X) where
  pt := iSup U
  ι := { app := fun V : OpensLeCover U => V.homToIndex ≫ Opens.leSupr U _ }

end SheafCondition

open SheafCondition

/--
Definition of `IsSheafOpensLeCover` / `IsSheafOpensLeCover` 的定义

English:
definition IsSheafOpensLeCover
  signature: : Prop
  body: forall ⦃ι : Type w⦄ (U : ι -> Opens X), Nonempty (IsLimit (F.mapCone (opensLeCoverCocone U).op))

中文:
定义 IsSheafOpensLeCover
  签名: : 命题
  定义体: forall ⦃ι : Type w⦄ (U : ι -> Opens X), Nonempty (IsLimit (F.mapCone (opensLeCoverCocone U).op))

Depends on / 依赖: F.mapCone, IsLimit, Nonempty, mapCone, opensLeCoverCocone
-/
def IsSheafOpensLeCover : Prop :=
  forall ⦃ι : Type w⦄ (U : ι -> Opens X), Nonempty (IsLimit (F.mapCone (opensLeCoverCocone U).op))

section

variable {Y : Opens X}

/-- Given a family of opens `U` and an open `Y` equal to the union of opens in `U`, we may
take the presieve on `Y` associated to `U` and the sieve generated by it, and form the
full subcategory (subposet) of opens contained in `Y` (`over Y`) consisting of arrows
in the sieve. This full subcategory is equivalent to `OpensLeCover U`, the (poset)
category of opens contained in some `U i`. -/
@[simps]
/--
Definition of `generateEquivalenceOpensLe_functor'` / `generateEquivalenceOpensLe_functor'` 的定义

English:
definition generateEquivalenceOpensLe_functor'
  signature: :
  body: ⟨f.1.left,
      let ⟨_, h, _, ⟨i, hY⟩, _⟩ := f.2
      ⟨i, hY ▸ h.le⟩⟩
  map g := ObjectProperty.homMk g.hom.left

中文:
定义 generateEquivalenceOpensLe_functor'
  签名: :
  定义体: ⟨f.1.left,
      let ⟨_, h, _, ⟨i, hY⟩, _⟩ := f.2
      ⟨i, hY ▸ h.le⟩⟩
  map g := ObjectProperty.homMk g.hom.left

Depends on / 依赖: ObjectProperty, ObjectProperty.homMk, g.hom.left, h.le
-/
def generateEquivalenceOpensLe_functor' :
    (ObjectProperty.FullSubcategory
      fun f : Over Y => (Sieve.generate (presieveOfCoveringAux U Y)).arrows f.hom) ⥤
    OpensLeCover U where
  obj f :=
    ⟨f.1.left,
      let ⟨_, h, _, ⟨i, hY⟩, _⟩ := f.2
      ⟨i, hY ▸ h.le⟩⟩
  map g := ObjectProperty.homMk g.hom.left

/-- Given a family of opens `U` and an open `Y` equal to the union of opens in `U`, we may
take the presieve on `Y` associated to `U` and the sieve generated by it, and form the
full subcategory (subposet) of opens contained in `Y` (`over Y`) consisting of arrows
in the sieve. This full subcategory is equivalent to `OpensLeCover U`, the (poset)
category of opens contained in some `U i`. -/
@[simps]
/--
Definition of `generateEquivalenceOpensLe_inverse'` / `generateEquivalenceOpensLe_inverse'` 的定义

English:
definition generateEquivalenceOpensLe_inverse'
  signature: (hY : Y = iSup U)
  body: fun V => ⟨⟨V.obj, ⟨⟨⟩⟩, homOfLE hY ▸ (V.2.choose_spec.trans (le_iSup U (V.2.choose)))⟩,
⟨U V.2.choose, V.2.choose_spec.hom, homOfLE hY ▸ le_iSup U V.2.choose,
      ⟨V.2.choose, rfl⟩, rfl⟩⟩
  map g := ObjectProperty.homMk (Over.homMk g.hom)

中文:
定义 generateEquivalenceOpensLe_inverse'
  签名: (hY : Y = iSup U)
  定义体: fun V => ⟨⟨V.obj, ⟨⟨⟩⟩, homOfLE hY ▸ (V.2.choose_spec.trans (le_iSup U (V.2.choose)))⟩,
⟨U V.2.choose, V.2.choose_spec.hom, homOfLE hY ▸ le_iSup U V.2.choose,
      ⟨V.2.choose, rfl⟩, rfl⟩⟩
  map g := ObjectProperty.homMk (Over.homMk g.hom)

Depends on / 依赖: V.obj, choose_spec, choose_spec.trans, homOfLE, le_iSup
-/
def generateEquivalenceOpensLe_inverse' (hY : Y = iSup U) :
    OpensLeCover U ⥤
    (ObjectProperty.FullSubcategory fun f : Over Y =>
      (Sieve.generate (presieveOfCoveringAux U Y)).arrows f.hom) where
obj := fun V => ⟨⟨V.obj, ⟨⟨⟩⟩, homOfLE hY ▸ (V.2.choose_spec.trans (le_iSup U (V.2.choose)))⟩,
⟨U V.2.choose, V.2.choose_spec.hom, homOfLE hY ▸ le_iSup U V.2.choose,
      ⟨V.2.choose, rfl⟩, rfl⟩⟩
  map g := ObjectProperty.homMk (Over.homMk g.hom)

/-- Given a family of opens `U` and an open `Y` equal to the union of opens in `U`, we may
take the presieve on `Y` associated to `U` and the sieve generated by it, and form the
full subcategory (subposet) of opens contained in `Y` (`over Y`) consisting of arrows
in the sieve. This full subcategory is equivalent to `OpensLeCover U`, the (poset)
category of opens contained in some `U i`. -/
@[simps]
/--
Definition of `generateEquivalenceOpensLe` / `generateEquivalenceOpensLe` 的定义

English:
definition generateEquivalenceOpensLe
  signature: (hY : Y = iSup U)
  body: generateEquivalenceOpensLe_functor' _
  inverse := generateEquivalenceOpensLe_inverse' _ hY
unitIso := eqToIso CategoryTheory.Functor.ext (by cat_disch)
counitIso := eqToIso CategoryTheory.Functor.ext (by cat_disch)

中文:
定义 generateEquivalenceOpensLe
  签名: (hY : Y = iSup U)
  定义体: generateEquivalenceOpensLe_functor' _
  inverse := generateEquivalenceOpensLe_inverse' _ hY
unitIso := eqToIso CategoryTheory.Functor.ext (by cat_disch)
counitIso := eqToIso CategoryTheory.Functor.ext (by cat_disch)

Depends on / 依赖: generateEquivalenceOpensLe_functor
-/
def generateEquivalenceOpensLe (hY : Y = iSup U) :
    (ObjectProperty.FullSubcategory
      fun f : Over Y => (Sieve.generate (presieveOfCoveringAux U Y)).arrows f.hom) ≌
    OpensLeCover U where
  functor := generateEquivalenceOpensLe_functor' _
  inverse := generateEquivalenceOpensLe_inverse' _ hY
unitIso := eqToIso CategoryTheory.Functor.ext (by cat_disch)
counitIso := eqToIso CategoryTheory.Functor.ext (by cat_disch)

set_option backward.defeqAttrib.useBackward true in
set_option backward.isDefEq.respectTransparency false in
/-- Given a family of opens `opensLeCoverCocone U` is essentially the natural cocone
associated to the sieve generated by the presieve associated to `U` with indexing
category changed using the above equivalence. -/
@[simps]
/--
Definition of `whiskerIsoMapGenerateCocone` / `whiskerIsoMapGenerateCocone` 的定义

English:
definition whiskerIsoMapGenerateCocone
  signature: (hY : Y = iSup U)
  body: { hom := F.map (eqToHom (congr_arg op hY.symm))
      w := fun j => by
        dsimp
        rw [← F.map_comp]
        congr 1 }
  inv :=
    { hom := F.map (eqToHom (congr_arg op hY))
      w := fun j => by
        dsimp
        rw [← F.map_comp]
        congr 1 }
  hom_inv_id := by
    ext
    simp [eqToHom_map]
  inv_hom_id := by
    ext
    simp [eqToHom_map]

中文:
定义 whiskerIsoMapGenerateCocone
  签名: (hY : Y = iSup U)
  定义体: { hom := F.map (eqToHom (congr_arg op hY.symm))
      w := fun j => by
        dsimp
        rw [← F.map_comp]
        congr 1 }
  inv :=
    { hom := F.map (eqToHom (congr_arg op hY))
      w := fun j => by
        dsimp
        rw [← F.map_comp]
        congr 1 }
  hom_inv_id := by
    ext
    simp [eqToHom_map]
  inv_hom_id := by
    ext
    simp [eqToHom_map]

Depends on / 依赖: F.map, F.map_comp, congr_arg, eqToHom, eqToHom_map, hY.symm, hom_inv_id, inv_hom_id, map_comp
-/
def whiskerIsoMapGenerateCocone (hY : Y = iSup U) :
    (F.mapCone (opensLeCoverCocone U).op).whisker (generateEquivalenceOpensLe U hY).op.functor ≅
      F.mapCone (Sieve.generate (presieveOfCoveringAux U Y)).arrows.cocone.op where
  hom :=
    { hom := F.map (eqToHom (congr_arg op hY.symm))
      w := fun j => by
        dsimp
        rw [← F.map_comp]
        congr 1 }
  inv :=
    { hom := F.map (eqToHom (congr_arg op hY))
      w := fun j => by
        dsimp
        rw [← F.map_comp]
        congr 1 }
  hom_inv_id := by
    ext
    simp [eqToHom_map]
  inv_hom_id := by
    ext
    simp [eqToHom_map]

/--
Definition of `isLimitOpensLeEquivGenerate₁` / `isLimitOpensLeEquivGenerate₁` 的定义

English:
definition isLimitOpensLeEquivGenerate₁
  signature: (hY : Y = iSup U)
  body: (IsLimit.whiskerEquivalenceEquiv (generateEquivalenceOpensLe U hY).op).trans
    (IsLimit.equivIsoLimit (whiskerIsoMapGenerateCocone F U hY))

中文:
定义 isLimitOpensLeEquivGenerate₁
  签名: (hY : Y = iSup U)
  定义体: (IsLimit.whiskerEquivalenceEquiv (generateEquivalenceOpensLe U hY).op).trans
    (IsLimit.equivIsoLimit (whiskerIsoMapGenerateCocone F U hY))

Depends on / 依赖: IsLimit, IsLimit.equivIsoLimit, IsLimit.whiskerEquivalenceEquiv, equivIsoLimit, generateEquivalenceOpensLe, whiskerEquivalenceEquiv, whiskerIsoMapGenerateCocone
-/
def isLimitOpensLeEquivGenerate₁ (hY : Y = iSup U) :
    IsLimit (F.mapCone (opensLeCoverCocone U).op) ≃
      IsLimit (F.mapCone (Sieve.generate (presieveOfCoveringAux U Y)).arrows.cocone.op) :=
  (IsLimit.whiskerEquivalenceEquiv (generateEquivalenceOpensLe U hY).op).trans
    (IsLimit.equivIsoLimit (whiskerIsoMapGenerateCocone F U hY))

/--
Definition of `isLimitOpensLeEquivGenerate₂` / `isLimitOpensLeEquivGenerate₂` 的定义

English:
definition isLimitOpensLeEquivGenerate₂
  signature: (R : Presieve Y)
  body: by
  convert!
    isLimitOpensLeEquivGenerate₁ F (coveringOfPresieve Y R)
      (coveringOfPresieve.iSup_eq_of_mem_grothendieck Y R hR).symm using 1
  rw [covering_presieve_eq_self R]

中文:
定义 isLimitOpensLeEquivGenerate₂
  签名: (R : Presieve Y)
  定义体: by
  convert!
    isLimitOpensLeEquivGenerate₁ F (coveringOfPresieve Y R)
      (coveringOfPresieve.iSup_eq_of_mem_grothendieck Y R hR).symm using 1
  rw [covering_presieve_eq_self R]

Depends on / 依赖: convert, coveringOfPresieve, coveringOfPresieve.iSup_eq_of_mem_grothendieck, covering_presieve_eq_self, iSup_eq_of_mem_grothendieck
-/
def isLimitOpensLeEquivGenerate₂ (R : Presieve Y)
    (hR : Sieve.generate R in Opens.grothendieckTopology X Y) :
    IsLimit (F.mapCone (opensLeCoverCocone (coveringOfPresieve Y R)).op) ≃
      IsLimit (F.mapCone (Sieve.generate R).arrows.cocone.op) := by
  convert!
    isLimitOpensLeEquivGenerate₁ F (coveringOfPresieve Y R)
      (coveringOfPresieve.iSup_eq_of_mem_grothendieck Y R hR).symm using 1
  rw [covering_presieve_eq_self R]

variable {F} in
/--
theorem `IsSheaf.isSheafOpensLeCover` / 定理 `IsSheaf.isSheafOpensLeCover`

English:
theorem IsSheaf.isSheafOpensLeCover
  given: (h : F.IsSheaf)
  proof: by
  rw [(isLimitOpensLeEquivGenerate₁ F U rfl).nonempty_congr]
  apply (Presheaf.isSheaf_iff_isLimit _ _).mp h
  apply presieveOfCovering.mem_grothendieckTopology

中文:
定理 是层.isSheafOpensLeCover
  条件: (h : F.是层)
  证明: by
  rw [(isLimitOpensLeEquivGenerate₁ F U rfl).nonempty_congr]
  apply (Presheaf.isSheaf_iff_isLimit _ _).mp h
  apply presieveOfCovering.mem_grothendieckTopology

Depends on / 依赖: Presheaf, Presheaf.isSheaf_iff_isLimit, isSheaf_iff_isLimit, mem_grothendieckTopology, nonempty_congr, presieveOfCovering, presieveOfCovering.mem_grothendieckTopology
-/
theorem IsSheaf.isSheafOpensLeCover (h : F.IsSheaf) :
    Nonempty (IsLimit (F.mapCone (opensLeCoverCocone U).op)) := by
  rw [(isLimitOpensLeEquivGenerate₁ F U rfl).nonempty_congr]
  apply (Presheaf.isSheaf_iff_isLimit _ _).mp h
  apply presieveOfCovering.mem_grothendieckTopology

/--
theorem `isSheaf_iff_isSheafOpensLeCover` / 定理 `isSheaf_iff_isSheafOpensLeCover`

English:
theorem isSheaf_iff_isSheafOpensLeCover
  statement: F.IsSheaf ↔ F.IsSheafOpensLeCover
  proof: by
  refine ⟨fun h _ => h.isSheafOpensLeCover,
    fun h => (Presheaf.isSheaf_iff_isLimit _ _).mpr fun Y S => ?_⟩
  rw [← Sieve.generate_sieve S]
  intro hS
  rw [← (isLimitOpensLeEquivGenerate₂ F S.1 hS).nonempty_congr]
  apply h

中文:
定理 isSheaf_iff_isSheafOpensLeCover
  结论: F.是层 ↔ F.IsSheafOpensLeCover
  证明: by
  refine ⟨fun h _ => h.isSheafOpensLeCover,
    fun h => (Presheaf.isSheaf_iff_isLimit _ _).mpr fun Y S => ?_⟩
  rw [← Sieve.generate_sieve S]
  intro hS
  rw [← (isLimitOpensLeEquivGenerate₂ F S.1 hS).nonempty_congr]
  apply h

Depends on / 依赖: Presheaf, Presheaf.isSheaf_iff_isLimit, Sieve.generate_sieve, generate_sieve, h.isSheafOpensLeCover, isSheafOpensLeCover, isSheaf_iff_isLimit, nonempty_congr
-/
theorem isSheaf_iff_isSheafOpensLeCover : F.IsSheaf ↔ F.IsSheafOpensLeCover := by
  refine ⟨fun h _ => h.isSheafOpensLeCover,
    fun h => (Presheaf.isSheaf_iff_isLimit _ _).mpr fun Y S => ?_⟩
  rw [← Sieve.generate_sieve S]
  intro hS
  rw [← (isLimitOpensLeEquivGenerate₂ F S.1 hS).nonempty_congr]
  apply h

end

end Presheaf

end TopCat
