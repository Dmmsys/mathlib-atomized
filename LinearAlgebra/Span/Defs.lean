/-- An induction principle for span membership. If `p` holds for 0 and all elements of `s`, and is
preserved under addition and scalar multiplication, then `p` holds for all elements of the span of
`s`. -/
@[elab_as_elim]
/--
theorem `span_induction` / 定理 `span_induction`

English:
theorem span_induction
  statement: {p : (x : M) -> x in span R s -> Prop}
  proof: by
  let p : Submodule R M :=
    { carrier := { x | exists hx, p x hx }
      add_mem' := fun ⟨_, hpx⟩ ⟨_, hpy⟩ => ⟨_, add _ _ _ _ hpx hpy⟩
      zero_mem' := ⟨_, zero⟩
      smul_mem' := fun r => fun ⟨_, hpx⟩ => ⟨_, smul r _ _ hpx⟩ }
.elim fun _ => id .mpr (fun y hy => ⟨subset_span hy, mem y hy⟩) 

中文:
定理 span_induction
  结论: {p : (x : M) -> x in span R s -> 命题}
  证明: by
  let p : Submodule R M :=
    { carrier := { x | exists hx, p x hx }
      add_mem' := fun ⟨_, hpx⟩ ⟨_, hpy⟩ => ⟨_, add _ _ _ _ hpx hpy⟩
      zero_mem' := ⟨_, zero⟩
      smul_mem' := fun r => fun ⟨_, hpx⟩ => ⟨_, smul r _ _ hpx⟩ }
.elim fun _ => id .mpr (fun y hy => ⟨subset_span hy, mem y hy⟩) 

Depends on / 依赖: Submodule, add_mem, carrier, smul_mem, span_le, subset_span, zero_mem
-/
theorem span_induction {p : (x : M) -> x in span R s -> Prop}
    (mem : forall (x) (h : x in s), p x (subset_span h))
    (zero : p 0 (Submodule.zero_mem _))
    (add : forall x y hx hy, p x hx -> p y hy -> p (x + y) (Submodule.add_mem _ ‹_› ‹_›))
    (smul : forall (a : R) (x hx), p x hx -> p (a • x) (Submodule.smul_mem _ _ ‹_›)) {x}
    (hx : x in span R s) : p x hx := by
  let p : Submodule R M :=
    { carrier := { x | exists hx, p x hx }
      add_mem' := fun ⟨_, hpx⟩ ⟨_, hpy⟩ => ⟨_, add _ _ _ _ hpx hpy⟩
      zero_mem' := ⟨_, zero⟩
      smul_mem' := fun r => fun ⟨_, hpx⟩ => ⟨_, smul r _ _ hpx⟩ }
.elim fun _ => id .mpr (fun y hy => ⟨subset_span hy, mem y hy⟩) hx exact span_le (p := p)

/--
theorem `span_induction₂` / 定理 `span_induction₂`

English:
theorem span_induction₂
  statement: {N : Type*} [AddCommMonoid N] [Module R N] {t : Set N}
  proof: by
  induction hb using span_induction with
  | mem z hz => induction ha using span_induction with
    | mem _ h => exact mem_mem _ _ h hz
    | zero => exact zero_left _ _
    | add _ _ _ _ h₁ h₂ => exact add_left _ _ _ _ _ _ h₁ h₂
    | smul _ _ _ h => exact smul_left _ _ _ _ _ h
  | zero => exact

中文:
定理 span_induction₂
  结论: {N : 类型} [加法交换幺半群 N] [模 R N] {t : 集合 N}
  证明: by
  induction hb using span_induction with
  | mem z hz => induction ha using span_induction with
    | mem _ h => exact mem_mem _ _ h hz
    | zero => exact zero_left _ _
    | add _ _ _ _ h₁ h₂ => exact add_left _ _ _ _ _ _ h₁ h₂
    | smul _ _ _ h => exact smul_left _ _ _ _ _ h
  | zero => exact

Depends on / 依赖: add_left, add_right, mem_mem, smul_left, smul_right, span_induction, zero_left, zero_right
-/
theorem span_induction₂ {N : Type*} [AddCommMonoid N] [Module R N] {t : Set N}
    {p : (x : M) -> (y : N) -> x in span R s -> y in span R t -> Prop}
    (mem_mem : forall (x) (y) (hx : x in s) (hy : y in t), p x y (subset_span hx) (subset_span hy))
    (zero_left : forall y hy, p 0 y (zero_mem _) hy) (zero_right : forall x hx, p x 0 hx (zero_mem _))
    (add_left : forall x y z hx hy hz, p x z hx hz -> p y z hy hz -> p (x + y) z (add_mem hx hy) hz)
    (add_right : forall x y z hx hy hz, p x y hx hy -> p x z hx hz -> p x (y + z) hx (add_mem hy hz))
    (smul_left : forall (r : R) x y hx hy, p x y hx hy -> p (r • x) y (smul_mem _ r hx) hy)
    (smul_right : forall (r : R) x y hx hy, p x y hx hy -> p x (r • y) hx (smul_mem _ r hy))
    {a : M} {b : N} (ha : a in Submodule.span R s)
    (hb : b in Submodule.span R t) : p a b ha hb := by
  induction hb using span_induction with
  | mem z hz => induction ha using span_induction with
    | mem _ h => exact mem_mem _ _ h hz
    | zero => exact zero_left _ _
    | add _ _ _ _ h₁ h₂ => exact add_left _ _ _ _ _ _ h₁ h₂
    | smul _ _ _ h => exact smul_left _ _ _ _ _ h
  | zero => exact zero_right a ha
  | add _ _ _ _ h₁ h₂ => exact add_right _ _ _ _ _ _ h₁ h₂
  | smul _ _ _ h => exact smul_right _ _ _ _ _ h

open AddSubmonoid in
/--
theorem `span_eq_closure` / 定理 `span_eq_closure`

English:
theorem span_eq_closure
  given: {s : Set M}
  statement: (span R s).toAddSubmonoid = closure (@univ R • s)
  proof: by
  refine le_antisymm (fun x (hx : x in span R s) => ?of_mem_span) (fun x hx => ?of_mem_closure)
  case of_mem_span =>
    induction hx using span_induction with
    | mem x hx => exact subset_closure ⟨1, trivial, x, hx, one_smul R x⟩
    | zero => exact zero_mem _
    | add _ _ _ _ h₁ h₂ => exact

中文:
定理 span_eq_closure
  条件: {s : 集合 M}
  结论: (span R s).toAddSubmonoid = closure (@univ R • s)
  证明: by
  refine le_antisymm (fun x (hx : x in span R s) => ?of_mem_span) (fun x hx => ?of_mem_closure)
  case of_mem_span =>
    induction hx using span_induction with
    | mem x hx => exact subset_closure ⟨1, trivial, x, hx, one_smul R x⟩
    | zero => exact zero_mem _
    | add _ _ _ _ h₁ h₂ => exact

Depends on / 依赖: add_mem, closure_induction, le_antisymm, mul_smul, of_mem_closure, of_mem_span, one_smul, smul_ze, span_induction, subset_closure, zero_mem
-/
theorem span_eq_closure {s : Set M} : (span R s).toAddSubmonoid = closure (@univ R • s) := by
  refine le_antisymm (fun x (hx : x in span R s) => ?of_mem_span) (fun x hx => ?of_mem_closure)
  case of_mem_span =>
    induction hx using span_induction with
    | mem x hx => exact subset_closure ⟨1, trivial, x, hx, one_smul R x⟩
    | zero => exact zero_mem _
    | add _ _ _ _ h₁ h₂ => exact add_mem h₁ h₂
    | smul r₁ y _h hy =>
      clear _h
      induction hy using closure_induction with
      | mem _ h =>
        obtain ⟨r₂, -, x, hx, rfl⟩ := h
        exact subset_closure ⟨r₁ * r₂, trivial, x, hx, mul_smul ..⟩
      | zero => simp only [smul_zero, zero_mem]
