      exact IsUnit.pow n hg

@[simp]

Depends on / 依赖: IsUnit, IsUnit.pow, LocalizationMap, Submonoid, Submonoid.LocalizationMap.lift, g.map_pow, map_pow
-/
noncomputable def AwayMap.lift (hg : IsUnit (g x)) : N ->* P :=
  Submonoid.LocalizationMap.lift F fun y =>
    show IsUnit (g y.1) by
      obtain ⟨n, hn⟩ := y.2
      rw [← hn]; rw [g.map_pow]
      exact IsUnit.pow n hg

@[simp]
/--
