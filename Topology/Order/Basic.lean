    [OrderTopology α] [SecondCountableTopology α] :
    exists (c : Set α), c.Countable ∧ ts = generateFrom { s | exists a in c, s = Ioi a ∨ s = Iio a } := by
  rcases isEmpty_or_nonempty α with hα | hα
  · exact ⟨∅, by simp, Subsingleton.elim _ _⟩
  obtain ⟨t, t_subs, t_count, ht⟩ : exists t subseteq { s | exists a, s = Ioi a ∨ s = Iio a },
