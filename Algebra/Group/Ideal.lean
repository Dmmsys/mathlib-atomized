Depends on / 依赖: SubMulAction, SubMulAction.fg_iff, fg_iff
-/
theorem fg_iff [Mul M] {I : SemigroupIdeal M} : I.FG ↔ exists (s : Finset M), I = closure s :=
  SubMulAction.fg_iff

end SemigroupIdeal
