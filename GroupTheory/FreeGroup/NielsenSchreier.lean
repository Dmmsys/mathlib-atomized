English:
theorem ext_functor
  statement: {G} [Groupoid.{v} G] [IsFreeGroupoid G] {X : Type v} [Group X]
  proof: let ⟨_, _, u⟩ := @unique_lift G _ _ X _ fun (a b : Generators G) (e : a ⟶ b) => g.map (of e)
  _root_.trans (u _ h) (u _ fun _ _ _ => rfl).symm

