Depends on / 依赖: Subcomplex, Subcomplex.ofSimplex, X.nonDegenerate, nonDegenerate, ofSimplex
-/
def skeleton : Nat ->o X.Subcomplex where
  toFun n := ⨆ (i : Fin n) (x : X.nonDegenerate i), Subcomplex.ofSimplex x.1
