English:
definition ValueGroup₀.restrict₀
  signature: : A ->*₀ ValueGroup₀ f where
  body: letI : DecidablePred fun b : B => b = 0 := Classical.decPred fun b => b = 0
    if h : f a = 0 then 0 else (⟨Units.mk0 (f a) h, mem_valueGroup _ ⟨a, rfl⟩⟩ : valueGroup f)
  map_one' := by simp [← WithZero.coe_one]
  map_mul' := by aesop
  map_zero' := by simp

