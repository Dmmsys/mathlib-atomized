/-- (Order) topology on a partial order `α` generated by the subbase of open intervals
`(a, ∞) = { x ∣ a < x }, (-∞, b) = {x ∣ x < b}` for all `a, b` in `α`. We do not register it as an
instance as many ordered sets are already endowed with the same topology, most often in a non-defeq
way though. Register as a local instance when necessary. -/
@[instance_reducible]
/-
**Preorder.topology** 是 Mathlib 中的一个定义，位于命名空间 ``。
形式化陈述：Preorder.topology (α : Type*) [Preorder α] : TopologicalSpace α
参数：α : Type*。
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
(Order) topology on a partial order `α` generated by the subbase of open interva
ls
`(a, ∞) = { x ∣ a < x }, (-∞, b) = {x ∣ x < b}` for all `a, b` in `α`. We do not
 register it as an
instance as many ordered sets are already endowed with the same topology, most o
ften in a non-defeq
way though. Register as a local instance when necessary.
-/
def Preorder.topology (α : Type*) [Preorder α] : TopologicalSpace α :=
  generateFrom { s | ∃ a, s = Ioi a ∨ s = Iio a }

to_dual_insert_cast Preorder.topology := by simp_rw [or_comm]

/-- The order topology on an ordered type is the topology generated by open intervals. We register
it on a preorder, but it is mostly interesting in linear orders, where it is also order-closed.
We define it as a mixin. If you want to introduce the order topology on a preorder, use
`Preorder.topology`. -/
/-
**OrderTopology** 是 Mathlib 中的一个归纳类型，位于命名空间 ``。
形式化陈述：(α : Type u_1) → [t : TopologicalSpace α] → [Preorder α] → Prop
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
The order topology on an ordered type is the topology generated by open interval
s. We register
it on a preorder, but it is mostly interesting in linear orders, where it is als
o order-closed.
We define it as a mixin. If you want to introduce the order topology on a preord
er, use
`Preorder.topology`.
-/
class OrderTopology (α : Type*) [t : TopologicalSpace α] [Preorder α] : Prop where
  /-- The topology is generated by open intervals `Set.Ioi _` and `Set.Iio _`. -/
  topology_eq_generate_intervals : t = Preorder.topology α

section Preorder

variable [ts : TopologicalSpace α] [Preorder α]

/-- A countable preordered set equipped with the order topology is second countable. -/
/-
**** 是 Mathlib 中的一个实例，位于命名空间 ``。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
A countable preordered set equipped with the order topology is second countable.
-/
instance (priority := 100) [OrderTopology α] [Countable α] :
    SecondCountableTopology α := by
  refine ⟨{ s : Set α | ∃ a, s = Ioi a ∨ s = Iio a }, ?_, ?_⟩
  · let f1 : α → Set α := fun a => Ioi a
    let f2 : α → Set α := fun a => Iio a
    exact Countable.mono (fun s hs => by grind) ((countable_range f1).union (countable_range f2))
  · exact OrderTopology.topology_eq_generate_intervals
/-
**** 是 Mathlib 中的一个实例，位于命名空间 ``。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
instance [t : OrderTopology α] : OrderTopology αᵒᵈ := by
  constructor
  rcases t.topology_eq_generate_intervals with rfl
  simp_rw [Preorder.topology, or_comm]
  rfl

