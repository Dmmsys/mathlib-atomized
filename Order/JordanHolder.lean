Depends on / 依赖: inf_comm, isMaximal_inf_left_of_isMaximal_sup, sup_comm
-/
theorem isMaximal_inf_right_of_isMaximal_sup {x y : X} (hxz : IsMaximal x (x ⊔ y))
    (hyz : IsMaximal y (x ⊔ y)) : IsMaximal (x ⊓ y) y := by
  rw [inf_comm]
  rw [sup_comm] at hxz hyz
  exact isMaximal_inf_left_of_isMaximal_sup hyz hxz

/--
theorem `isMaximal_of_eq_inf` / 定理 `isMaximal_of_eq_inf`

English:
theorem isMaximal_of_eq_inf
  statement: (x b : X) {a y : X} (ha : x ⊓ y = a) (hxy : x != y) (hxb : IsMaximal x b)
  proof: by
  have hb : x ⊔ y = b := sup_eq_of_isMaximal hxb hyb hxy
  subst a b
  exact isMaximal_inf_right_of_isMaximal_sup hxb hyb

中文:
定理 isMaximal_of_eq_inf
  结论: (x b : X) {a y : X} (ha : x ⊓ y = a) (hxy : x != y) (hxb : 是极大 x b)
  证明: by
  have hb : x ⊔ y = b := sup_eq_of_isMaximal hxb hyb hxy
  subst a b
  exact isMaximal_inf_right_of_isMaximal_sup hxb hyb

Depends on / 依赖: isMaximal_inf_right_of_isMaximal_sup, sup_eq_of_isMaximal
-/
theorem isMaximal_of_eq_inf (x b : X) {a y : X} (ha : x ⊓ y = a) (hxy : x != y) (hxb : IsMaximal x b)
    (hyb : IsMaximal y b) : IsMaximal a y := by
  have hb : x ⊔ y = b := sup_eq_of_isMaximal hxb hyb hxy
  subst a b
  exact isMaximal_inf_right_of_isMaximal_sup hxb hyb

