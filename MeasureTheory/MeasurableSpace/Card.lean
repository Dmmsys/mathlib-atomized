termination_by i

Depends on / 依赖: Set.range, generateMeasurableRec, termination_by
-/
def generateMeasurableRec (s : Set (Set α)) (i : Ordinal) : Set (Set α) :=
  let S := ⋃ j < i, generateMeasurableRec s j
  s union {∅} union compl '' S union Set.range fun f : Nat -> S => ⋃ n, (f n).1
termination_by i

