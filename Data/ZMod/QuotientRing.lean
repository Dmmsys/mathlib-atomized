noncomputable section ChineseRemainder
open Ideal

open scoped Function in -- required for scoped `on` notation
/-- The **Chinese remainder theorem**, elementary version for `ZMod`. See also
`Mathlib/Data/ZMod/Basic.lean` for versions involving only two numbers. -/
/-
**ZMod.prodEquivPi** 是 Mathlib 中的一个定义，位于命名空间 ``。
形式化陈述：ZMod.prodEquivPi {ι : Type*} [Fintype ι] (a : ι -> Nat) (coprime : Pairwis
e (Nat.Coprime on a)) : ZMod (∏ i, a i) ≃+* Π i, ZMod (a i)
参数：a : ι -> Nat；coprime : Pairwise (Nat.Coprime on a)。
该定义给出了上述对象。
本定义的构造引用了以下数学事实（定理与引理）：
· 使用定理 `Ideal.iInf_span_singleton_natCast`：iInf_span_singleton_natCast {R : Type
*} [CommRing R] {ι : Type*} [Fintype ι] {I : ι -> Nat} (hI : Pairwise fun i j =>
 (I i).Coprime (I j)) :…
· 使用定理 `Finite.of_fintype`：∀ (α : Type u_4) [Fintype α], Finite α

--- 原说明 ---
The **Chinese remainder theorem**, elementary version for `ZMod`. See also
`Mathlib/Data/ZMod/Basic.lean` for versions involving only two numbers.
-/
def ZMod.prodEquivPi {ι : Type*} [Fintype ι] (a : ι → ℕ)
    (coprime : Pairwise (Nat.Coprime on a)) : ZMod (∏ i, a i) ≃+* Π i, ZMod (a i) :=
  have : Pairwise fun i j => IsCoprime (span {(a i : ℤ)}) (span {(a j : ℤ)}) :=
    fun _i _j h ↦ (isCoprime_span_singleton_iff _ _).mpr ((coprime h).cast (R := ℤ))
  Int.quotientSpanNatEquivZMod _ |>.symm.trans <|
  quotEquivOfEq (iInf_span_singleton_natCast (R := ℤ) coprime) |>.symm.trans <|
  quotientInfRingEquivPiQuotient _ this |>.trans <|
  RingEquiv.piCongrRight fun i ↦ Int.quotientSpanNatEquivZMod (a i)

open Finset Function in
@[simp]
/-
**ZMod.prodEquivPi_apply** 是 Mathlib 中的一个定理，位于命名空间 ``。
形式化陈述：ZMod.prodEquivPi_apply {ι : Type*} [Fintype ι] (a : ι -> Nat) (coprime : P
airwise (Nat.Coprime on a)) (b : ZMod (∏ i, a i)) (i : ι) : prodEquivPi a coprim
e b i = castHom (dvd_prod_of_mem a (mem_univ i)) _ b
参数：a : ι -> Nat；coprime : Pairwise (Nat.Coprime on a)；b : ZMod (∏ i, a i)；i : ι。
该定理/引理给出了一组等式。
黑盒证明引用了以下数学事实（定理与引理）：
· 使用定理 `RingHom.congr_fun`：∀ {α : Type u_2} {β : Type u_3} {x : NonAssocSemiring
 α} {x_1 : NonAssocSemiring β} {f g : α →+* β},   f = g → ∀ (x_2 : α), f x_2 = g
 x_2
· 使用定理 `Finset.dvd_prod_of_mem`：dvd_prod_of_mem (f : ι -> M) {a : ι} {s : Finset
 ι} (ha : a in s) : f a ∣ ∏ i in s, f i
· 使用定理 `Finset.mem_univ`：mem_univ (x : α) : x in (univ : Finset α)
· 使用定理 `Subsingleton.elim`：∀ {α : Sort u} [h : Subsingleton α] (a b : α), a = b
-/
theorem ZMod.prodEquivPi_apply {ι : Type*} [Fintype ι] (a : ι → ℕ)
    (coprime : Pairwise (Nat.Coprime on a)) (b : ZMod (∏ i, a i)) (i : ι) :
    prodEquivPi a coprime b i = castHom (dvd_prod_of_mem a (mem_univ i)) _ b :=
  RingHom.congr_fun (Subsingleton.elim ((Pi.evalRingHom (fun _ ↦ ZMod _) i).comp
    (prodEquivPi a coprime).toRingHom) _) b

/-- The **Chinese remainder theorem**, version for `ZMod n`. -/
/-
**ZMod.equivPi** 是 Mathlib 中的一个定义，位于命名空间 ``。
形式化陈述：ZMod.equivPi (hn : n != 0) : ZMod n ≃+* Π (p : n.primeFactors), ZMod (p ^ 
(n.factorization p))
参数：hn : n != 0。
该定义给出了上述对象。
本定义的构造引用了以下数学事实（定理与引理）：
· 使用引理 `Nat.prod_primeFactors_coe_pow_factorization`：prod_primeFactors_coe_pow_f
actorization (hn : n != 0) : n = ∏ (p : n.primeFactors), (p : Nat) ^ (n.factoriz
ation p)
· 使用引理 `Nat.pairwise_coprime_pow_primeFactors_factorization`：pairwise_coprime_po
w_primeFactors_factorization : Pairwise (Function.onFun Nat.Coprime fun (p : n.p
rimeFactors) => p ^ n.factorization p)

--- 原说明 ---
The **Chinese remainder theorem**, version for `ZMod n`.
-/
def ZMod.equivPi (hn : n ≠ 0) :
    ZMod n ≃+* Π (p : n.primeFactors), ZMod (p ^ (n.factorization p)) :=
  (ringEquivCongr <| Nat.prod_primeFactors_coe_pow_factorization hn).trans
    <| prodEquivPi (fun (p : n.primeFactors) ↦ (p : ℕ) ^ (n.factorization p))
      n.pairwise_coprime_pow_primeFactors_factorization

end ChineseRemainder

