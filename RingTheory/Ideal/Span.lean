/-!
# Ideals generated by a set of elements

This file defines `Ideal.span s` as the ideal generated by the subset `s` of the ring.

## TODO

Support right ideals, and two-sided ideals over non-commutative rings.
-/

@[expose] public section

universe u

variable {α : Type u}

open Set Pointwise

/-- A ring is a principal ideal ring if all (left) ideals are principal. -/
@[mk_iff]
/--
Definition of `IsPrincipalIdealRing` / `IsPrincipalIdealRing` 的定义

English:
class IsPrincipalIdealRing
  parameters: (R : Type u) [Semiring R]
  axioms and operations (1):
    - principal : forall S : Ideal R, S.IsPrincipal

中文:
类 IsPrincipalIdealRing
  参数: (R : 类型u) [Semiring R]
  公理与运算 (1 个):
    - principal : 对任意 S : Ideal R, S.IsPrincipal
-/
class IsPrincipalIdealRing (R : Type u) [Semiring R] : Prop where
  principal : forall S : Ideal R, S.IsPrincipal

attribute [instance] IsPrincipalIdealRing.principal

namespace Ideal

section Semiring

