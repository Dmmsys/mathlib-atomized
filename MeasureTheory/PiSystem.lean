lemma IsPiSystem.dissipate_mem {s : ℕ → Set α} {C : Set (Set α)}
    (hC : IsPiSystem C) (h : ∀ n, s n ∈ C) (n : ℕ) (h' : (dissipate s n).Nonempty) :
    dissipate s n ∈ C := by
  induction n with
  | zero => simpa using h 0
  | succ n hn =>
    rw [dissipate_succ] at h' ⊢
    exact hC (dissipate s n) (hn h'.left) (s (n + 1)) (h (n + 1)) h'
