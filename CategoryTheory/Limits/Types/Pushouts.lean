module

public import Mathlib.CategoryTheory.Limits.Types.Pullbacks
public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.IsPullback.Basic

/-!
# Pushouts in `Type`

We describe the pushout of two maps `f : S ⟶ X₁` and `g : S ⟶ X₂`
in the category of types as the quotient of `X₁ ⊕ X₂` by the
equivalence relation generated by a relation. We also study
the particular case when `f` is injective (in the file
`CategoryTheory.Types.Monomorphisms`, it is deduced that monomorphisms
are stable under cobase change in the category of types).

-/

@[expose] public section

universe u

namespace CategoryTheory.Limits.Types

/-
**CategoryTheory.Limits.Types.** 是 Mathlib 中的一个实例，位于命名空间 `CategoryTheory.Limits.
Types`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
instance : HasPushouts.{u} (Type u) :=
  hasPushouts_of_hasWidePushouts.{u} (Type u)

variable {S X₁ X₂ : Type u} (f : S ⟶ X₁) (g : S ⟶ X₂)

/-- The pushout of two maps `f : S ⟶ X₁` and `g : S ⟶ X₂` is the quotient
by the equivalence relation on `X₁ ⊕ X₂` generated by this relation. -/
/-
**CategoryTheory.Limits.Types.Pushout.Rel** 是 Mathlib 中的一个归纳类型，位于命名空间 `CategoryT
heory.Limits.Types.Pushout`。
形式化陈述：{S X₁ X₂ : Type u} → (S ⟶ X₁) → (S ⟶ X₂) → X₁ ⊕ X₂ → X₁ ⊕ X₂ → Prop
参数：S ⟶ X₁；S ⟶ X₂。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
The pushout of two maps `f : S ⟶ X₁` and `g : S ⟶ X₂` is the quotient
by the equivalence relation on `X₁ ⊕ X₂` generated by this relation.
-/
inductive Pushout.Rel (f : S ⟶ X₁) (g : S ⟶ X₂) : X₁ ⊕ X₂ → X₁ ⊕ X₂ → Prop
  | inl_inr (s : S) : Pushout.Rel f g (Sum.inl (f s)) (Sum.inr (g s))

/-- Construction of the pushout in the category of types, as a quotient of `X₁ ⊕ X₂`. -/
/-
**CategoryTheory.Limits.Types.Pushout** 是 Mathlib 中的一个定义，位于命名空间 `CategoryTheory.
Limits.Types`。
形式化陈述：Pushout : Type u
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
Construction of the pushout in the category of types, as a quotient of `X₁ ⊕ X₂`
.
-/
def Pushout : Type u := (_root_.Quot (Pushout.Rel f g))

/-- In case `f : S ⟶ X₁` is a monomorphism, this relation is the equivalence relation
generated by `Pushout.Rel f g`. -/
/-
**CategoryTheory.Limits.Types.Pushout.Rel'** 是 Mathlib 中的一个引理，位于命名空间 `CategoryTh
eory.Limits.Types.Pushout`。
形式化陈述：Rel'.symm {x y : X₁ oplus X₂} (h : Rel' f g x y) : Rel' f g y x
参数：h : Rel' f g x y。
该定理/引理描述了相关对象所满足的性质。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
In case `f : S ⟶ X₁` is a monomorphism, this relation is the equivalence relatio
n
generated by `Pushout.Rel f g`.
-/
inductive Pushout.Rel' : X₁ ⊕ X₂ → X₁ ⊕ X₂ → Prop
  | refl (x : X₁ ⊕ X₂) : Rel' x x
  | inl_inl (x₀ y₀ : S) (h : g x₀ = g y₀) : Rel' (Sum.inl (f x₀)) (Sum.inl (f y₀))
  | inl_inr (s : S) : Rel' (Sum.inl (f s)) (Sum.inr (g s))
  | inr_inl (s : S) : Rel' (Sum.inr (g s)) (Sum.inl (f s))

/-- The quotient of `X₁ ⊕ X₂` by the relation `PushoutRel' f g`. -/
/-
**CategoryTheory.Limits.Types.Pushout'** 是 Mathlib 中的一个定义，位于命名空间 `CategoryTheory
.Limits.Types`。
形式化陈述：Pushout' : Type u
该定义给出了上述对象。
本定义的构造引用了以下数学事实（定理与引理）：
· 使用引理 `CategoryTheory.Limits.Types.Pushout.Rel'`：Rel'.symm {x y : X₁ oplus X₂} 
(h : Rel' f g x y) : Rel' f g y x

--- 原说明 ---
The quotient of `X₁ ⊕ X₂` by the relation `PushoutRel' f g`.
-/
def Pushout' : Type u := _root_.Quot (Pushout.Rel' f g)

namespace Pushout

/-- The left inclusion in the constructed pushout `Pushout f g`. -/
@[simp]
/-
**CategoryTheory.Limits.Types.Pushout.inl** 是 Mathlib 中的一个定义，位于命名空间 `CategoryThe
ory.Limits.Types.Pushout`。
形式化陈述：inl : X₁ ⟶ Pushout f g
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
The left inclusion in the constructed pushout `Pushout f g`.
-/
def inl : X₁ ⟶ Pushout f g := ↾fun x => Quot.mk _ (Sum.inl x)

/-- The right inclusion in the constructed pushout `Pushout f g`. -/
@[simp]
/-
**CategoryTheory.Limits.Types.Pushout.inr** 是 Mathlib 中的一个定义，位于命名空间 `CategoryThe
ory.Limits.Types.Pushout`。
形式化陈述：inr : X₂ ⟶ Pushout f g
该定义给出了上述对象。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
The right inclusion in the constructed pushout `Pushout f g`.
-/
def inr : X₂ ⟶ Pushout f g := ↾fun x => Quot.mk _ (Sum.inr x)
/-
**CategoryTheory.Limits.Types.Pushout.condition** 是 Mathlib 中的一个引理，位于命名空间 `Categ
oryTheory.Limits.Types.Pushout`。
形式化陈述：condition : f ≫ inl f g = g ≫ inr f g
该定理/引理给出了一组等式。
黑盒证明引用了以下数学事实（定理与引理）：
· 使用定理 `CategoryTheory.ConcreteCategory.ext`：∀ {C : Type u} [inst : CategoryTheo
ry.Category.{v, u} C] {FC : C → C → Type u_1} {CC : C → Type w}   [inst_1 : (X Y
 : C) → FunLike (FC X Y) …
· 使用定理 `TypeCat.Fun.ext`：∀ {X : Type u_1} {Y : Type u_2} {x y : TypeCat.Fun X Y}
, x.toFun = y.toFun → x = y
· 使用定理 `funext`：∀ {α : Sort u} {β : α → Sort v} {f g : (x : α) → β x}, (∀ (x : α
), f x = g x) → f = g
-/
lemma condition : f ≫ inl f g = g ≫ inr f g := by
  ext x
  exact Quot.sound (Rel.inl_inr x)

/-- The constructed pushout cocone in the category of types. -/
@[simps!]
/-
**CategoryTheory.Limits.Types.Pushout.cocone** 是 Mathlib 中的一个定义，位于命名空间 `Category
Theory.Limits.Types.Pushout`。
形式化陈述：cocone : PushoutCocone f g
该定义给出了上述对象。
本定义的构造引用了以下数学事实（定理与引理）：
· 使用引理 `CategoryTheory.Limits.Types.Pushout.condition`：condition : f ≫ inl f g =
 g ≫ inr f g

--- 原说明 ---
The constructed pushout cocone in the category of types.
-/
def cocone : PushoutCocone f g := PushoutCocone.mk _ _ (condition f g)

/-- The cocone `cocone f g` is colimit. -/
/-
**CategoryTheory.Limits.Types.Pushout.isColimitCocone** 是 Mathlib 中的一个定义，位于命名空间 
`CategoryTheory.Limits.Types.Pushout`。
形式化陈述：isColimitCocone : IsColimit (cocone f g)
该定义给出了上述对象。
本定义的构造引用了以下数学事实（定理与引理）：
· 使用引理 `CategoryTheory.Limits.Types.Pushout.condition`：condition : f ≫ inl f g =
 g ≫ inr f g

--- 原说明 ---
The cocone `cocone f g` is colimit.
-/
def isColimitCocone : IsColimit (cocone f g) :=
  PushoutCocone.IsColimit.mk _ (fun s => ↾(Quot.lift (fun x => match x with
      | Sum.inl x₁ => s.inl x₁
      | Sum.inr x₂ => s.inr x₂) (by
    rintro _ _ ⟨t⟩
    exact ConcreteCategory.congr_hom s.condition t))) (fun _ => rfl) (fun _ => rfl)
      (fun s m h₁ h₂ => by
      ext ⟨x₁ | x₂⟩
      · exact ConcreteCategory.congr_hom h₁ x₁
      · exact ConcreteCategory.congr_hom h₂ x₂)

@[simp]
/-
**CategoryTheory.Limits.Types.Pushout.inl_rel'_inl_iff** 是 Mathlib 中的一个定理，位于命名空间
 `CategoryTheory.Limits.Types.Pushout`。
形式化陈述：∀ {S X₁ X₂ : Type u} (f : S ⟶ X₁) (g : S ⟶ X₂) (x₁ y₁ : X₁),   CategoryThe
ory.Limits.Types.Pushout.Rel' f g (Sum.inl x₁) (Sum.inl y₁) ↔     x₁ = y₁ ∨     
  ∃ x₀ y₀,         ∃ (_ : (CategoryTheory.ConcreteCategory.hom g) x₀ = (Category
Theory.ConcreteCategory.hom g) y₀),           x₁ = (CategoryTheory.ConcreteCateg
ory.hom f) x₀ ∧ y₁ = (CategoryTheory.ConcreteCategory.hom f) y₀
参数：f : S ⟶ X₁；g : S ⟶ X₂；x₁ y₁ : X₁；Sum.inl x₁；Sum.inl y₁；_ : (CategoryTheory.Co
ncreteCategory.hom g) x₀ = (CategoryTheory.ConcreteCategory.hom g) y₀；CategoryTh
eory.ConcreteCategory.hom f；CategoryTheory.ConcreteCategory.hom f。
黑盒证明引用了以下数学事实（定理与引理）：
· 使用引理 `CategoryTheory.Limits.Types.Pushout.Rel'`：Rel'.symm {x y : X₁ oplus X₂} 
(h : Rel' f g x y) : Rel' f g y x
· 使用定理 `Eq.symm`：∀ {α : Sort u} {a b : α}, a = b → b = a
· 使用定理 `eq_of_heq`：∀ {α : Sort u} {a a' : α}, a ≍ a' → a = a'
· 使用定理 `noConfusion_of_Nat`：∀ {α : Sort u} (f : α → ℕ) {a b : α}, a = b → Bool.r
ec False True ((f a).beq (f b))
-/
lemma inl_rel'_inl_iff (x₁ y₁ : X₁) :
    Rel' f g (Sum.inl x₁) (Sum.inl y₁) ↔ x₁ = y₁ ∨
      ∃ (x₀ y₀ : S) (_ : g x₀ = g y₀), x₁ = f x₀ ∧ y₁ = f y₀ := by
  constructor
  · rintro (_ | ⟨_, _, h⟩)
    · exact Or.inl rfl
    · exact Or.inr ⟨_, _, h, rfl, rfl⟩
  · rintro (rfl | ⟨_, _, h, rfl, rfl⟩)
    · apply Rel'.refl
    · exact Rel'.inl_inl _ _ h

@[simp]
/-
**CategoryTheory.Limits.Types.Pushout.inl_rel'_inr_iff** 是 Mathlib 中的一个定理，位于命名空间
