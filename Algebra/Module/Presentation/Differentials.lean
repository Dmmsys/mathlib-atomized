      Subtype.coe_injective ?_
    rw [Submodule.map_top]; rw [Submodule.range_subtype]; rw [Submodule.map_span]; rw [Submodule.coe_subtype]; rw [Ideal.submodule_span_eq]
    simp only [← pres.span_range_relation_eq_ker]
