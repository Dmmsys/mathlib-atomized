theorem encode_injective {α : Sort*} [Countable α] :
    Function.Injective (encode : α -> Nat) :=
  (Countable.exists_injective_nat α).choose_spec

/--
theorem `cons_eq_imp_init` / 定理 `cons_eq_imp_init`

English:
theorem cons_eq_imp_init
  statement: {p : Prop} {a b b' : Nat}
  proof: by
  simpa [Nat.pair_eq_pair, and_imp] using h

中文:
定理 cons_eq_imp_init
  结论: {p : 命题} {a b b' : 自然数}
  证明: by
  simpa [Nat.pair_eq_pair, and_imp] using h

Depends on / 依赖: Nat.pair_eq_pair, and_imp, pair_eq_pair
-/
theorem cons_eq_imp_init {p : Prop} {a b b' : Nat}
    (h : b = b' -> p) : Nat.pair a b = Nat.pair a b' -> p := by
  simpa [Nat.pair_eq_pair, and_imp] using h

/--
theorem `cons_eq_imp` / 定理 `cons_eq_imp`

English:
theorem cons_eq_imp
  statement: {p : Prop} {a b a' b' : Nat}
  proof: by
  rwa [Nat.pair_eq_pair, and_imp]

中文:
定理 cons_eq_imp
  结论: {p : 命题} {a b a' b' : 自然数}
  证明: by
  rwa [Nat.pair_eq_pair, and_imp]

Depends on / 依赖: Nat.pair_eq_pair, and_imp, pair_eq_pair
-/
theorem cons_eq_imp {p : Prop} {a b a' b' : Nat}
    (h : a = a' -> b = b' -> p) : Nat.pair a b = Nat.pair a' b' -> p := by
  rwa [Nat.pair_eq_pair, and_imp]

/--
theorem `pair_encode_step` / 定理 `pair_encode_step`

English:
theorem pair_encode_step
  statement: {p : Prop} {α : Sort*} [Countable α]
  proof: cons_eq_imp fun ha => h (encode_injective ha)

中文:
定理 pair_encode_step
  结论: {p : 命题} {α : Sort*} [Countable α]
  证明: cons_eq_imp fun ha => h (encode_injective ha)

Depends on / 依赖: cons_eq_imp, encode_injective
-/
theorem pair_encode_step {p : Prop} {α : Sort*} [Countable α]
    {a b : α} {m n : Nat}
    (h : a = b -> m = n -> p) : Nat.pair (encode a) m = Nat.pair (encode b) n -> p :=
  cons_eq_imp fun ha => h (encode_injective ha)


