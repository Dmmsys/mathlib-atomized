variable (M : Type v) [AddCommGroup M] [Module A M]

/-- The type of solutions in a module `M` of the equations given by `relations : Relations A`. -/
@[ext]
/-
**Module.Relations.Solution** 是 Mathlib 中的一个归纳类型，位于命名空间 `Module.Relations`。
形式化陈述：{A : Type u} →   [inst : Ring A] →     Module.Relations A → (M : Type v) →
 [inst_1 : AddCommGroup M] → [_root_.Module A M] → Type (max v w₀)
参数：M : Type v；max v w₀。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
The type of solutions in a module `M` of the equations given by `relations : Rel
ations A`.
-/
structure Solution where
  /-- the image in `M` of each variable -/
  var (g : relations.G) : M
  linearCombination_var_relation (r : relations.R) :
    Finsupp.linearCombination _ var (relations.relation r) = 0

namespace Solution

variable {relations M}

section

variable (solution : relations.Solution M)

/-- Given `relations : Relations A` and a solution in `relations.Solution M`, this is
the linear map `(relations.G →₀ A) →ₗ[A] M` canonically associated to the solution. -/
/-
**Module.Relations.Solution.** 是 Mathlib 中的一个定义，位于命名空间 `Module.Relations.Solutio
n`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。

--- 原说明 ---
Given `relations : Relations A` and a solution in `relations.Solution M`, this i
s
the linear map `(relations.G →₀ A) →ₗ[A] M` canonically associated to the soluti
on.
-/
def π : (relations.G →₀ A) →ₗ[A] M := Finsupp.linearCombination _ solution.var

@[simp]
/-
**Module.Relations.Solution.** 是 Mathlib 中的一个引理，位于命名空间 `Module.Relations.Solutio
n`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
lemma π_single (g : relations.G) :
    solution.π (Finsupp.single g 1) = solution.var g := by simp [π]

@[simp]
/-
**Module.Relations.Solution.** 是 Mathlib 中的一个引理，位于命名空间 `Module.Relations.Solutio
n`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
lemma π_relation (r : relations.R) : solution.π (relations.relation r) = 0 :=
  solution.linearCombination_var_relation r

@[simp]
/-
**Module.Relations.Solution.** 是 Mathlib 中的一个引理，位于命名空间 `Module.Relations.Solutio
n`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
lemma π_comp_map : solution.π.comp relations.map = 0 := by aesop

@[simp]
/-
**Module.Relations.Solution.** 是 Mathlib 中的一个引理，位于命名空间 `Module.Relations.Solutio
n`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
lemma π_comp_map_apply (x : relations.R →₀ A) : solution.π (relations.map x) = 0 := by
  change solution.π.comp relations.map x = 0
  rw [π_comp_map, LinearMap.zero_apply]
/-
**Module.Relations.Solution.range_** 是 Mathlib 中的一个引理，位于命名空间 `Module.Relations.S
olution`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
lemma range_π : LinearMap.range solution.π = Submodule.span A (Set.range solution.var) :=
  Finsupp.range_linearCombination _
/-
**Module.Relations.Solution.span_relation_le_ker_** 是 Mathlib 中的一个引理，位于命名空间 `Mod
ule.Relations.Solution`。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
-/
lemma span_relation_le_ker_π :
    Submodule.span A (Set.range relations.relation) ≤ LinearMap.ker solution.π := by
  rw [Submodule.span_le]
  rintro _ ⟨r, rfl⟩
  simp only [SetLike.mem_coe, LinearMap.mem_ker, π_relation]

/-- Given `relations : Relations A` and `solution : relations.Solution M`, this is
the canonical linear map `relations.Quotient →ₗ[A] M` from the module. -/
/-
**Module.Relations.Solution.fromQuotient** 是 Mathlib 中的一个定义，位于命名空间 `Module.Relat
ions.Solution`。
形式化陈述：fromQuotient : relations.Quotient ->ₗ[A] M
该定义给出了上述对象。
本定义的构造引用了以下数学事实（定理与引理）：
· 使用引理 `Module.Relations.Solution.span_relation_le_ker_π`：span_relation_le_ker_π
 : Submodule.span A (Set.range relations.relation) <= LinearMap.ker solution.π

--- 原说明 ---
Given `relations : Relations A` and `solution : relations.Solution M`, this is
the canonical linear map `relations.Quotient →ₗ[A] M` from the module.
-/
def fromQuotient : relations.Quotient →ₗ[A] M :=
  Submodule.liftQ _ solution.π solution.span_relation_le_ker_π

@[simp]
/-
**Module.Relations.Solution.fromQuotient_comp_toQuotient** 是 Mathlib 中的一个引理，位于命名
空间 `Module.Relations.Solution`。
形式化陈述：fromQuotient_comp_toQuotient : solution.fromQuotient.comp relations.toQuot
ient = solution.π
该定理/引理给出了一组等式。
黑盒内容：本声明未引用其他定理/引理；其成立仅依赖定义、结构与类型类实例。
