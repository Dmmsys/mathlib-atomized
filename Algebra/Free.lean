protected def FreeMagma.traverse {m : Type u -> Type u} [Applicative m] {α β : Type u}
    (F : α -> m β) : FreeMagma α -> m (FreeMagma β)
| FreeMagma.of x => FreeMagma.of < > F x
| x * y => (· * ·) < > x.traverse F <*> y.traverse F

