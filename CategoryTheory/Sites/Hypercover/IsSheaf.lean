lemma exists_oneHypercover [H.IsGenerating] {X : C} (S : Sieve X) (hS : S in J X) :
    exists (E : J.OneHypercover X) (_ : H E), E.sieve₀ <= S :=
  IsGenerating.le _ hS

variable (P : Cᵒᵖ ⥤ A)

namespace IsSheafIff

variable (hP : forall ⦃X : C⦄ (E : J.OneHypercover X) (_ : H E), Nonempty (IsLimit (E.multifork P)))

include hP in
/--
lemma `hom_ext` / 引理 `hom_ext`

English:
lemma hom_ext
  statement: [H.IsGenerating] {X : C} (S : Sieve X) (hS : S in J X) {T : A}
  proof: by
  obtain ⟨E, hE, le⟩ := H.exists_oneHypercover S hS
  exact Multifork.IsLimit.hom_ext (hP E hE).some (fun j => h _ (le _ (Sieve.ofArrows_mk _ _ _)))

中文:
引理 hom_ext
  结论: [H.是Generating] {X : C} (S : 筛 X) (hS : S in J X) {T : A}
  证明: by
  obtain ⟨E, hE, le⟩ := H.exists_oneHypercover S hS
  exact Multifork.IsLimit.hom_ext (hP E hE).some (fun j => h _ (le _ (Sieve.ofArrows_mk _ _ _)))

Depends on / 依赖: H.exists_oneHypercover, IsLimit, Multifork, Multifork.IsLimit.hom_ext, Sieve.ofArrows_mk, exists_oneHypercover, hom_ext, ofArrows_mk
-/
lemma hom_ext [H.IsGenerating] {X : C} (S : Sieve X) (hS : S in J X) {T : A}
    {x y : T ⟶ P.obj (Opposite.op X)}
    (h : forall ⦃Y : C⦄ (f : Y ⟶ X) (_ : S f), x ≫ P.map f.op = y ≫ P.map f.op) :
    x = y := by
  obtain ⟨E, hE, le⟩ := H.exists_oneHypercover S hS
  exact Multifork.IsLimit.hom_ext (hP E hE).some (fun j => h _ (le _ (Sieve.ofArrows_mk _ _ _)))

variable {P H}
variable {X : C} {S : Sieve X} {E : J.OneHypercover X} (hE : H E) (le : E.sieve₀ <= S)

section

variable (F : Multifork (Cover.index ⟨S, J.superset_covering le E.mem₀⟩ P))

/--
Definition of `lift` / `lift` 的定义

English:
definition lift
  signature: : F.pt ⟶ P.obj (Opposite.op X)
  body: Multifork.IsLimit.lift (hP E hE).some
    (fun i => F.ι ⟨_, E.f i, le _ (Sieve.ofArrows_mk _ _ _)⟩)
    (fun ⟨⟨i₁, i₂⟩, j⟩ =>
      F.condition {
        fst := { hf := le _ (Sieve.ofArrows_mk _ _ i₁), .. }
        snd := { hf := le _ (Sieve.ofArrows_mk _ _ i₂), .. }
        r := { w := E.w j, .. }
      })

@[reassoc]

中文:
定义 lift
  签名: : F.pt ⟶ P.obj (对偶.op X)
  定义体: Multifork.IsLimit.lift (hP E hE).some
    (fun i => F.ι ⟨_, E.f i, le _ (Sieve.ofArrows_mk _ _ _)⟩)
    (fun ⟨⟨i₁, i₂⟩, j⟩ =>
      F.condition {
        fst := { hf := le _ (Sieve.ofArrows_mk _ _ i₁), .. }
        snd := { hf := le _ (Sieve.ofArrows_mk _ _ i₂), .. }
        r := { w := E.w j, .. }
      })

@[reassoc]

Depends on / 依赖: F.condition, IsLimit, Multifork, Multifork.IsLimit.lift, Sieve.ofArrows_mk, condition, ofArrows_mk
-/
noncomputable def lift : F.pt ⟶ P.obj (Opposite.op X) :=
  Multifork.IsLimit.lift (hP E hE).some
    (fun i => F.ι ⟨_, E.f i, le _ (Sieve.ofArrows_mk _ _ _)⟩)
    (fun ⟨⟨i₁, i₂⟩, j⟩ =>
      F.condition {
        fst := { hf := le _ (Sieve.ofArrows_mk _ _ i₁), .. }
        snd := { hf := le _ (Sieve.ofArrows_mk _ _ i₂), .. }
        r := { w := E.w j, .. }
      })

@[reassoc]
/--
lemma `fac'` / 引理 `fac'`

English:
lemma fac'
  given: (i : E.I₀)
  proof: Multifork.IsLimit.fac (hP E hE).some _ _ i

中文:
引理 fac'
  条件: (i : E.I₀)
  证明: Multifork.IsLimit.fac (hP E hE).some _ _ i

Depends on / 依赖: IsLimit, Multifork, Multifork.IsLimit.fac
-/
lemma fac' (i : E.I₀) :
    lift hP hE le F ≫ P.map (E.f i).op =
      F.ι ⟨_, E.f i, le _ (Sieve.ofArrows_mk _ _ _)⟩ :=
  Multifork.IsLimit.fac (hP E hE).some _ _ i

/--
lemma `fac` / 引理 `fac`

English:
lemma fac
  given: [H.IsGenerating] {Y : C} (f : Y ⟶ X) (hf : S f)
  proof: by
  apply hom_ext H P hP _ (J.pullback_stable f E.mem₀)
  intro Z g
  rintro ⟨T, a, b, ⟨i⟩, fac⟩
  rw [assoc]; rw [← P.map_comp]; rw [← op_comp]; rw [← fac]; rw [op_comp]; rw [P.map_comp]; rw [fac'_assoc]
  exact F.condition {
    fst := { hf := le _ (Sieve.ofArrows_mk _ _ _), .. }
    snd := { hf := hf, .. }
    r := { w := fac, .. }
  }

中文:
引理 fac
  条件: [H.是Generating] {Y : C} (f : Y ⟶ X) (hf : S f)
  证明: by
  apply hom_ext H P hP _ (J.pullback_stable f E.mem₀)
  intro Z g
  rintro ⟨T, a, b, ⟨i⟩, fac⟩
  rw [assoc]; rw [← P.map_comp]; rw [← op_comp]; rw [← fac]; rw [op_comp]; rw [P.map_comp]; rw [fac'_assoc]
  exact F.condition {
    fst := { hf := le _ (Sieve.ofArrows_mk _ _ _), .. }
    snd := { hf := hf, .. }
    r := { w := fac, .. }
  }

Depends on / 依赖: E.mem, F.condition, J.pullback_stable, P.map_comp, Sieve.ofArrows_mk, _assoc, condition, hom_ext, map_comp, ofArrows_mk, op_comp, pullback_stable
-/
lemma fac [H.IsGenerating] {Y : C} (f : Y ⟶ X) (hf : S f) :
    lift hP hE le F ≫ P.map f.op = F.ι ⟨Y, f, hf⟩ := by
  apply hom_ext H P hP _ (J.pullback_stable f E.mem₀)
  intro Z g
  rintro ⟨T, a, b, ⟨i⟩, fac⟩
  rw [assoc]; rw [← P.map_comp]; rw [← op_comp]; rw [← fac]; rw [op_comp]; rw [P.map_comp]; rw [fac'_assoc]
  exact F.condition {
    fst := { hf := le _ (Sieve.ofArrows_mk _ _ _), .. }
    snd := { hf := hf, .. }
    r := { w := fac, .. }
  }

end

/--
Definition of `isLimit` / `isLimit` 的定义

English:
definition isLimit
  signature: [H.IsGenerating]
  body: Multifork.IsLimit.mk _
    (fun F => lift hP hE le F)
    (fun F => by
      rintro ⟨Y, f, hf⟩
      apply fac)
    (fun F m hm => by
      apply hom_ext H P hP S (J.superset_covering le E.mem₀)
      intro Y f hf
      rw [fac _ _ _ _ _ hf]
      exact hm ⟨_, _, hf⟩)

中文:
定义 isLimit
  签名: [H.是Generating]
  定义体: Multifork.IsLimit.mk _
    (fun F => lift hP hE le F)
    (fun F => by
      rintro ⟨Y, f, hf⟩
      apply fac)
    (fun F m hm => by
      apply hom_ext H P hP S (J.superset_covering le E.mem₀)
      intro Y f hf
      rw [fac _ _ _ _ _ hf]
      exact hm ⟨_, _, hf⟩)

Depends on / 依赖: E.mem, IsLimit, J.superset_covering, Multifork, Multifork.IsLimit.mk, hom_ext, superset_covering
-/
noncomputable def isLimit [H.IsGenerating] :
    IsLimit (Cover.multifork ⟨S, J.superset_covering le E.mem₀⟩ P) :=
  Multifork.IsLimit.mk _
    (fun F => lift hP hE le F)
    (fun F => by
      rintro ⟨Y, f, hf⟩
      apply fac)
    (fun F m hm => by
      apply hom_ext H P hP S (J.superset_covering le E.mem₀)
      intro Y f hf
      rw [fac _ _ _ _ _ hf]
      exact hm ⟨_, _, hf⟩)

