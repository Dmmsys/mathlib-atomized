lemma densityProcess_def (κ : Kernel α (γ × β)) (ν : Kernel α γ) (n : Nat) (a : α) (s : Set β) :
    (fun t => densityProcess κ ν n a t s)
      = fun t => (κ a (countablePartitionSet n t ×ˢ s) / ν a (countablePartitionSet n t)).toReal :=
  rfl

