theorem Monotone.piecewise_eventually_eq_iUnion {β : α -> Type*} [Preorder ι] {s : ι -> Set α}
    [forall i, DecidablePred (· in s i)] [DecidablePred (· in ⋃ i, s i)]
    (hs : Monotone s) (f g : (a : α) -> β a) (a : α) :
    forallᶠ i in atTop, (s i).piecewise f g a = (⋃ i, s i).piecewise f g a := by
