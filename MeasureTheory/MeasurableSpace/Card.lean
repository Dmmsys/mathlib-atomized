English:
definition generateMeasurableRec
  signature: (s : Set (Set α)) (i : Ordinal)
  body: let S := ⋃ j < i, generateMeasurableRec s j
  s union {∅} union compl '' S union Set.range fun f : Nat -> S => ⋃ n, (f n).1
termination_by i

中文:
定义 generateMeasurableRec
  签名: (s : 集合 (集合 α)) (i : 序数)
  定义体: let S := ⋃ j < i, generateMeasurableRec s j
