English:
theorem Rel.neg
  given: {R : Type uR} [Ring R] {r : R -> R -> Prop} ⦃a b
  statement: R⦄ (h : Rel r a b) :
  proof: by simp only [neg_eq_neg_one_mul a, neg_eq_neg_one_mul b, Rel.mul_right h]

