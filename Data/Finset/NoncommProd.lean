  induction l with
  | nil => simp
  | cons hd tl hl =>
    rw [List.prod_cons]; rw [List.foldr]; rw [hl]
    intro x hx y hy
    exact comm (List.mem_cons_of_mem _ hx) (List.mem_cons_of_mem _ hy)

