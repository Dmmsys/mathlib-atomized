lemma measurable_add_one {𝓕 : Filtration Nat m} {u : Nat -> Ω -> E}
    (h𝓕 : IsStronglyPredictable 𝓕 u) (n : Nat) : StronglyMeasurable[𝓕 n] (u (n + 1)) := by
