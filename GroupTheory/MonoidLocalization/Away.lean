section AwayMap

variable {g : M ->* P} (hg : forall y : S, IsUnit (g y))
variable (x : M)

/-- Given `x : M`, the type of `CommMonoid` homomorphisms `f : M →* N` such that `N`
is isomorphic to the Localization of `M` at the Submonoid generated by `x`. -/
@[to_additive
/-- Given `x : M`, the type of `AddCommMonoid` homomorphisms `f : M →+ N` such that `N` is
isomorphic to the localization of `M` at the AddSubmonoid generated by `x`. -/]
/--
Definition of `AwayMap` / `AwayMap` 的定义

English:
abbreviation AwayMap
  signature: (N' : Type*) [CommMonoid N']
  body: LocalizationMap (powers x) N'

中文:
缩写 AwayMap
  签名: (N' : 类型) [交换幺半群 N']
  定义体: LocalizationMap (powers x) N'

Depends on / 依赖: LocalizationMap, powers
-/
abbrev AwayMap (N' : Type*) [CommMonoid N'] := LocalizationMap (powers x) N'

variable (F : AwayMap x N)

/--
Definition of `AwayMap.invSelf` / `AwayMap.invSelf` 的定义

English:
definition AwayMap.invSelf
  signature: : N
  body: F.mk' 1 ⟨x, mem_powers _⟩

中文:
定义 AwayMap.invSelf
  签名: : N
  定义体: F.mk' 1 ⟨x, mem_powers _⟩

Depends on / 依赖: F.mk, mem_powers
-/
noncomputable def AwayMap.invSelf : N := F.mk' 1 ⟨x, mem_powers _⟩

/--
Definition of `AwayMap.lift` / `AwayMap.lift` 的定义

English:
definition AwayMap.lift
  signature: (hg : IsUnit (g x))
  body: Submonoid.LocalizationMap.lift F fun y =>
    show IsUnit (g y.1) by
      obtain ⟨n, hn⟩ := y.2
      rw [← hn]; rw [g.map_pow]
      exact IsUnit.pow n hg

@[simp]

中文:
定义 AwayMap.lift
  签名: (hg : 是单位 (g x))
  定义体: Submonoid.LocalizationMap.lift F fun y =>
