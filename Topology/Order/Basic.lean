English:
lemma LeftOrdContinuous.continuousWithinAt_Iic
  given: (hf : LeftOrdContinuous f)
  proof: by
  rw [ContinuousWithinAt]; rw [OrderTopology.topology_eq_generate_intervals (α := Y)]
  simp_rw [TopologicalSpace.tendsto_nhds_generateFrom_iff, mem_nhdsWithin]
  rintro V ⟨z, rfl | rfl⟩ hxz
