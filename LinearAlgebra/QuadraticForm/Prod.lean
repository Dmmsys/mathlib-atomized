  条件: (Q : 对任意 i, 二次映射 R (Mᵢ i) P)
  证明: LinearMap.ext₂ fun x y => (polar_pi _ _ _).trans by simp
-/
@[simp] theorem polarBilin_pi (Q : forall i, QuadraticMap R (Mᵢ i) P) :
    (pi Q).polarBilin = ∑ i, (Q i).polarBilin.compl₁₂ (.proj i) (.proj i) :=
LinearMap.ext₂ fun x y => (polar_pi _ _ _).trans by simp

/--
theorem `associated_pi` / 定理 `associated_pi`

English:
theorem associated_pi
  given: [Invertible (2 : R)] (Q : forall i, QuadraticMap R (Mᵢ i) P)
  proof: by
  dsimp [associated, associatedHom]
  rw [polarBilin_pi]; rw [Finset.smul_sum]
  rfl

中文:
定理 associated_pi
  条件: [可逆 (2 : R)] (Q : 对任意 i, 二次映射 R (Mᵢ i) P)
  证明: by
  dsimp [associated, associatedHom]
  rw [polarBilin_pi]; rw [Finset.smul_sum]
  rfl
-/
@[simp] theorem associated_pi [Invertible (2 : R)] (Q : forall i, QuadraticMap R (Mᵢ i) P) :
    associated (pi Q) = ∑ i, (Q i).associated.compl₁₂ (.proj i) (.proj i) := by
  dsimp [associated, associatedHom]
  rw [polarBilin_pi]; rw [Finset.smul_sum]
  rfl

end Ring

end Pi

end QuadraticMap
