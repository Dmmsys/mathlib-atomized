/--
lemma `Coinvariants.le_comap_ker` / 引理 `Coinvariants.le_comap_ker`

English:
lemma Coinvariants.le_comap_ker
  given: (g : G)
  proof: Submodule.span_le.2 fun _ ⟨⟨s, x⟩, hs⟩ => by
    simpa [← hs] using mem_ker_of_eq
⟨g * s * g⁻¹, Subgroup.Normal.conj_mem ‹_› s.1 s.2 g⟩ (ρ g x) _ by simp

中文:
引理 Coinvariants.le_comap_ker
  条件: (g : G)
  证明: Submodule.span_le.2 fun _ ⟨⟨s, x⟩, hs⟩ => by
    simpa [← hs] using mem_ker_of_eq
⟨g * s * g⁻¹, Subgroup.Normal.conj_mem ‹_› s.1 s.2 g⟩ (ρ g x) _ by simp

Depends on / 依赖: Normal, Subgroup, Subgroup.Normal.conj_mem, Submodule, Submodule.span_le, conj_mem, mem_ker_of_eq, span_le
-/
lemma Coinvariants.le_comap_ker (g : G) :
    ker (ρ.comp S.subtype) <= (ker <| ρ.comp S.subtype).comap (ρ g) :=
  Submodule.span_le.2 fun _ ⟨⟨s, x⟩, hs⟩ => by
    simpa [← hs] using mem_ker_of_eq
⟨g * s * g⁻¹, Subgroup.Normal.conj_mem ‹_› s.1 s.2 g⟩ (ρ g x) _ by simp

