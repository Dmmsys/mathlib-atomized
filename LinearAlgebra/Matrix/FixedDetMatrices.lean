@[ext]
-/
lemma ext' {m : R} {A B : FixedDetMatrix n R m} (h : A.1 = B.1) : A = B := by
  cases A; cases B
  congr

@[ext]
/--
lemma `ext` / 引理 `ext`

English:
lemma ext
  given: {m : R} {A B : FixedDetMatrix n R m} (h : forall i j, A.1 i j = B.1 i j)
  statement: A = B
  proof: by
  apply ext'
  ext i j
  apply h

中文:
引理 ext
  条件: {m : R} {A B : FixedDetMatrix n R m} (h : 对任意 i j, A.1 i j = B.1 i j)
  结论: A = B
