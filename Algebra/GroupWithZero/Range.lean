def valueMonoid : Submonoid Bˣ where
  carrier := (↑) ⁻¹' (range f)
  mul_mem' hb hb' := by
    obtain ⟨y, hy⟩ := hb
    obtain ⟨y', hy'⟩ := hb'
    use y * y'
    rw [map_mul, hy, hy', Units.val_mul]
  one_mem' := ⟨1, by simp⟩
