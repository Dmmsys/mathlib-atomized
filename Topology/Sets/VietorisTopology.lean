    (h : ∃ t ∈ s, IsPreconnected t) : IsPreconnected (⋃₀ s) := by
  obtain ⟨t, hts, ht⟩ := h
  have hts' := subset_sUnion_of_mem hts
  /- Take open sets `U` and `V` covering `⋃₀ s`, and assume that they both intersect `⋃₀ s`. We have
