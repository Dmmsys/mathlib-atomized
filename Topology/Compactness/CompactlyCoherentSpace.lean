· 使用定理 `congrArg`：∀ {α : Sort u} {β : Sort v} {a₁ a₂ : α} (f : α → β), a₁ = a₂ →
 f a₁ = f a₂
· 使用定理 `Eq.symm`：∀ {α : Sort u} {a b : α}, a = b → b = a
· 使用定理 `Set.preimage_comp`：preimage_comp {s : Set γ} : g ∘ f ⁻¹' s = f ⁻¹' g ⁻¹'
 s
· 使用定理 `Iff.mp`：∀ {a b : Prop}, (a ↔ b) → a → b
· 使用定理 `isCompact_iff_compactSpace`：isCompact_iff_compactSpace : IsCompact s ↔ C
ompactSpace s
· 使用定理 `Equiv.symm`：Equiv.symm {s t : Computation α} : s ~ t -> t ~ s
· 使用引理 `CompactCoherentification.continuous_rng_of_compactSpace`：continuous_rng_
of_compactSpace {f : X -> 𝐤Y} [CompactSpace X] : Continuous f ↔ Continuous ((Com
pactCoherentification.mk Y).symm ∘ f)
· 使用定理 `continuous_subtype_val`：continuous_subtype_val : Continuous (@Subtype.va
l X p)

--- 原说明 ---
The compact coherentification makes any space into a compactly coherent space.
-/
instance instCompactlyCoherentSpace : CompactlyCoherentSpace (𝐤X) := by
  refine .of_isOpen_forall_compactSpace fun U hU ↦ isOpen_iff.mpr fun K hK ↦ ?_
  rw [← preimage_comp]
  have : CompactSpace K := isCompact_iff_compactSpace.mp hK
  exact hU K _ (continuous_rng_of_compactSpace.mpr continuous_subtype_val)

/-- The compact coherentification preserves the topology of k-spaces. -/
/-
**CompactCoherentification.homeo** 是 Mathlib 中的一个定义，位于命名空间 `CompactCoherentifica
tion`。
形式化陈述：{X : Type u_1} → [inst : TopologicalSpace X] → [CompactlyCoherentSpace X] 
→ X ≃ₜ CompactCoherentification X
本定义的构造引用了以下数学事实（定理与引理）：
· 使用引理 `CompactCoherentification.continuous_mk`：continuous_mk [CompactlyCoherent
Space X] : Continuous (CompactCoherentification.mk X)
· 使用引理 `CompactCoherentification.continuous_mk_symm`：continuous_mk_symm : Contin
uous (CompactCoherentification.mk X).symm

--- 原说明 ---
The compact coherentification preserves the topology of k-spaces.
-/
protected def homeo [CompactlyCoherentSpace X] : X ≃ₜ 𝐤X where
  toEquiv := CompactCoherentification.mk X
  continuous_toFun := continuous_mk
  continuous_invFun := continuous_mk_symm
/-
**CompactCoherentification.t2space** 是 Mathlib 中的一个实例，位于命名空间 `CompactCoherentifi
cation`。
形式化陈述：t2space [t : T2Space X] : T2Space (𝐤X)
该定义给出了上述对象。
本声明引用了以下数学事实（定理与引理）：
· 使用定理 `T2Space.of_injective_continuous`：T2Space.of_injective_continuous [Topolo
gicalSpace Y] [T2Space Y] {f : X -> Y} (hinj : Injective f) (hc : Continuous f) 
: T2Space X
· 使用定理 `Equiv.symm`：Equiv.symm {s t : Computation α} : s ~ t -> t ~ s
· 使用定理 `Equiv.injective`：∀ {α : Sort u} {β : Sort v} (e : α ≃ β), Function.Injec
tive ⇑e
· 使用引理 `CompactCoherentification.continuous_mk_symm`：continuous_mk_symm : Contin
uous (CompactCoherentification.mk X).symm
-/
instance t2space [t : T2Space X] : T2Space (𝐤X) :=
    T2Space.of_injective_continuous (f := (CompactCoherentification.mk X).symm)
      (CompactCoherentification.mk X).symm.injective continuous_mk_symm

end CompactCoherentification

