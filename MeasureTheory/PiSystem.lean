theorem IsPiSystem.singleton
  given: (S : Set α)
  statement: IsPiSystem ({S} : Set (Set α))
  proof: by
  intro s h_s t h_t _
  rw [Set.mem_singleton_iff.1 h_s]; rw [Set.mem_singleton_iff.1 h_t]; rw [Set.inter_self]; rw [Set.mem_singleton_iff]

