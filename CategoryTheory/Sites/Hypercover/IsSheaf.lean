/--
lemma `isSheaf_iff` / 引理 `isSheaf_iff`

English:
lemma isSheaf_iff
  given: [H.IsGenerating]
  proof: by
  constructor
  · intro hP X E _
    exact ⟨E.isLimitMultifork ⟨_, hP⟩⟩
  · intro hP
    rw [Presheaf.isSheaf_iff_multifork]
    rintro X ⟨S, hS⟩
    obtain ⟨E, hE, le⟩ := H.exists_oneHypercover S hS
    exact ⟨IsSheafIff.isLimit hP hE le⟩

中文:
引理 isSheaf_iff
  条件: [H.是Generating]
  证明: by
  constructor
  · intro hP X E _
    exact ⟨E.isLimitMultifork ⟨_, hP⟩⟩
  · intro hP
    rw [Presheaf.isSheaf_iff_multifork]
    rintro X ⟨S, hS⟩
    obtain ⟨E, hE, le⟩ := H.exists_oneHypercover S hS
    exact ⟨IsSheafIff.isLimit hP hE le⟩

Depends on / 依赖: E.isLimitMultifork, H.exists_oneHypercover, IsSheafIff, IsSheafIff.isLimit, Presheaf, Presheaf.isSheaf_iff_multifork, exists_oneHypercover, isLimit, isLimitMultifork, isSheaf_iff_multifork
-/
lemma isSheaf_iff [H.IsGenerating] :
    Presheaf.IsSheaf J P ↔ forall ⦃X : C⦄ (E : J.OneHypercover X)
      (_ : H E), Nonempty (IsLimit (E.multifork P)) := by
  constructor
  · intro hP X E _
    exact ⟨E.isLimitMultifork ⟨_, hP⟩⟩
  · intro hP
    rw [Presheaf.isSheaf_iff_multifork]
    rintro X ⟨S, hS⟩
    obtain ⟨E, hE, le⟩ := H.exists_oneHypercover S hS
    exact ⟨IsSheafIff.isLimit hP hE le⟩

