  unique_lift :
    forall {X : Type v} [Group X] (f : Labelling (IsFreeGroupoid.Generators G) X),
      exists! F : G ⥤ CategoryTheory.SingleObj X, forall (a b) (g : a ⟶ b), F.map (of g) = f g

