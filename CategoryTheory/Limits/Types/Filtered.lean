definition Rel
  signature: (x y : Σ j, F.obj j)
  body: exists (k : _) (f : x.1 ⟶ k) (g : y.1 ⟶ k), F.map f x.2 = F.map g y.2

中文:
定义 Rel
  签名: (x y : Σ j, F.obj j)
  定义体: exists (k : _) (f : x.1 ⟶ k) (g : y.1 ⟶ k), F.map f x.2 = F.map g y.2
-/
protected def Rel (x y : Σ j, F.obj j) : Prop :=
  exists (k : _) (f : x.1 ⟶ k) (g : y.1 ⟶ k), F.map f x.2 = F.map g y.2

