open CategoryTheory.Prod

section

variable (C : Type u₁) [Category.{v₁} C] (D : Type u₂) [Category.{v₂} D]

/-- `prod C D` gives the Cartesian product of two categories. -/
@[stacks 001K]
/--
Instance `prod'` / 实例 `prod'`

English:
instance prod'
  signature: : Category.{max v₁ v₂} (C × D) where

中文:
实例 乘积'
  签名: : 范畴.{最大值 v₁ v₂} (C × D) where
-/
instance prod' : Category.{max v₁ v₂} (C × D) where

/--
theorem `isIso_prod_iff` / 定理 `isIso_prod_iff`

English:
theorem isIso_prod_iff
  given: {P Q : C} {S T : D} {f : (P, S) ⟶ (Q, T)}
  proof: by
  constructor
  · rintro ⟨g, hfg, hgf⟩
    rcases Prod.hom_ext_iff.1 hfg with ⟨hfg₁, hfg₂⟩
    rcases Prod.hom_ext_iff.1 hgf with ⟨hgf₁, hgf₂⟩
    exact ⟨⟨⟨g.1, hfg₁, hgf₁⟩⟩, ⟨⟨g.2, hfg₂, hgf₂⟩⟩⟩
  · rintro ⟨⟨g₁, hfg₁, hgf₁⟩, ⟨g₂, hfg₂, hgf₂⟩⟩
    dsimp at hfg₁ hgf₁ hfg₂ hgf₂
    refine ⟨⟨(g₁, g₂), by aesop_cat, by aesop_cat⟩⟩

中文:
定理 isIso_prod_iff
  条件: {P Q : C} {S T : D} {f : (P, S) ⟶ (Q, T)}
  证明: by
  constructor
  · rintro ⟨g, hfg, hgf⟩
    rcases Prod.hom_ext_iff.1 hfg with ⟨hfg₁, hfg₂⟩
    rcases Prod.hom_ext_iff.1 hgf with ⟨hgf₁, hgf₂⟩
    exact ⟨⟨⟨g.1, hfg₁, hgf₁⟩⟩, ⟨⟨g.2, hfg₂, hgf₂⟩⟩⟩
  · rintro ⟨⟨g₁, hfg₁, hgf₁⟩, ⟨g₂, hfg₂, hgf₂⟩⟩
    dsimp at hfg₁ hgf₁ hfg₂ hgf₂
    refine ⟨⟨(g₁, g₂), by aesop_cat, by aesop_cat⟩⟩

Depends on / 依赖: Prod.hom_ext_iff, aesop_cat, hom_ext_iff
-/
theorem isIso_prod_iff {P Q : C} {S T : D} {f : (P, S) ⟶ (Q, T)} :
    IsIso f ↔ IsIso f.1 ∧ IsIso f.2 := by
  constructor
  · rintro ⟨g, hfg, hgf⟩
    rcases Prod.hom_ext_iff.1 hfg with ⟨hfg₁, hfg₂⟩
    rcases Prod.hom_ext_iff.1 hgf with ⟨hgf₁, hgf₂⟩
    exact ⟨⟨⟨g.1, hfg₁, hgf₁⟩⟩, ⟨⟨g.2, hfg₂, hgf₂⟩⟩⟩
  · rintro ⟨⟨g₁, hfg₁, hgf₁⟩, ⟨g₂, hfg₂, hgf₂⟩⟩
    dsimp at hfg₁ hgf₁ hfg₂ hgf₂
    refine ⟨⟨(g₁, g₂), by aesop_cat, by aesop_cat⟩⟩

section

variable {C D}

/-- The isomorphism between `(X.1, X.2)` and `X`. -/
@[simps]
/--
Definition of `prod.etaIso` / `prod.etaIso` 的定义

English:
definition prod.etaIso
  signature: (X : C × D)
  body: 𝟙 _ ×ₘ 𝟙 _
  inv := 𝟙 _ ×ₘ 𝟙 _

中文:
定义 乘积.etaIso
  签名: (X : C × D)
  定义体: 𝟙 _ ×ₘ 𝟙 _
  inv := 𝟙 _ ×ₘ 𝟙 _

Depends on / 依赖: M.exists_isBase, exists_isBase, nonempty_subtype
-/
def prod.etaIso (X : C × D) : (X.1, X.2) ≅ X where
  hom := 𝟙 _ ×ₘ 𝟙 _
  inv := 𝟙 _ ×ₘ 𝟙 _

/-- Construct an isomorphism in `C × D` out of two isomorphisms in `C` and `D`. -/
@[simps]
/--
Definition of `Iso.prod` / `Iso.prod` 的定义

English:
definition Iso.prod
  signature: {P Q : C} {S T : D} (f : P ≅ Q) (g : S ≅ T)
  body: f.hom ×ₘ g.hom
  inv := f.inv ×ₘ g.inv

中文:
定义 同构.乘积
  签名: {P Q : C} {S T : D} (f : P ≅ Q) (g : S ≅ T)
  定义体: f.hom ×ₘ g.hom
  inv := f.inv ×ₘ g.inv

Depends on / 依赖: f.hom, g.hom
-/
def Iso.prod {P Q : C} {S T : D} (f : P ≅ Q) (g : S ≅ T) : (P, S) ≅ (Q, T) where
  hom := f.hom ×ₘ g.hom
  inv := f.inv ×ₘ g.inv

end

end

