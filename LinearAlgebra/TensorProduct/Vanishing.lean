abbrev VanishesTrivially : Prop :=
  exists (k : Nat) (a : ι -> Fin k -> R) (y : Fin k -> N),
    (forall i, n i = ∑ j, a i j • y j) ∧ forall j, ∑ i, a i j • m i = 0

