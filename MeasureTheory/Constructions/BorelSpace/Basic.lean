namespace MeasureTheory.Measure.IsFiniteMeasureOnCompacts

variable {mα} in
/--
theorem `map` / 定理 `map`

English:
theorem map
  given: (μ : Measure α) [IsFiniteMeasureOnCompacts μ] (f : α ≃ₜ β)
  proof: by
  refine ⟨fun K hK => ?_⟩
  rw [← f.toMeasurableEquiv_coe]; rw [MeasurableEquiv.map_apply]
  exact IsCompact.measure_lt_top (f.isCompact_preimage.2 hK)

中文:
定理 map
  条件: (μ : 测度 α) [紧集上有限测度 μ] (f : α ≃ₜ β)
  证明: by
  refine ⟨fun K hK => ?_⟩
  rw [← f.toMeasurableEquiv_coe]; rw [MeasurableEquiv.map_apply]
  exact IsCompact.measure_lt_top (f.isCompact_preimage.2 hK)
-/
protected theorem map (μ : Measure α) [IsFiniteMeasureOnCompacts μ] (f : α ≃ₜ β) :
    IsFiniteMeasureOnCompacts (μ.map f) := by
  refine ⟨fun K hK => ?_⟩
  rw [← f.toMeasurableEquiv_coe]; rw [MeasurableEquiv.map_apply]
  exact IsCompact.measure_lt_top (f.isCompact_preimage.2 hK)

variable {mβ} in
/--
theorem `comap` / 定理 `comap`

English:
theorem comap
  given: (μ : Measure β) [IsFiniteMeasureOnCompacts μ] (f : α ≃ₜ β)
  proof: IsFiniteMeasureOnCompacts.comap' μ f.continuous f.measurableEmbedding

中文:
定理 comap
  条件: (μ : 测度 β) [紧集上有限测度 μ] (f : α ≃ₜ β)
  证明: IsFiniteMeasureOnCompacts.comap' μ f.continuous f.measurableEmbedding
-/
protected theorem comap (μ : Measure β) [IsFiniteMeasureOnCompacts μ] (f : α ≃ₜ β) :
    IsFiniteMeasureOnCompacts (μ.comap f) :=
  IsFiniteMeasureOnCompacts.comap' μ f.continuous f.measurableEmbedding

