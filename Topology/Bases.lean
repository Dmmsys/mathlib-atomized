/-- The product of a countable family of separable spaces is a separable space. -/
instance {ι : Type*} {X : ι -> Type*} [forall i, TopologicalSpace (X i)] [forall i, SeparableSpace (X i)]
    [Countable ι] : SeparableSpace (forall i, X i) := by
  choose t htc htd using (exists_countable_dense <| X ·)
  have := fun i => (htc i).to_subtype
  nontriviality forall i, X i; inhabit forall i, X i
  classical
    set f : (Σ I : Finset ι, forall i : I, t i) -> forall i, X i := fun ⟨I, g⟩ i =>
      if hi : i in I then g ⟨i, hi⟩ else (default : forall i, X i) i
    refine ⟨⟨range f, countable_range f, dense_iff_inter_open.2 fun U hU ⟨g, hg⟩ => ?_⟩⟩
    rcases isOpen_pi_iff.1 hU g hg with ⟨I, u, huo, huU⟩
    have : forall i : I, exists y in t i, y in u i := fun i =>
      (htd i).exists_mem_open (huo i i.2).1 ⟨_, (huo i i.2).2⟩
    choose y hyt hyu using this
    lift y to forall i : I, t i using hyt
    refine ⟨f ⟨I, y⟩, huU fun i (hi : i in I) => ?_, mem_range_self (f := f) ⟨I, y⟩⟩
    simp only [f, dif_pos hi]
    exact hyu ⟨i, _⟩

