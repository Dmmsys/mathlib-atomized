theorem isTranscendenceBasis_image {ι} {s : Set ι} {f : ι -> A} (hf : Set.InjOn f s) :
    IsTranscendenceBasis R (fun x : s => f x) ↔ IsTranscendenceBasis R fun x : f '' s => (x : A) :=
