module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PushforwardContinuous
public import Mathlib.CategoryTheory.Sites.CoversTop.Basic

/-!
# Generating sections of sheaves of modules

In this file, given a sheaf of modules `M` over a sheaf of rings `R`, we introduce
the structure `M.GeneratingSections` which consists of a family of (global)
sections `s : I → M.sections` which generate `M`.

We also introduce the structure `M.LocalGeneratorsData` which contains the data
of a covering `X i` of the terminal object and the data of a
`(M.over (X i)).GeneratingSections` for all `i`. This is used in order to
define sheaves of modules of finite type.

## References

* https://stacks.math.columbia.edu/tag/01B4

-/

@[expose] public section

universe w u v' u' u₁ v₁

open CategoryTheory Limits

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

namespace SheafOfModules

variable (M N P : SheafOfModules.{u} R)

/--
Definition of `GeneratingSections` / `GeneratingSections` 的定义

English:
structure GeneratingSections
  parameters: where
  axioms and operations (3):
    - I : Type u
    - s : I -> M.sections
    - epi : Epi (M.freeHomEquiv.symm s)  [default: by infer_instance]

中文:
结构 GeneratingSections
  参数: where
  公理与运算 (3 个):
    - I : 类型u
    - s : I -> M.sections
    - epi : 满态射 (M.freeHomEquiv.symm s)  [默认: by infer_instance]

Depends on / 依赖: infer_instance
-/
structure GeneratingSections where
  /-- the index type for the sections -/
  I : Type u
  /-- a family of sections which generate the sheaf of modules -/
  s : I -> M.sections
  epi : Epi (M.freeHomEquiv.symm s) := by infer_instance

namespace GeneratingSections

attribute [instance] epi

variable {M N P}

/--
Definition of `π` / `π` 的定义

English:
abbreviation π
  signature: (σ : M.GeneratingSections)
  body: M.freeHomEquiv.symm σ.s

中文:
缩写 π
  签名: (σ : M.GeneratingSections)
  定义体: M.freeHomEquiv.symm σ.s

Depends on / 依赖: M.freeHomEquiv.symm, freeHomEquiv
-/
noncomputable abbrev π (σ : M.GeneratingSections) : free σ.I ⟶ M := M.freeHomEquiv.symm σ.s

/-- If `M ⟶ N` is an epimorphism and that `M` is generated by some sections,
then `N` is generated by the images of these sections. -/
@[simps]
/--
Definition of `ofEpi` / `ofEpi` 的定义

English:
definition ofEpi
  signature: (σ : M.GeneratingSections) (p : M ⟶ N) [Epi p]
  body: σ.I
  s i := sectionsMap p (σ.s i)
  epi := by
    rw [← freeHomEquiv_symm_comp]
    apply epi_comp

中文:
定义 ofEpi
  签名: (σ : M.GeneratingSections) (p : M ⟶ N) [满态射 p]
  定义体: σ.I
  s i := sectionsMap p (σ.s i)
  epi := by
    rw [← freeHomEquiv_symm_comp]
    apply epi_comp
-/
def ofEpi (σ : M.GeneratingSections) (p : M ⟶ N) [Epi p] :
    N.GeneratingSections where
  I := σ.I
  s i := sectionsMap p (σ.s i)
  epi := by
    rw [← freeHomEquiv_symm_comp]
    apply epi_comp

/--
lemma `opEpi_id` / 引理 `opEpi_id`

English:
lemma opEpi_id
  given: (σ : M.GeneratingSections)
  proof: rfl

中文:
引理 opEpi_id
  条件: (σ : M.GeneratingSections)
  证明: rfl
-/
lemma opEpi_id (σ : M.GeneratingSections) :
    σ.ofEpi (𝟙 M) = σ := rfl

/--
lemma `opEpi_comp` / 引理 `opEpi_comp`

English:
lemma opEpi_comp
  given: (σ : M.GeneratingSections) (p : M ⟶ N) (q : N ⟶ P) [Epi p] [Epi q]
  proof: rfl

@[simp]

中文:
引理 opEpi_comp
  条件: (σ : M.GeneratingSections) (p : M ⟶ N) (q : N ⟶ P) [满态射 p] [满态射 q]
  证明: rfl

@[simp]
-/
lemma opEpi_comp (σ : M.GeneratingSections) (p : M ⟶ N) (q : N ⟶ P) [Epi p] [Epi q] :
    σ.ofEpi (p ≫ q) = (σ.ofEpi p).ofEpi q := rfl

@[simp]
/--
lemma `ofEpi_π` / 引理 `ofEpi_π`

English:
lemma ofEpi_π
  given: (σ : M.GeneratingSections) (p : M ⟶ N) [Epi p]
  proof: by
  simp [ofEpi, freeHomEquiv_symm_comp]

中文:
引理 ofEpi_π
  条件: (σ : M.GeneratingSections) (p : M ⟶ N) [满态射 p]
  证明: by
  simp [ofEpi, freeHomEquiv_symm_comp]

Depends on / 依赖: freeHomEquiv_symm_comp
-/
lemma ofEpi_π (σ : M.GeneratingSections) (p : M ⟶ N) [Epi p] :
    (σ.ofEpi p).π = σ.π ≫ p := by
  simp [ofEpi, freeHomEquiv_symm_comp]

/--
Definition of `equivOfIso` / `equivOfIso` 的定义

English:
definition equivOfIso
  signature: (e : M ≅ N)
  body: σ.ofEpi e.hom
  invFun σ := σ.ofEpi e.inv
  left_inv σ := by
    dsimp
    simp only [← opEpi_comp, e.hom_inv_id, opEpi_id]
  right_inv σ := by
    dsimp
    simp only [← opEpi_comp, e.inv_hom_id, opEpi_id]

中文:
定义 equivOfIso
  签名: (e : M ≅ N)
  定义体: σ.ofEpi e.hom
  invFun σ := σ.ofEpi e.inv
  left_inv σ := by
    dsimp
    simp only [← opEpi_comp, e.hom_inv_id, opEpi_id]
  right_inv σ := by
    dsimp
    simp only [← opEpi_comp, e.inv_hom_id, opEpi_id]

Depends on / 依赖: e.hom
-/
def equivOfIso (e : M ≅ N) :
    M.GeneratingSections ≃ N.GeneratingSections where
  toFun σ := σ.ofEpi e.hom
  invFun σ := σ.ofEpi e.inv
  left_inv σ := by
    dsimp
    simp only [← opEpi_comp, e.hom_inv_id, opEpi_id]
  right_inv σ := by
    dsimp
    simp only [← opEpi_comp, e.inv_hom_id, opEpi_id]

/--
Definition of `IsFiniteType` / `IsFiniteType` 的定义

English:
class IsFiniteType
  parameters: (σ : M.GeneratingSections)
  axioms and operations (1):
    - finite : Finite σ.I  [default: by infer_instance]

中文:
类 是有限型
  参数: (σ : M.GeneratingSections)
  公理与运算 (1 个):
    - finite : 有限 σ.I  [默认: by infer_instance]

Depends on / 依赖: infer_instance
-/
class IsFiniteType (σ : M.GeneratingSections) : Prop where
  finite : Finite σ.I := by infer_instance

attribute [instance] IsFiniteType.finite

instance (σ : M.GeneratingSections) (p : M ⟶ N) [Epi p] [σ.IsFiniteType] :
    (σ.ofEpi p).IsFiniteType where
  finite := inferInstanceAs (Finite σ.I)

end GeneratingSections

section

variable [forall (X : C), HasWeakSheafify (J.over X) AddCommGrpCat.{u}]
  [forall (X : C), (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]

/--
Definition of `LocalGeneratorsData` / `LocalGeneratorsData` 的定义

English:
structure LocalGeneratorsData
  parameters: where
  axioms and operations (4):
    - I : Type w
    - X : I -> C
    - coversTop : J.CoversTop X
    - generators((i : I)) : (M.over (X i)).GeneratingSections

中文:
结构 LocalGeneratorsData
  参数: where
  公理与运算 (4 个):
    - I : 类型 w
    - X : I -> C
    - coversTop : J.CoversTop X
    - generators((i : I)) : (M.over (X i)).GeneratingSections
-/
structure LocalGeneratorsData where
  /-- the index type of the covering -/
  I : Type w
  /-- a family of objects which cover the terminal object -/
  X : I -> C
  coversTop : J.CoversTop X
  /-- the data of sections of `M` over `X i` which generate `M.over (X i)` -/
  generators (i : I) : (M.over (X i)).GeneratingSections

/-- Shrink the indexing type of `LocalGeneratorsData` into the universe of the site. -/
noncomputable
/--
Definition of `LocalGeneratorsData.shrink` / `LocalGeneratorsData.shrink` 的定义

English:
definition LocalGeneratorsData.shrink
  signature: {M : SheafOfModules.{u} R} (q : M.LocalGeneratorsData)
  body: Set.range q.X
  X i := q.X i.2.choose
  coversTop X := by
    refine J.superset_covering (fun Y hY H => ?_) (q.coversTop X)
    obtain ⟨i, ⟨hi⟩⟩ := (Sieve.mem_ofObjects_iff ..).mp H
    exact ⟨⟨_, i, rfl⟩, ⟨hi ≫ eqToHom (by grind)⟩⟩
  generators i := q.generators i.2.choose

中文:
定义 LocalGeneratorsData.shrink
  签名: {M : 模层.{u} R} (q : M.LocalGeneratorsData)
  定义体: Set.range q.X
  X i := q.X i.2.choose
  coversTop X := by
    refine J.superset_covering (fun Y hY H => ?_) (q.coversTop X)
    obtain ⟨i, ⟨hi⟩⟩ := (Sieve.mem_ofObjects_iff ..).mp H
    exact ⟨⟨_, i, rfl⟩, ⟨hi ≫ eqToHom (by grind)⟩⟩
  generators i := q.generators i.2.choose

Depends on / 依赖: Set.range
-/
def LocalGeneratorsData.shrink {M : SheafOfModules.{u} R} (q : M.LocalGeneratorsData) :
    LocalGeneratorsData.{u'} M where
  I := Set.range q.X
  X i := q.X i.2.choose
  coversTop X := by
    refine J.superset_covering (fun Y hY H => ?_) (q.coversTop X)
    obtain ⟨i, ⟨hi⟩⟩ := (Sieve.mem_ofObjects_iff ..).mp H
    exact ⟨⟨_, i, rfl⟩, ⟨hi ≫ eqToHom (by grind)⟩⟩
  generators i := q.generators i.2.choose

variable {M} in
/--
Definition of `LocalGeneratorsData.IsFiniteType` / `LocalGeneratorsData.IsFiniteType` 的定义

English:
class LocalGeneratorsData.IsFiniteType
  parameters: (p : M.LocalGeneratorsData)
  axioms and operations (1):
    - isFiniteType((i : p.I)) : (p.generators i).IsFiniteType  [default: by infer_instance]

中文:
类 LocalGeneratorsData.是有限型
  参数: (p : M.LocalGeneratorsData)
  公理与运算 (1 个):
    - isFiniteType((i : p.I)) : (p.generators i).是有限型  [默认: by infer_instance]

Depends on / 依赖: infer_instance
-/
class LocalGeneratorsData.IsFiniteType (p : M.LocalGeneratorsData) : Prop where
  isFiniteType (i : p.I) : (p.generators i).IsFiniteType := by infer_instance

/--
Definition of `IsFiniteType` / `IsFiniteType` 的定义

English:
class IsFiniteType
  parameters: (M : SheafOfModules.{u} R)
  axioms and operations (1):
    - exists_localGeneratorsData((M)) : exists (σ : (LocalGeneratorsData.{u'} M)), σ.IsFiniteType

中文:
类 是有限型
  参数: (M : 模层.{u} R)
  公理与运算 (1 个):
    - exists_localGeneratorsData((M)) : 存在 (σ : (LocalGeneratorsData.{u'} M)), σ.是有限型

Depends on / 依赖: M.obj, isModule
-/
class IsFiniteType (M : SheafOfModules.{u} R) : Prop where
  exists_localGeneratorsData (M) :
    exists (σ : (LocalGeneratorsData.{u'} M)), σ.IsFiniteType

end

noncomputable section

variable {C' : Type u₁} [Category.{v₁} C'] {J' : GrothendieckTopology C'} {S : Sheaf J' RingCat.{u}}
  [HasSheafify J' AddCommGrpCat] [J'.WEqualsLocallyBijective AddCommGrpCat]

variable {M : SheafOfModules.{u} R} (G : M.GeneratingSections)
  (F : SheafOfModules.{u} R ⥤ SheafOfModules.{u} S) [PreservesColimitsOfSize.{u, u} F]
  (η : unit S ≅ F.obj (unit R))

-- `preservesColimitsOfSize_shrink` is not a global instance because it loops indefinitely.
-- But here it is fine as an instance since the universe `u` is inferrable from the type of `F`.
local instance : PreservesColimitsOfSize.{0, 0} F := preservesColimitsOfSize_shrink _

/--
Definition of `GeneratingSections.mapFreeHom` / `GeneratingSections.mapFreeHom` 的定义

English:
definition GeneratingSections.mapFreeHom
  signature: : free G.I ⟶ F.obj M
  body: (mapFreeIso F G.I η).hom ≫ F.map G.π

中文:
定义 GeneratingSections.mapFreeHom
  签名: : free G.I ⟶ F.obj M
  定义体: (mapFreeIso F G.I η).hom ≫ F.map G.π

Depends on / 依赖: F.map, mapFreeIso
-/
def GeneratingSections.mapFreeHom : free G.I ⟶ F.obj M :=
  (mapFreeIso F G.I η).hom ≫ F.map G.π

/-- Let `F` be a functor from sheaf of `R`-module to sheaf of `S`-module, if `F` preserves
colimits and `F.obj (unit R) ≅ unit S`, given generating sections `G : M.GeneratingSections`,
then we obtain generating sections of `F.obj M`. -/
@[simps]
/--
Definition of `GeneratingSections.map` / `GeneratingSections.map` 的定义

English:
definition GeneratingSections.map
  signature: : (F.obj M).GeneratingSections where
  body: G.I
  s := freeHomEquiv (F.obj M) (G.mapFreeHom F η)
  epi := by
    simp only [mapFreeHom, Equiv.symm_apply_apply, epi_comp_iff_of_epi]
    infer_instance

中文:
定义 GeneratingSections.map
  签名: : (F.obj M).GeneratingSections where
  定义体: G.I
  s := freeHomEquiv (F.obj M) (G.mapFreeHom F η)
  epi := by
    simp only [mapFreeHom, Equiv.symm_apply_apply, epi_comp_iff_of_epi]
    infer_instance
-/
def GeneratingSections.map : (F.obj M).GeneratingSections where
  I := G.I
  s := freeHomEquiv (F.obj M) (G.mapFreeHom F η)
  epi := by
    simp only [mapFreeHom, Equiv.symm_apply_apply, epi_comp_iff_of_epi]
    infer_instance

/--
Instance `_anonymous_` / 实例 `_anonymous_`

English:
instance [G.IsFiniteType]
  signature: : (G.map F η).IsFiniteType where
  body: inferInstanceAs (Finite G.I)

中文:
实例 [G.是有限型]
  签名: : (G.map F η).是有限型 where
  定义体: inferInstanceAs (Finite G.I)

Depends on / 依赖: Finite
-/
instance [G.IsFiniteType] : (G.map F η).IsFiniteType where
  finite := inferInstanceAs (Finite G.I)

/--
lemma `GeneratingSections.map_π_eq` / 引理 `GeneratingSections.map_π_eq`

English:
lemma GeneratingSections.map_π_eq
  statement: (G.map F η).π = (mapFreeIso F G.I η).hom ≫ F.map G.π
  proof: (F.obj M).freeHomEquiv.symm_apply_eq.mpr rfl

中文:
引理 GeneratingSections.map_π_eq
  结论: (G.map F η).π = (mapFreeIso F G.I η).hom ≫ F.map G.π
  证明: (F.obj M).freeHomEquiv.symm_apply_eq.mpr rfl

Depends on / 依赖: F.obj, freeHomEquiv, freeHomEquiv.symm_apply_eq.mpr, symm_apply_eq
-/
lemma GeneratingSections.map_π_eq : (G.map F η).π = (mapFreeIso F G.I η).hom ≫ F.map G.π :=
  (F.obj M).freeHomEquiv.symm_apply_eq.mpr rfl

set_option backward.isDefEq.respectTransparency false in
/--
Instance `_anonymous_` / 实例 `_anonymous_`

English:
instance [IsIso
  signature: G.π] : IsIso (G.map F η).π
  body: by
  rw [GeneratingSections.map_π_eq]
  infer_instance

中文:
实例 [是同构
  签名: G.π] : 是同构 (G.map F η).π
  定义体: by
  rw [GeneratingSections.map_π_eq]
  infer_instance

Depends on / 依赖: GeneratingSections, GeneratingSections.map_, infer_instance
-/
instance [IsIso G.π] : IsIso (G.map F η).π := by
  rw [GeneratingSections.map_π_eq]
  infer_instance

variable [forall X, HasSheafify (J.over X) AddCommGrpCat.{u}] [HasBinaryProducts C]
  [forall X, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- Given `G : M.GeneratingSections`, we naturally obtain `M.LocalGeneratorsData` using the
trivial cover of `C`. -/
@[simps]
/--
Definition of `GeneratingSections.localGeneratorsData` / `GeneratingSections.localGeneratorsData` 的定义

English:
definition GeneratingSections.localGeneratorsData
  signature: {M : SheafOfModules.{u} R} (G : M.GeneratingSections)
  body: C
  X := id
coversTop _ := GrothendieckTopology.covering_of_eq_top J by simp
  generators x := G.map (pushforward (𝟙 (R.over x))) (Iso.refl _)

中文:
定义 GeneratingSections.localGeneratorsData
  签名: {M : 模层.{u} R} (G : M.GeneratingSections)
  定义体: C
  X := id
coversTop _ := GrothendieckTopology.covering_of_eq_top J by simp
  generators x := G.map (pushforward (𝟙 (R.over x))) (Iso.refl _)
-/
def GeneratingSections.localGeneratorsData {M : SheafOfModules.{u} R} (G : M.GeneratingSections) :
    M.LocalGeneratorsData where
  I := C
  X := id
coversTop _ := GrothendieckTopology.covering_of_eq_top J by simp
  generators x := G.map (pushforward (𝟙 (R.over x))) (Iso.refl _)

end

end SheafOfModules
