lemma groupCohomologyπEven_eq_iff (i : Nat) [NeZero i] (hi : Even i)
    (x y : LinearMap.ker (applyAsHom A g - 𝟙 A).hom.toLinearMap) :
    groupCohomologyπEven A g hg i hi x = groupCohomologyπEven A g hg i hi y ↔
      x.1 - y.1 in LinearMap.range A.norm.hom.toLinearMap := by
  rw [← sub_eq_zero]; rw [← map_sub]; rw [groupCohomologyπEven_eq_zero_iff]; rfl

