module

public import Mathlib.CategoryTheory.Subfunctor.OfSection

/-!
# Subpresheaves that are generated by finitely many sections

Given `F : Cᵒᵖ ⥤ Type w`, `G : Subfunctor F`, objects `X : ι → Cᵒᵖ` and sections
`x : (i : ι) → F.obj (X i)`, we define a predicate `G.IsGeneratedBy x` saying
that `G` is the subpresheaf generated by the sections `x i`. If this holds for
a finite index type `ι`, we say that `G` is "finite", and this gives a type
class `G.IsFinite`.

-/

@[expose] public section

universe w'' w' w v u

namespace CategoryTheory

open Opposite

variable {C : Type u} [Category.{v} C] {F : Cᵒᵖ ⥤ Type w}

namespace Subfunctor

variable (G : Subfunctor F)

section

variable {ι : Type w'} {X : ι -> Cᵒᵖ} (x : (i : ι) -> F.obj (X i))

/--
Definition of `IsGeneratedBy` / `IsGeneratedBy` 的定义

English:
definition IsGeneratedBy
  signature: : Prop
  body: ⨆ (i : ι), ofSection (x i) = G

中文:
定义 IsGeneratedBy
  签名: : 命题
  定义体: ⨆ (i : ι), ofSection (x i) = G

Depends on / 依赖: ofSection
-/
def IsGeneratedBy : Prop := ⨆ (i : ι), ofSection (x i) = G

/--
lemma `isGeneratedBy_iff` / 引理 `isGeneratedBy_iff`

English:
lemma isGeneratedBy_iff
  statement: G.IsGeneratedBy x ↔ ⨆ (i : ι), ofSection (x i) = G
  proof: Iff.rfl

中文:
引理 isGeneratedBy_iff
  结论: G.IsGeneratedBy x ↔ ⨆ (i : ι), ofSection (x i) = G
  证明: Iff.rfl

Depends on / 依赖: Iff.rfl
-/
lemma isGeneratedBy_iff : G.IsGeneratedBy x ↔ ⨆ (i : ι), ofSection (x i) = G := Iff.rfl

namespace IsGeneratedBy

variable {G x} (h : G.IsGeneratedBy x)
include h

/--
lemma `iSup_eq` / 引理 `iSup_eq`

English:
lemma iSup_eq
  statement: ⨆ (i : ι), ofSection (x i) = G
  proof: h

中文:
引理 iSup_eq
  结论: ⨆ (i : ι), ofSection (x i) = G
  证明: h
-/
lemma iSup_eq : ⨆ (i : ι), ofSection (x i) = G := h

/--
lemma `ofSection_le` / 引理 `ofSection_le`

English:
lemma ofSection_le
  given: (i : ι)
  statement: ofSection (x i) <= G
  proof: by
  rw [← h.iSup_eq]
  exact le_iSup (fun i => ofSection (x i)) i

中文:
引理 ofSection_le
  条件: (i : ι)
  结论: ofSection (x i) <= G
  证明: by
  rw [← h.iSup_eq]
  exact le_iSup (fun i => ofSection (x i)) i

Depends on / 依赖: h.iSup_eq, iSup_eq, le_iSup, ofSection
-/
lemma ofSection_le (i : ι) : ofSection (x i) <= G := by
  rw [← h.iSup_eq]
  exact le_iSup (fun i => ofSection (x i)) i

/--
lemma `mem` / 引理 `mem`

English:
lemma mem
  given: (i : ι)
  statement: x i in G.obj (X i)
  proof: by
  rw [← ofSection_le_iff]
  exact h.ofSection_le i

中文:
引理 mem
  条件: (i : ι)
  结论: x i in G.obj (X i)
  证明: by
  rw [← ofSection_le_iff]
  exact h.ofSection_le i

Depends on / 依赖: h.ofSection_le, ofSection_le, ofSection_le_iff
-/
lemma mem (i : ι) : x i in G.obj (X i) := by
  rw [← ofSection_le_iff]
  exact h.ofSection_le i

/--
lemma `of_equiv` / 引理 `of_equiv`

English:
lemma of_equiv
  given: {ι' : Type w''} (e : ι' ≃ ι)
  proof: by
  rw [isGeneratedBy_iff]; rw [← h.iSup_eq]
  exact Equiv.iSup_congr e (congrFun rfl)

中文:
引理 of_equiv
  条件: {ι' : Type w''} (e : ι' ≃ ι)
  证明: by
  rw [isGeneratedBy_iff]; rw [← h.iSup_eq]
  exact Equiv.iSup_congr e (congrFun rfl)

Depends on / 依赖: Equiv.iSup_congr, h.iSup_eq, iSup_congr, iSup_eq, isGeneratedBy_iff
-/
lemma of_equiv {ι' : Type w''} (e : ι' ≃ ι) :
    G.IsGeneratedBy (fun i' => x (e i')) := by
  rw [isGeneratedBy_iff]; rw [← h.iSup_eq]
  exact Equiv.iSup_congr e (congrFun rfl)

/--
lemma `image` / 引理 `image`

English:
lemma image
  given: {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')
  proof: by
  simp only [isGeneratedBy_iff, ← h.iSup_eq, image_iSup, ofSection_image]

中文:
引理 image
  条件: {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')
  证明: by
  simp only [isGeneratedBy_iff, ← h.iSup_eq, image_iSup, ofSection_image]

Depends on / 依赖: h.iSup_eq, iSup_eq, image_iSup, isGeneratedBy_iff, ofSection_image
-/
lemma image {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F') :
    (G.image f).IsGeneratedBy (fun i => f.app _ (x i)) := by
  simp only [isGeneratedBy_iff, ← h.iSup_eq, image_iSup, ofSection_image]

end IsGeneratedBy

end

/--
Definition of `IsFinite` / `IsFinite` 的定义

English:
class IsFinite
  parameters: : Prop where
  axioms and operations (1):
    - exists_isGeneratedBy : exists (ι : Type) (_ : Finite ι) (X : ι -> Cᵒᵖ) (x : (i : ι) -> F.obj (X i)), Nonempty (G.IsGeneratedBy x)

中文:
类 IsFinite
  参数: : 命题 where
  公理与运算 (1 个):
    - exists_isGeneratedBy : 存在 (ι : Type) (_ : Finite ι) (X : ι -> Cᵒᵖ) (x : (i : ι) -> F.obj (X i)), Nonempty (G.IsGeneratedBy x)
-/
class IsFinite : Prop where
  exists_isGeneratedBy :
    exists (ι : Type) (_ : Finite ι) (X : ι -> Cᵒᵖ) (x : (i : ι) -> F.obj (X i)),
      Nonempty (G.IsGeneratedBy x)

namespace IsFinite

variable [hG : G.IsFinite]

/--
Definition of `Index` / `Index` 的定义

English:
definition Index
  signature: : Type
  body: hG.exists_isGeneratedBy.choose

中文:
定义 Index
  签名: : Type
  定义体: hG.exists_isGeneratedBy.choose

Depends on / 依赖: exists_isGeneratedBy, hG.exists_isGeneratedBy.choose
-/
def Index : Type := hG.exists_isGeneratedBy.choose

/--
Instance `_anonymous_` / 实例 `_anonymous_`

English:
instance :
  signature: Finite (Index G)
  body: hG.exists_isGeneratedBy.choose_spec.choose

中文:
实例 :
  签名: Finite (Index G)
  定义体: hG.exists_isGeneratedBy.choose_spec.choose

Depends on / 依赖: choose_spec, exists_isGeneratedBy, hG.exists_isGeneratedBy.choose_spec.choose
-/
instance : Finite (Index G) := hG.exists_isGeneratedBy.choose_spec.choose

variable {G}

/--
Definition of `X` / `X` 的定义

English:
definition X
  signature: : Index G -> Cᵒᵖ
  body: hG.exists_isGeneratedBy.choose_spec.choose_spec.choose

中文:
定义 X
  签名: : Index G -> Cᵒᵖ
  定义体: hG.exists_isGeneratedBy.choose_spec.choose_spec.choose

Depends on / 依赖: choose_spec, exists_isGeneratedBy, hG.exists_isGeneratedBy.choose_spec.choose_spec.choose
-/
noncomputable def X : Index G -> Cᵒᵖ :=
  hG.exists_isGeneratedBy.choose_spec.choose_spec.choose

/--
Definition of `x` / `x` 的定义

English:
definition x
  signature: : (i : Index G) -> F.obj (X i)
  body: hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose

中文:
定义 x
  签名: : (i : Index G) -> F.obj (X i)
  定义体: hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose

Depends on / 依赖: choose_spec, exists_isGeneratedBy, hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose
-/
noncomputable def x : (i : Index G) -> F.obj (X i) :=
  hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose

end IsFinite

/--
lemma `isGeneratedBy_of_isFinite` / 引理 `isGeneratedBy_of_isFinite`

English:
lemma isGeneratedBy_of_isFinite
  given: [hG : G.IsFinite]
  proof: hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose_spec.some

中文:
引理 isGeneratedBy_of_isFinite
  条件: [hG : G.IsFinite]
  证明: hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose_spec.some
-/
lemma isGeneratedBy_of_isFinite [hG : G.IsFinite] :
    G.IsGeneratedBy (IsFinite.x (G := G)) :=
  hG.exists_isGeneratedBy.choose_spec.choose_spec.choose_spec.choose_spec.some

/--
lemma `IsGeneratedBy.isFinite` / 引理 `IsGeneratedBy.isFinite`

English:
lemma IsGeneratedBy.isFinite
  proof: by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  exact ⟨Fin n, inferInstance, _, _, ⟨h.of_equiv e.symm⟩⟩

中文:
引理 IsGeneratedBy.isFinite
  证明: by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  exact ⟨Fin n, inferInstance, _, _, ⟨h.of_equiv e.symm⟩⟩

Depends on / 依赖: Finite, Finite.exists_equiv_fin, e.symm, exists_equiv_fin, h.of_equiv, of_equiv
-/
lemma IsGeneratedBy.isFinite
    {ι : Type w'} [Finite ι] {X : ι -> Cᵒᵖ} {x : (i : ι) -> F.obj (X i)}
    (h : G.IsGeneratedBy x) : G.IsFinite := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin ι
  exact ⟨Fin n, inferInstance, _, _, ⟨h.of_equiv e.symm⟩⟩

/--
lemma `image_isFinite` / 引理 `image_isFinite`

English:
lemma image_isFinite
  given: [G.IsFinite] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')
  proof: ((isGeneratedBy_of_isFinite G).image f).isFinite

中文:
引理 image_isFinite
  条件: [G.IsFinite] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')
  证明: ((isGeneratedBy_of_isFinite G).image f).isFinite

Depends on / 依赖: isFinite, isGeneratedBy_of_isFinite
-/
lemma image_isFinite [G.IsFinite] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F') :
    (G.image f).IsFinite :=
  ((isGeneratedBy_of_isFinite G).image f).isFinite

end Subfunctor

variable (F)

section

variable {ι : Type w'} {X : ι -> Cᵒᵖ} (x : (i : ι) -> F.obj (X i))

/--
Definition of `PresheafIsGeneratedBy` / `PresheafIsGeneratedBy` 的定义

English:
abbreviation PresheafIsGeneratedBy
  signature: : Prop
  body: (⊤ : Subfunctor F).IsGeneratedBy x

中文:
缩写 PresheafIsGeneratedBy
  签名: : 命题
  定义体: (⊤ : Subfunctor F).IsGeneratedBy x

Depends on / 依赖: IsGeneratedBy, Subfunctor
-/
abbrev PresheafIsGeneratedBy : Prop := (⊤ : Subfunctor F).IsGeneratedBy x

namespace PresheafIsGeneratedBy

variable {F x} (h : PresheafIsGeneratedBy F x) {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')

include h

/--
lemma `range` / 引理 `range`

English:
lemma range
  statement: (Subfunctor.range f).IsGeneratedBy (fun i => f.app _ (x i))
  proof: by
  simpa only [← Subfunctor.image_top] using h.image f

中文:
引理 range
  结论: (Subfunctor.range f).IsGeneratedBy (fun i => f.app _ (x i))
  证明: by
  simpa only [← Subfunctor.image_top] using h.image f

Depends on / 依赖: Subfunctor, Subfunctor.image_top, h.image, image_top
-/
lemma range : (Subfunctor.range f).IsGeneratedBy (fun i => f.app _ (x i)) := by
  simpa only [← Subfunctor.image_top] using h.image f

/--
lemma `of_epi` / 引理 `of_epi`

English:
lemma of_epi
  given: [Epi f]
  statement: PresheafIsGeneratedBy F' (fun i => f.app _ (x i))
  proof: by
  simpa only [Subfunctor.range_eq_top f] using h.range f

中文:
引理 of_epi
  条件: [Epi f]
  结论: PresheafIsGeneratedBy F' (fun i => f.app _ (x i))
  证明: by
  simpa only [Subfunctor.range_eq_top f] using h.range f

Depends on / 依赖: Subfunctor, Subfunctor.range_eq_top, h.range, range_eq_top
-/
lemma of_epi [Epi f] : PresheafIsGeneratedBy F' (fun i => f.app _ (x i)) := by
  simpa only [Subfunctor.range_eq_top f] using h.range f

end PresheafIsGeneratedBy

end

/--
Definition of `PresheafIsFinite` / `PresheafIsFinite` 的定义

English:
abbreviation PresheafIsFinite
  signature: : Prop
  body: (⊤ : Subfunctor F).IsFinite

中文:
缩写 PresheafIsFinite
  签名: : 命题
  定义体: (⊤ : Subfunctor F).IsFinite

Depends on / 依赖: IsFinite, Subfunctor
-/
abbrev PresheafIsFinite : Prop := (⊤ : Subfunctor F).IsFinite

/--
lemma `presheafIsGeneratedBy_of_isFinite` / 引理 `presheafIsGeneratedBy_of_isFinite`

English:
lemma presheafIsGeneratedBy_of_isFinite
  given: [PresheafIsFinite F]
  proof: (Subfunctor.isGeneratedBy_of_isFinite (⊤ : Subfunctor F))

中文:
引理 presheafIsGeneratedBy_of_isFinite
  条件: [PresheafIsFinite F]
  证明: (Subfunctor.isGeneratedBy_of_isFinite (⊤ : Subfunctor F))
-/
lemma presheafIsGeneratedBy_of_isFinite [PresheafIsFinite F] :
    PresheafIsGeneratedBy F (Subfunctor.IsFinite.x (G := ⊤)) :=
  (Subfunctor.isGeneratedBy_of_isFinite (⊤ : Subfunctor F))

/--
lemma `Subfunctor.range_isFinite` / 引理 `Subfunctor.range_isFinite`

English:
lemma Subfunctor.range_isFinite
  given: [PresheafIsFinite F] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')
  proof: ((presheafIsGeneratedBy_of_isFinite F).range f).isFinite

中文:
引理 Subfunctor.range_isFinite
  条件: [PresheafIsFinite F] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F')
  证明: ((presheafIsGeneratedBy_of_isFinite F).range f).isFinite

Depends on / 依赖: isFinite, presheafIsGeneratedBy_of_isFinite
-/
lemma Subfunctor.range_isFinite [PresheafIsFinite F] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F') :
    (Subfunctor.range f).IsFinite :=
  ((presheafIsGeneratedBy_of_isFinite F).range f).isFinite

/--
lemma `presheafIsFinite_of_epi` / 引理 `presheafIsFinite_of_epi`

English:
lemma presheafIsFinite_of_epi
  given: [PresheafIsFinite F] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F') [Epi f]
  proof: ((presheafIsGeneratedBy_of_isFinite F).of_epi f).isFinite

中文:
引理 presheafIsFinite_of_epi
  条件: [PresheafIsFinite F] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F') [Epi f]
  证明: ((presheafIsGeneratedBy_of_isFinite F).of_epi f).isFinite

Depends on / 依赖: isFinite, of_epi, presheafIsGeneratedBy_of_isFinite
-/
lemma presheafIsFinite_of_epi [PresheafIsFinite F] {F' : Cᵒᵖ ⥤ Type w} (f : F ⟶ F') [Epi f] :
    PresheafIsFinite F' :=
  ((presheafIsGeneratedBy_of_isFinite F).of_epi f).isFinite

/--
lemma `yoneda_obj_isGeneratedBy` / 引理 `yoneda_obj_isGeneratedBy`

English:
lemma yoneda_obj_isGeneratedBy
  given: (X : C)
  proof: by
  simp only [Subfunctor.isGeneratedBy_iff]
  ext U u
  simp only [Subfunctor.iSup_obj, Set.mem_iUnion,
    exists_const, Subfunctor.top_obj, Set.top_eq_univ, Set.mem_univ, iff_true]
  exact ⟨u.op, by simp⟩

中文:
引理 yoneda_obj_isGeneratedBy
  条件: (X : C)
  证明: by
  simp only [Subfunctor.isGeneratedBy_iff]
  ext U u
  simp only [Subfunctor.iSup_obj, Set.mem_iUnion,
    exists_const, Subfunctor.top_obj, Set.top_eq_univ, Set.mem_univ, iff_true]
  exact ⟨u.op, by simp⟩

Depends on / 依赖: Set.mem_iUnion, Set.mem_univ, Set.top_eq_univ, Subfunctor, Subfunctor.iSup_obj, Subfunctor.isGeneratedBy_iff, Subfunctor.top_obj, exists_const, iSup_obj, iff_true, isGeneratedBy_iff, mem_iUnion, mem_univ, top_eq_univ, top_obj, u.op
-/
lemma yoneda_obj_isGeneratedBy (X : C) :
    PresheafIsGeneratedBy (yoneda.obj X) (fun (_ : Unit) => 𝟙 X) := by
  simp only [Subfunctor.isGeneratedBy_iff]
  ext U u
  simp only [Subfunctor.iSup_obj, Set.mem_iUnion,
    exists_const, Subfunctor.top_obj, Set.top_eq_univ, Set.mem_univ, iff_true]
  exact ⟨u.op, by simp⟩

instance (X : C) : PresheafIsFinite (yoneda.obj X) :=
  (yoneda_obj_isGeneratedBy X).isFinite

end CategoryTheory
