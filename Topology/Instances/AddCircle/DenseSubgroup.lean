theorem dense_addSubgroup_iff_ne_zmultiples {p : Real} [Fact (0 < p)] {s : AddSubgroup (AddCircle p)} :
    Dense (s : Set (AddCircle p)) ↔ forall a, addOrderOf a != 0 -> s != .zmultiples a := by
  constructor
  · rintro hd a ha rfl
    rw [AddSubgroup.coe_zmultiples]; rw [← DenseRange]; rw [denseRange_zsmul_iff] at hd
    exact ha hd
  · intro h
    contrapose! h
    obtain ⟨a, rfl⟩ : exists a, s = .zmultiples a := by
      rw [← QuotientAddGroup.dense_preimage_mk]; rw [← QuotientAddGroup.coe_mk']; rw [← AddSubgroup.coe_comap]; rw [xor_iff_not_iff'.1 (AddSubgroup.dense_xor_cyclic _)] at h
