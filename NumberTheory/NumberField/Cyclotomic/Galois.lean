  obtain ⟨i, hi⟩ := FiniteField.exists_forall_apply_eq_pow (Int ⧸ span {(p : Int)}) p (𝓞 K ⧸ P) τ
  refine ⟨i, ?_⟩
  have h₀ : IsPrimitiveRoot (Ideal.Quotient.mk P hζ.toInteger) n := by
