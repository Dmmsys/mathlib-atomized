English:
theorem VanishesTrivially.of_fintype
  statement: {κ} [Fintype κ] (a : ι -> κ -> R) (y : κ -> N)
  proof: have e := (Fintype.equivFin κ).symm
  ⟨Fintype.card κ, (a · ∘ e), y ∘ e, by simpa only [← e.sum_comp] using! hay, by
