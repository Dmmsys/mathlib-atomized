English:
definition esymmAlgEquiv
  signature: (hn : Fintype.card σ = n)
  body: AlgEquiv.ofBijective (esymmAlgHom σ R n)
    ⟨esymmAlgHom_injective R hn.ge, esymmAlgHom_surjective R hn.le⟩

