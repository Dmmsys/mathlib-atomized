-/
def invAccumulate (n m : Nat) (s : Fin m -> Nat) (i : Fin n) : Nat :=
  (if hi : i < m then s ⟨i, hi⟩ else 0) - (if hi : i + 1 < m then s ⟨i + 1, hi⟩ else 0)

