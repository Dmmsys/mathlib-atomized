中文:
定义 compileInductiveOnly
  签名: (iv : InductiveVal) (rv : RecursorVal) (warn := true)
  定义体: do
  if ← isProp rv.type then
    if warn then logWarning m!"not compiling {rv.name}"
    return
  if !iv.isRec && rv.numMotives == 1 && iv.numCtors == 1 && iv.numIndices == 0 then
