def FactorsThru {X : C} (S T : Presieve X) : Prop :=
  forall ⦃Z : C⦄ ⦃g : Z ⟶ X⦄, S g ->
  exists (W : C) (i : Z ⟶ W) (e : W ⟶ X), T e ∧ i ≫ e = g

