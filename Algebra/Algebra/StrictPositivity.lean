English:
lemma _root_.IsUnit.isStrictlyPositive_star_left_conjugate_iff
  given: {u a : A} (hu : IsUnit u)
  proof: by
  simpa using hu.star.isStrictlyPositive_star_right_conjugate_iff

@[grind =]

中文:
