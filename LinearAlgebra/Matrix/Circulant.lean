/-!
# Circulant matrices

This file contains the definition and basic results about circulant matrices.
Given a vector `v : n → α` indexed by a type that is endowed with subtraction,
`Matrix.circulant v` is the matrix whose `(i, j)`th entry is `v (i - j)`.

## Main results

- `Matrix.circulant`: the circulant matrix generated by a given vector `v : n → α`.
- `Matrix.circulant_mul`: the product of two circulant matrices `circulant v` and `circulant w` is
                          the circulant matrix generated by `circulant v *ᵥ w`.
- `Matrix.circulant_mul_comm`: multiplication of circulant matrices commutes when the elements do.

## Implementation notes

`Matrix.Fin.foo` is the `Fin n` version of `Matrix.foo`.
Namely, the index type of the circulant matrices in discussion is `Fin n`.

## Tags

circulant, matrix
-/

@[expose] public section


variable {α β n R : Type*}

namespace Matrix

open Function

open Matrix

/--
Definition of `circulant` / `circulant` 的定义

English:
definition circulant
  signature: [Sub n] (v : n -> α)
  body: of fun i j => v (i - j)

中文:
定义 circulant
  签名: [减法 n] (v : n -> α)
  定义体: of fun i j => v (i - j)
-/
def circulant [Sub n] (v : n -> α) : Matrix n n α :=
  of fun i j => v (i - j)

-- TODO: set as an equation lemma for `circulant`, see https://github.com/leanprover-community/mathlib4/pull/3024
@[simp]
/--
theorem `circulant_apply` / 定理 `circulant_apply`

English:
theorem circulant_apply
  given: [Sub n] (v : n -> α) (i j)
  statement: circulant v i j = v (i - j)
  proof: rfl

中文:
定理 circulant_apply
  条件: [减法 n] (v : n -> α) (i j)
  结论: circulant v i j = v (i - j)
  证明: rfl
-/
theorem circulant_apply [Sub n] (v : n -> α) (i j) : circulant v i j = v (i - j) := rfl

/--
theorem `circulant_col_zero_eq` / 定理 `circulant_col_zero_eq`

English:
theorem circulant_col_zero_eq
  given: [SubtractionMonoid n] (v : n -> α) (i : n)
  statement: circulant v i 0 = v i
  proof: congr_arg v (sub_zero _)

中文:
定理 circulant_col_zero_eq
  条件: [Subtraction幺半群 n] (v : n -> α) (i : n)
  结论: circulant v i 0 = v i
  证明: congr_arg v (sub_zero _)

Depends on / 依赖: congr_arg, sub_zero
-/
theorem circulant_col_zero_eq [SubtractionMonoid n] (v : n -> α) (i : n) : circulant v i 0 = v i :=
  congr_arg v (sub_zero _)

/--
theorem `circulant_injective` / 定理 `circulant_injective`

English:
theorem circulant_injective
  given: [SubtractionMonoid n]
  proof: by
  intro v w h
  ext k
  rw [← circulant_col_zero_eq v]; rw [← circulant_col_zero_eq w]; rw [h]

中文:
定理 circulant_injective
  条件: [Subtraction幺半群 n]
  证明: by
  intro v w h
  ext k
  rw [← circulant_col_zero_eq v]; rw [← circulant_col_zero_eq w]; rw [h]

Depends on / 依赖: circulant_col_zero_eq
-/
theorem circulant_injective [SubtractionMonoid n] :
    Injective (circulant : (n -> α) -> Matrix n n α) := by
  intro v w h
  ext k
  rw [← circulant_col_zero_eq v]; rw [← circulant_col_zero_eq w]; rw [h]

